"""Render report/figures/fig_main.pdf and fig_main_caption.tex from per-fold results."""
import numpy as np
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt

from figtab_common import OUT_FIG, check_against_summary, load_runs, results_dir, summarize, tex_num

plt.rcParams.update({
    "font.size": 8, "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 7.5,
    "axes.linewidth": 0.6, "pdf.fonttype": 42, "ps.fonttype": 42,
    "font.family": "serif", "mathtext.fontset": "cm",
})
C_LR, C_KNN, C_DIFF = "#0072B2", "#D55E00", "#222222"


def strip(ax, x0, y, color, marker, rng):
    ax.scatter(x0 + rng.uniform(-0.2, 0.2, len(y)), y, s=9, color=color, marker=marker,
               alpha=0.35, linewidths=0, zorder=2)


def mean_ci(ax, x0, st, color, marker):
    ax.errorbar([x0], [st["mean"]], yerr=[[st["mean"] - st["ci_low"]], [st["ci_high"] - st["mean"]]],
                fmt=marker, color=color, ms=5, mec="white", mew=0.6, capsize=3, elinewidth=1.3,
                capthick=1.3, zorder=4)


def main():
    res = results_dir()
    local, ibex, repro, identical, max_abs = load_runs(res)
    s = summarize(local)
    check_against_summary(s, res)
    diff = local["acc_lr"] - local["acc_knn"]
    rng = np.random.default_rng(0)

    fig, (a, b) = plt.subplots(1, 2, figsize=(5.5, 2.1), gridspec_kw={"width_ratios": [1.5, 1], "wspace": 0.38})
    strip(a, 0, local["acc_lr"], C_LR, "o", rng)
    strip(a, 1, local["acc_knn"], C_KNN, "s", rng)
    mean_ci(a, 0, s["lr"], C_LR, "o")
    mean_ci(a, 1, s["knn"], C_KNN, "s")
    a.set_xticks([0, 1], ["Logistic regr.", "$k$-NN"])
    a.set_xlim(-0.6, 1.6)
    a.set_ylabel("Test accuracy (fraction)")
    lo = min(local["acc_lr"].min(), local["acc_knn"].min(), s["lr"]["ci_low"], s["knn"]["ci_low"])
    a.set_ylim(lo - 0.02, 1.02)
    a.axhline(1.0, color="0.7", lw=0.5, ls=":", zorder=1)
    a.set_title("(a) Accuracy per method", fontsize=8, loc="left")

    strip(b, 0, diff, C_DIFF, "D", rng)
    mean_ci(b, 0, s["diff"], C_DIFF, "D")
    b.axhline(0, color="0.35", lw=0.8, zorder=1)
    b.set_xticks([0], ["LR $-$ $k$-NN"])
    b.set_xlim(-0.6, 0.6)
    ext = max(abs(diff).max(), abs(s["diff"]["ci_low"]), abs(s["diff"]["ci_high"])) + 0.02
    b.set_ylim(-ext, ext)
    b.set_ylabel("Paired difference in accuracy")
    b.set_title("(b) Paired difference", fontsize=8, loc="left")

    for ax in (a, b):
        ax.spines[["top", "right"]].set_visible(False)
        ax.tick_params(width=0.6, length=2.5)
    OUT_FIG.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT_FIG / "fig_main.pdf", bbox_inches="tight", pad_inches=0.03)

    n, nrep = s["n_folds"], s["n_rep"]
    d = s["diff"]
    verdict = "excludes" if (d["ci_low"] > 0 or d["ci_high"] < 0) else "includes"
    cap = (f"Accuracy on Iris (OpenML 61), {nrep}$\\times$5 stratified CV ({n} folds). Small markers: folds (jittered); "
           f"large: mean with 95\\% corrected repeated-CV $t$ interval ($\\mathrm{{df}}={n-1}$). "
           f"(b) LR (logistic regression) $-$ $k$-NN: {tex_num(d['mean'], True)} [{tex_num(d['ci_low'], True)}, {tex_num(d['ci_high'], True)}], "
           f"interval {verdict} zero.")
    (OUT_FIG / "fig_main_caption.tex").write_text(cap + "\n")
    print("wrote", OUT_FIG / "fig_main.pdf")


if __name__ == "__main__":
    main()
