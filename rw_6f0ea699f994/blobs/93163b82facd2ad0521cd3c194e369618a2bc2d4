"""Independent reference computation used by review to check delivered numbers.
Not a delivery; working material of internal-review-repo."""
import numpy as np
from scipy import stats

f = lambda x: np.exp(x) * np.sin(3 * x)
a, b = 0.0, 2.0
# antiderivative: e^x (sin 3x - 3 cos 3x) / 10
F = lambda x: np.exp(x) * (np.sin(3 * x) - 3 * np.cos(3 * x)) / 10
exact = F(b) - F(a)

ns = [2 ** k for k in range(2, 13)]
rows = []
for n in ns:
    x = np.linspace(a, b, n + 1); y = f(x); h = (b - a) / n
    T = h * (y[0] / 2 + y[1:-1].sum() + y[-1] / 2)
    S = h / 3 * (y[0] + 4 * y[1:-1:2].sum() + 2 * y[2:-1:2].sum() + y[-1])
    rows.append((n, abs(T - exact), abs(S - exact)))

print(f"exact = {exact:.17g}")
print(f"{'n':>5} {'err_trap':>12} {'err_simp':>12}")
for n, et, es in rows:
    print(f"{n:5d} {et:12.4e} {es:12.4e}")

for name, idx in (("trap", 1), ("simp", 2)):
    pts = [(r[0], r[idx]) for r in rows if r[idx] > 1e-13]
    lx = np.log([p[0] for p in pts]); ly = np.log([p[1] for p in pts])
    res = stats.linregress(lx, ly)
    t = stats.t.ppf(0.975, len(pts) - 2)
    print(f"{name}: N={len(pts)} n_max={pts[-1][0]} slope={res.slope:.5f} "
          f"95% CI [{res.slope - t*res.stderr:.5f}, {res.slope + t*res.stderr:.5f}]")
