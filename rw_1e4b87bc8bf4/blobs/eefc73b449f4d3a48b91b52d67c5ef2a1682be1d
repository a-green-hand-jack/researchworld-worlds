#!/usr/bin/env python3
"""Render Figure 1 (fig_main.pdf) and Table 1 (table_main.tex, table_main.csv) from report/results/.

Usage: python3 make_figtab.py [--results DIR] [--out DIR]
Inputs (written by report/code/): folds_long.csv, summary.json, numbers.tex, and identity.json when present.
Every plotted/printed number is read from these files; none is typed here.
"""
import argparse, json, re, sys
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

here = Path(__file__).resolve().parent
ap = argparse.ArgumentParser()
ap.add_argument("--results", type=Path, default=here.parent / "results")
ap.add_argument("--out", type=Path, default=here)
a = ap.parse_args()
R, OUT = a.results, a.out

S = json.loads((R / "summary.json").read_text())
folds = pd.read_csv(R / "folds_long.csv")
Q = S["quantities"]
PRIMARY = "corrected_t"
assert S["level"] == 0.95 and S["n_folds"] == 50

wide = folds.pivot_table(index=["repeat", "fold"], columns="method", values="accuracy")
diff = (wide["LR"] - wide["kNN"]).to_numpy()
acc = {"LR": wide["LR"].to_numpy(), "kNN": wide["kNN"].to_numpy()}
assert len(diff) == S["n_folds"]
for m in ("LR", "kNN"):
    assert abs(acc[m].mean() - Q[m][PRIMARY]["mean"]) < 1e-9, m
assert abs(diff.mean() - Q["LR_minus_kNN"][PRIMARY]["mean"]) < 1e-9

def pct(x):  # one decimal, percent, LaTeX minus
    s = f"{100 * x:.1f}"
    return s.replace("-", "$-$")

def ci(q, kind=PRIMARY):
    return f"[{pct(q[kind]['lo'])}, {pct(q[kind]['hi'])}]"

# ---------- cross-check against numbers.tex ----------
macros = dict(re.findall(r"\\newcommand\{\\(\w+)\}\{(.*)\}", (R / "numbers.tex").read_text()))
chk = {"LRMean": pct(Q["LR"][PRIMARY]["mean"]), "LRLo": pct(Q["LR"][PRIMARY]["lo"]), "LRHi": pct(Q["LR"][PRIMARY]["hi"]),
       "KNNMean": pct(Q["kNN"][PRIMARY]["mean"]), "KNNLo": pct(Q["kNN"][PRIMARY]["lo"]), "KNNHi": pct(Q["kNN"][PRIMARY]["hi"]),
       "DiffMean": pct(Q["LR_minus_kNN"][PRIMARY]["mean"]), "DiffLo": pct(Q["LR_minus_kNN"][PRIMARY]["lo"]),
       "DiffHi": pct(Q["LR_minus_kNN"][PRIMARY]["hi"])}
for k, v in chk.items():
    assert macros[k] == v, f"numbers.tex \\{k}={macros[k]} differs from summary.json-derived {v}"

# ---------- Table ----------
rows = [("Logistic regression", "LR"), ("$k$NN", "kNN"), ("LR $-$ $k$NN (pp)", "LR_minus_kNN")]
lines = [r"\small", r"\begin{tabular}{@{}lccc@{}}", r"\toprule",
         r"Method & Mean (\%) & 95\% interval, corrected $t$ & Naive $t$ interval \\", r"\midrule"]
csv = []
for label, key in rows:
    q = Q[key]
    if key == "LR_minus_kNN":
        lines.append(r"\midrule")
    lines.append(f"{label} & {pct(q[PRIMARY]['mean'])} & {ci(q)} & {ci(q, 'naive_t')} \\\\")
    csv.append(dict(row=key, mean_pct=100 * q[PRIMARY]["mean"], lo_corrected=100 * q[PRIMARY]["lo"],
                    hi_corrected=100 * q[PRIMARY]["hi"], lo_naive=100 * q["naive_t"]["lo"], hi_naive=100 * q["naive_t"]["hi"]))
idp = R / "identity.json"
if idp.exists():
    I = json.loads(idp.read_text())
    node = I["info_b"]["slurmd_nodename"]
    verdict = "identical" if I["identical"] else "not identical"
    lines += [r"\midrule", rf"\multicolumn{{4}}{{@{{}}l}}{{\scriptsize Local run (primary) vs.\ Ibex replicate (node {node}): {verdict}.}} \\"]
else:
    print("WARNING: identity.json not found; provenance row omitted", file=sys.stderr)
lines += [r"\bottomrule", r"\end{tabular}"]
(OUT / "table_main.tex").write_text("% Generated by make_figtab.py from report/results/summary.json; do not edit.\n" + "\n".join(lines) + "\n")
pd.DataFrame(csv).to_csv(OUT / "table_main.csv", index=False)

# ---------- Figure ----------
plt.rcParams.update({"font.family": "serif", "font.serif": ["STIXGeneral"], "mathtext.fontset": "stix",
                     "font.size": 7.5, "axes.labelsize": 7.5, "xtick.labelsize": 7.5, "ytick.labelsize": 7,
                     "axes.linewidth": 0.6, "pdf.fonttype": 42, "axes.spines.top": False, "axes.spines.right": False})
COL = {"LR": "#0072B2", "kNN": "#D55E00"}

def swarm(ax, x0, ys, color, step=0.045, size=7):
    # stack equal values side by side so discrete (1/30) ties stay visible
    ys = np.round(np.asarray(ys), 9)
    for v in np.unique(ys):
        n = int((ys == v).sum())
        xs = x0 + (np.arange(n) - (n - 1) / 2) * step
        ax.scatter(xs, np.full(n, v), s=size, color=color, alpha=0.55, linewidths=0, zorder=2)

def interval(ax, x, q, color, half=0.0):
    c = q[PRIMARY]
    ax.plot([x, x], [c["lo"], c["hi"]], color="k", lw=1.3, solid_capstyle="butt", zorder=3)
    ax.scatter([x], [c["mean"]], s=22, marker="D", facecolor=color, edgecolor="k", linewidths=0.7, zorder=4)

fig, (a1, a2) = plt.subplots(1, 2, figsize=(5.5, 2.15), gridspec_kw={"width_ratios": [1.25, 1], "wspace": 0.38})
for i, m in enumerate(("LR", "kNN")):
    swarm(a1, i - 0.0, 100 * acc[m], COL[m])
    interval(a1, i + 0.33, {PRIMARY: {k: 100 * Q[m][PRIMARY][k] for k in ("mean", "lo", "hi")}}, COL[m])
a1.set_xticks([0, 1]); a1.set_xticklabels(["LR", r"$k$NN"]); a1.set_xlim(-0.55, 1.65)
a1.set_ylabel("Fold accuracy (%)")
a1.set_title("(a) Accuracy per outer fold", fontsize=7.5, loc="left")
a1.yaxis.grid(True, lw=0.3, color="0.85"); a1.set_axisbelow(True)

swarm(a2, 0, 100 * diff, "0.25")
dq = {PRIMARY: {k: 100 * Q["LR_minus_kNN"][PRIMARY][k] for k in ("mean", "lo", "hi")}}
interval(a2, 0.33, dq, "0.7")
a2.axhline(0, color="k", lw=0.6, ls="--", zorder=1)
a2.set_xticks([0]); a2.set_xticklabels([r"LR $-$ $k$NN"]); a2.set_xlim(-0.45, 0.65)
a2.set_ylabel("Paired difference (pp)")
a2.set_title("(b) Paired difference per fold", fontsize=7.5, loc="left")
a2.yaxis.grid(True, lw=0.3, color="0.85"); a2.set_axisbelow(True)
cnt = S["paired_fold_counts"]
a2.text(0.98, 0.97, f"LR better: {cnt['lr_better']}\ntie: {cnt['tie']}\n" + r"$k$NN better: " + f"{cnt['knn_better']}",
        transform=a2.transAxes, ha="right", va="top", fontsize=6.5, color="0.2", linespacing=1.3)
fig.savefig(OUT / "fig_main.pdf", bbox_inches="tight", pad_inches=0.02)
print("wrote", OUT / "fig_main.pdf", OUT / "table_main.tex", OUT / "table_main.csv")
