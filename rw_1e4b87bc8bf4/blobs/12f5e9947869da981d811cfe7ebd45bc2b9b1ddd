#!/bin/bash
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --output=%x-%j.out
# Full 10x5 repeated stratified CV on one Ibex CPU node.
# Environment: Python 3.11 venv (uv-managed CPython) with code/requirements.txt.
set -euo pipefail
unset PYTHONPATH
export PYTHONNOUSERSITE=1
cd "$SLURM_SUBMIT_DIR"
echo "node: $(hostname) SLURMD_NODENAME=${SLURMD_NODENAME:-} job: $SLURM_JOB_ID"
lscpu | grep -E "Model name|^CPU\(s\)" || true
venv/bin/python -u code/cv_compare.py --data data/iris.arff --out results/ibex
