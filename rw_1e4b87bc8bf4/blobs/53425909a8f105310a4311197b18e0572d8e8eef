#!/usr/bin/env python3
"""Compare two runs of cv_compare.py (e.g. local vs Ibex) fold by fold.

Reports whether folds.csv and inner_scores.csv are byte-identical, and the
element-wise maximum absolute difference of every numeric column.
"""
import argparse
import hashlib
import json
import os

import numpy as np
import pandas as pd


def sha(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("run_a")
    ap.add_argument("run_b")
    ap.add_argument("--out", required=True)
    args = ap.parse_args()
    res = {"run_a": args.run_a, "run_b": args.run_b, "files": {}}
    for name in ["folds.csv", "inner_scores.csv"]:
        pa, pb = os.path.join(args.run_a, name), os.path.join(args.run_b, name)
        a, b = pd.read_csv(pa), pd.read_csv(pb)
        cols = {}
        for c in a.columns:
            if pd.api.types.is_numeric_dtype(a[c]):
                cols[c] = float(np.max(np.abs(a[c].to_numpy() - b[c].to_numpy())))
            else:
                cols[c] = int((a[c] != b[c]).sum())
        res["files"][name] = dict(sha256_a=sha(pa), sha256_b=sha(pb), byte_identical=sha(pa) == sha(pb),
                                  shape_equal=a.shape == b.shape, max_abs_diff_or_mismatches=cols)
    res["identical"] = all(f["byte_identical"] for f in res["files"].values())
    for side, d in [("a", args.run_a), ("b", args.run_b)]:
        info = json.load(open(os.path.join(d, "run_info.json")))
        res[f"info_{side}"] = {k: info.get(k) for k in
                               ["hostname", "slurm_job_id", "slurmd_nodename", "python", "numpy",
                                "scipy", "sklearn", "pandas", "platform", "data_md5", "wall_seconds",
                                "started_utc"]}
    with open(args.out, "w") as f:
        json.dump(res, f, indent=1)
    print(json.dumps(res, indent=1))


if __name__ == "__main__":
    main()
