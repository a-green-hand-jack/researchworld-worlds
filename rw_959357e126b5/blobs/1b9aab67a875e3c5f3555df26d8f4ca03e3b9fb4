"""Early check of the A1c tolerance (experiment-repo 82264e7 results/e4/a1_tolerance.json: alive/dead agreement >= 0.90
and |rank error| <= 1 at >= 90% of checkpoints) against predictors that use no Adam theory, on the committed A1
development grid (3e1e6d9 code/e4_dev.py, run exactly as committed through its run_one). The development grid is the
set the tolerance file reserves for building the phase model; nothing here touches a held-out grid.

Trivial predictors, per (run, direction, checkpoint), alive = |a| > 0.05 (the delivered SV_THR):
  all_alive     every direction alive at every checkpoint
  persist_K     the alive state at K = 300 held for ever
  static_bound  alive iff c^2 >= 4 lam s (the delivered GD static bound, which A-i says AdamW loses)
  oracle_const  per (run, direction), the state it holds at the majority of checkpoints (an upper bound for any
                time-independent rule; it reads the measured states, so it is a ceiling, not a predictor)

Usage: python3 checks/e4_dev_baserate.py /path/to/experiment-repo/code [NPROC] > checks/e4_dev_baserate.json
"""
import sys, os, json
os.environ.setdefault("OMP_NUM_THREADS", "1")
import numpy as np
from multiprocessing import Pool

sys.path.insert(0, sys.argv[1])
import e4_dev  # noqa: E402


def one(cfg):
    r = e4_dev.run_one(cfg)
    c, s = e4_dev.stats(cfg["stats"])
    A = np.array(r["absa"])                       # 20 checkpoints x 24 directions
    meas = A > e4_dev.THR
    preds = {
        "all_alive": np.ones_like(meas),
        "persist_K": np.broadcast_to(np.array(r["alive_K"]), meas.shape),
        "static_bound": np.broadcast_to(c * c >= 4 * cfg["lam"] * s, meas.shape),
        "oracle_const": np.broadcast_to(meas.mean(0) >= 0.5, meas.shape),
    }
    out = dict(id=cfg["id"], finite=r["finite"], alive_share=float(meas.mean()),
               rank=meas.sum(1).tolist())
    for k, P in preds.items():
        out[k] = dict(agree=float((P == meas).mean()),
                      rank_within1=float((np.abs(P.sum(1) - meas.sum(1)) <= 1).mean()))
    return out


if __name__ == "__main__":
    nproc = int(sys.argv[2]) if len(sys.argv) > 2 else 8
    cfgs = e4_dev.configs()
    with Pool(nproc) as pool:
        rows = pool.map(one, cfgs)
    names = ["all_alive", "persist_K", "static_bound", "oracle_const"]
    summ = {}
    for k in names:
        ag = np.array([r[k]["agree"] for r in rows]); rw = np.array([r[k]["rank_within1"] for r in rows])
        summ[k] = dict(agree_pooled=round(float(ag.mean()), 4),
                       rank_within1_pooled=round(float(rw.mean()), 4),
                       runs_meeting_A1c_both=int(((ag >= 0.90) & (rw >= 0.90)).sum()),
                       pooled_meets_A1c=bool(ag.mean() >= 0.90 and rw.mean() >= 0.90))
    by = {}
    for key in ("b2", "p0", "lam", "eta", "stats"):
        vals = sorted({c[key] for c in cfgs}, key=str)
        by[key] = {str(v): {k: round(float(np.mean([r[k]["agree"] for r, c in zip(rows, cfgs) if c[key] == v])), 4)
                            for k in ("all_alive", "persist_K", "oracle_const")} for v in vals}
    json.dump(dict(source="experiment-repo 3e1e6d9 code/e4_dev.py run_one (float64, eps 1e-8), 480 configs",
                   numpy=np.__version__, runs=len(rows), all_finite=all(r["finite"] for r in rows),
                   alive_share_pooled=round(float(np.mean([r["alive_share"] for r in rows])), 4),
                   summary=summ, agreement_by_factor=by,
                   per_run=[{k: r[k] for k in ["id", "alive_share"] + names} for r in rows]),
              sys.stdout, indent=1)
