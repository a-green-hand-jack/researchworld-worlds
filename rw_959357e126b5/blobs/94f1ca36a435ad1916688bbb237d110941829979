    return rows


def score(rows, margin=0.2, metric="count", ep=50, drop=None, f_ci=True):
    V = {k: [value(R, metric, ep) for R in v if (drop is None or (R["row"], R["seed"]) not in drop)] for k, v in rows.items()}
    res = dict(n={str(k): len(v) for k, v in V.items()}, means={str(k): float(np.mean(v)) for k, v in V.items()})
    if len(V["N"]) < 4 or len(V[0]) < 4:
        return dict(res, D="undetermined", reading="undetermined")
    gap = welch(V[0], V["N"], 0.95)
    inf = bool((gap[1] > 0 or gap[2] < 0) and abs(gap[0]) >= 5)
    delta = margin * abs(gap[0])
    res.update(gap=gap, informative=inf, delta=delta, rows={})
    for e in SW:
        if len(V[e]) < 4:
            res["rows"][str(e)] = None; continue
        c90, c95 = welch(V[e], V["N"], 0.90), welch(V[e], V["N"], 0.95)
        row = dict(values=V[e], diff90=c90, equivalent=bool(c90[1] > -delta and c90[2] < delta),
                   tost_slack=float(min(c90[1] + delta, delta - c90[2])), diff95=c95, different=bool(c95[1] > 0 or c95[2] < 0))
        if f_ci:
            row["f_boot"] = boot_f(V[e], V["N"], V[0]); row["f_fieller_df4"] = fieller_f(V[e], V["N"], V[0])
        else:
            row["f"] = float(fstat(V[e], V["N"], V[0]))
        res["rows"][str(e)] = row
    if any(res["rows"][str(e)] is None for e in SW):
        D = "undetermined"
    else:
        cand = [e for e in SW if all(res["rows"][str(e2)]["equivalent"] for e2 in SW if e2 >= e)]
        D = min(cand) if cand else ">20"
    if not inf:
        D = "uninformative"
    res["D"] = D
    r20 = res["rows"].get("20")
    res["reading"] = ("early" if D in (2, 5) else "intermediate" if D in (10, 20) else
                      ("late" if r20["different"] else "inconclusive at n=5") if D == ">20" else D)
    res["difference_at_20_demonstrated"] = bool(r20 and r20["different"])
    return res


def verdict(res):
    if res["D"] in ("undetermined", "uninformative"):
        return "not scored: " + res["D"]
    f20 = res["rows"]["20"]["f_boot"]
    if res["reading"] == "late" and f20[0] >= 0.5:
        return "holds (strong)" if f20[1] >= 0.5 else "holds"
    why = ([] if res["reading"] == "late" else ["reading %r, not 'late'" % res["reading"]]) + \
          ([] if f20[0] >= 0.5 else ["f(20) = %.3f < 0.5" % f20[0]])
    return "fails: " + "; ".join(why)


