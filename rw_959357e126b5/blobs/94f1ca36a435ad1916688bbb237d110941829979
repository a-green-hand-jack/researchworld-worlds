def welch(x, y, level):
    x, y = np.asarray(x, float), np.asarray(y, float)
    m = float(x.mean() - y.mean())
    if x.var(ddof=1) + y.var(ddof=1) == 0:
        return [m, m, m, "degenerate: zero variance in both rows"]
    ci = stats.ttest_ind(x, y, equal_var=False).confidence_interval(level)
    return [m, float(ci.low), float(ci.high)]


RNG = np.random.default_rng(20261018)
NB = 20000


def fstat(a, b, c):
    return (np.mean(a) - np.mean(b)) / (np.mean(c) - np.mean(b))


def boot_f(re, rn, rz):
    re, rn, rz = (np.asarray(v, float) for v in (re, rn, rz))
    ia, ib, ic = (RNG.integers(0, v.size, (NB, v.size)) for v in (re, rn, rz))
    a, b, c = re[ia].mean(1), rn[ib].mean(1), rz[ic].mean(1)
    with np.errstate(divide="ignore", invalid="ignore"):
        bs = (a - b) / (c - b)
    bs = bs[np.isfinite(bs)]
    return [float(fstat(re, rn, rz)), float(np.quantile(bs, 0.025)), float(np.quantile(bs, 0.975))]


def fieller_f(re, rn, rz, df=4, level=0.95):
    """Fieller interval for f = X / Y, X = mean(re) - mean(rn), Y = mean(rz) - mean(rn) (independent rows), t at df."""
    re, rn, rz = (np.asarray(v, float) for v in (re, rn, rz))
    va, vb, vc = (v.var(ddof=1) / v.size for v in (re, rn, rz))
    X, Y = re.mean() - rn.mean(), rz.mean() - rn.mean()
    Vx, Vy, Cxy = va + vb, vc + vb, vb
    t2 = stats.t.ppf(0.5 + level / 2, df) ** 2
    A, B, C = Y * Y - t2 * Vy, -2 * (X * Y - t2 * Cxy), X * X - t2 * Vx
    if A <= 0:
        return [float(X / Y), None, None]
    disc = B * B - 4 * A * C
    if disc < 0:
        return [float(X / Y), None, None]
    r1, r2 = (-B - math.sqrt(disc)) / (2 * A), (-B + math.sqrt(disc)) / (2 * A)
    return [float(X / Y), float(min(r1, r2)), float(max(r1, r2))]


def value(R, metric, ep):
    if not R["ok"]:
        return 0.0
    return {"count": R["count"], "rankme": R["rankme"], "rankme_re": R["rankme_re"]}[metric][ep] if metric in ("count", "rankme", "rankme_re") \
        else int((R["eig"][ep] >= metric * R["eig"][ep][0]).sum())


def cell_rows(arm, d):
