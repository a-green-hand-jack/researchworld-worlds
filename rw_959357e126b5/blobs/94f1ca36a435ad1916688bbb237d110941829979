def sched(c, k):
    """lr, wd of update index k as vit_jepa.hyper (re-implemented)."""
    if c["sched"] == "const":
        lr = c["lr"]
    else:
        warm = int(c["warmup_frac"] * TOT)
        lr = c["lr"] * k / max(warm, 1) if k < warm else c["lr"] * 0.5 * (1 + math.cos(math.pi * min((k - warm) / (TOT - warm), 1.0)))
    w0, w1 = c["wd"]
    wd = w1 + (w0 - w1) * 0.5 * (1 + math.cos(math.pi * min(k / TOT, 1.0)))
    if c["wd_switch_epoch"] >= 0 and k >= int(round(c["wd_switch_epoch"] * SPE)):
        wd = c["wd_after"]
    return lr, wd


