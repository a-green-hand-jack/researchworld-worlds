"""Referee check of experiment-repo pilot/linear_flow.py (262f42dbb66b):
is the rank count (sv > 1e-3) separating survivors from the initial scale w0 = 1e-3,
and is the final rank converged in T?  Same dynamics, copied from the pilot."""
import numpy as np, json
n = d = 32
k = np.arange(n); s = np.ones(n); c = 0.9 ** k
def run(lam, p0, w0=1e-3, eta=0.05, T=4000, seed=0, snap=()):
    r = np.random.default_rng(seed)
    W = w0 * r.standard_normal((d, n)) / np.sqrt(n); P = p0 * np.eye(d)
    S11, S21 = np.diag(s), np.diag(c); out = {}
    sv0 = np.linalg.svd(W, compute_uv=False)
    for t in range(1, T + 1):
        R = P @ W @ S11 - W @ S21
        gW = P.T @ R + lam * W; gP = R @ W.T + lam * P
        W -= eta * gW; P -= eta * gP
        if t in snap: out[t] = np.linalg.svd(W, compute_uv=False)
    return sv0, out
print("initial W singular values (seed 0): min %.2e median %.2e max %.2e" % ((lambda v: (v.min(), np.median(v), v.max()))(run(0, 1, T=0)[0])))
rows = []
for lam in [0.0, 0.01, 0.03, 0.05]:
    for p0 in [0.2, 0.5, 1.0, 2.0]:
        for seed in [0, 1, 2]:
            _, o = run(lam, p0, T=32000, seed=seed, snap=(4000, 32000))
            row = dict(lam=lam, p0=p0, seed=seed)
            for t, sv in o.items():
                row[f"abs1e-3_T{t}"] = int((sv > 1e-3).sum()); row[f"gt0.1_T{t}"] = int((sv > 0.1).sum())
                row[f"svmax_T{t}"] = float(sv.max())
            rows.append(row); print(row, flush=True)
json.dump(rows, open("/hutian/repo/checks/pilot_rank_threshold.json", "w"), indent=1)
