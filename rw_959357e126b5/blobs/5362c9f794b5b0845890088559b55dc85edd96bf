"""Validation for checks/e1_long_horizon.py: my reduced per-mode Euler flow, stopped at each run's own t_end,
reproduces E1's full-GD survival labels (experiment-repo 883c59deff1c, race/orthogonal runs).
Usage: python3 checks/e1_reduced_matches_gd.py E1_RUNS_JSONL"""
import sys, json
import numpy as np
n = d = 32; C = 0.9 ** np.arange(n); S = np.ones(n); ETA = 0.1; THR = 0.05
R = [json.loads(l) for l in open(sys.argv[1])]
R = [r for r in R if r["exp"] == "race" and r["init"] == "orthogonal"]
def init_norms(seed, w0):
    rng = np.random.default_rng(seed); rng.standard_normal((d, n))
    return w0 * np.exp(0.1 * rng.standard_normal(n))
a = np.array([init_norms(r["seed"], r["w0"]) for r in R])
lam = np.array([r["lam"] for r in R])[:, None]; alpha = np.array([r["alpha"] for r in R])[:, None]
p = np.broadcast_to(np.array([r["p0"] for r in R])[:, None], a.shape).copy()
stop = np.array([int(r["t_end"] / ETA) for r in R]); at_end = np.zeros_like(a)
for i in range(1, stop.max() + 1):
    da = a * (p * C - p ** 2 * S - lam); dp = alpha * ((C - p * S) * a ** 2 - lam * p)
    a += ETA * da; p += ETA * dp; a[a < 1e-150] = 0.0
    m = stop == i
    if m.any(): at_end[m] = a[m]
e1 = np.array([r["surv"] for r in R], bool); mine = at_end > THR
print(json.dumps(dict(runs=len(R), mode_labels=int(e1.size), disagree=int((e1 != mine).sum()),
                      runs_rank_differs=int((e1.sum(1) != mine.sum(1)).sum()))))
