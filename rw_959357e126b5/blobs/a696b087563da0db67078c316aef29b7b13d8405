"""A-iv' settledness: after capture, does |p| - |a| relax at a rate of order eta*lam (the sign-flow balance
|p| - |a| = e^{-eta lam t}(|p0| - |a0|), jacobs2026never Lemma 4.5 as corollary in brief v4.2 5.3)?
Own float64 scalar AdamW on the dev2 statistics (experiment-repo code/e4_dev.py), p0 2, a0 1e-2, b1 0.9, b2 0.999.
Usage: python3 checks/e4_aiv_balance.py /path/to/experiment-repo-checkout > checks/e4_aiv_balance.json"""
import sys, os, json, numpy as np
sys.path.insert(0, os.path.join(sys.argv[1], 'code')); import e4_dev as dev
c, s = dev.stats('dev2'); out = []
for eta, lam in [(0.01, 0.002), (0.02, 0.005), (0.05, 0.002), (0.01, 0.02)]:
    a = np.full(c.size, 1e-2); p = np.full(c.size, 2.0); ma = np.zeros(c.size); va = ma.copy(); mp = ma.copy(); vp = ma.copy()
    b1, b2, eps = 0.9, 0.999, 1e-8; dec = 1 - eta * lam; D = {}
    for t in range(1, 60001):
        r = c - p * s; ga = -a * p * r; gp = -a * a * r
        ma = b1 * ma + (1 - b1) * ga; va = b2 * va + (1 - b2) * ga * ga; mp = b1 * mp + (1 - b1) * gp; vp = b2 * vp + (1 - b2) * gp * gp
        a = a * dec - eta * (ma / (1 - b1 ** t)) / (np.sqrt(va / (1 - b2 ** t)) + eps); p = p * dec - eta * (mp / (1 - b1 ** t)) / (np.sqrt(vp / (1 - b2 ** t)) + eps)
        if t in (20000, 60000): D[t] = np.abs(p) - np.abs(a)
    k = [0, 6, 12, 18, 23]
    with np.errstate(divide='ignore', invalid='ignore'):
        rate = np.log(np.abs(D[20000][k]) / np.abs(D[60000][k])) / 40000 / (eta * lam)
    out.append(dict(eta=eta, lam=lam, eta_lam_T=round(eta * lam * 60000, 2), k=k, gap_20k=np.round(D[20000][k], 5).tolist(),
                    gap_60k=np.round(D[60000][k], 6).tolist(), rate_over_eta_lam=[None if not np.isfinite(x) else round(float(x), 3) for x in rate],
                    a_T_over_cs=np.round((np.abs(a) / (c / s))[k], 4).tolist()))
print(json.dumps(out, indent=1))
