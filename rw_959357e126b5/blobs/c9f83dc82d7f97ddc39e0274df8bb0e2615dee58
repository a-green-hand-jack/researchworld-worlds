import numpy as np
def run(a0,p0,c,s,lam,eta=0.02,T=20000,b1=0.9,b2=0.999,eps=1e-8,opt="adam"):
    th=np.array([a0,p0],float); m=np.zeros(2); v=np.zeros(2); hist=[]
    for t in range(1,T+1):
        a,p=th
        g=np.array([-a*(p*c-p*p*s), -a*a*(c-p*s)])
        if opt=="adam":
            m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g
            u=(m/(1-b1**t))/(np.sqrt(v/(1-b2**t))+eps)
        elif opt=="sign": u=np.sign(g)
        else: u=g
        th=th*(1-eta*lam)-eta*u
        if t%(T//20)==0: hist.append((t,th[0],th[1]))
    return hist
for (a0,p0,c,s,lam) in [(1e-3,1.0,0.5,1.0,1e-2),(1e-2,1.0,0.5,1.0,1e-2),(1e-3,1.0,0.5,1.0,0.0),(1e-3,1.0,0.5,1.0,0.2),(0.3,1.0,0.5,1.0,1e-2),(1e-3,0.3,0.5,1.0,1e-2)]:
    print("a0,p0,c,s,lam",a0,p0,c,s,lam)
    for opt in ["adam","sign"]:
        h=run(a0,p0,c,s,lam,opt=opt)
        print(" ",opt," ".join(f"{t}:{a:.3g},{p:.3g}" for t,a,p in h[::3]))
