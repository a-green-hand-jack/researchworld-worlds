def render():
    W = ["0.72in", "1.38in", "1.46in", "0.94in", "0.64in"]
    cols = "".join(r">{\raggedright\arraybackslash}p{" + w + "}" for w in W)
    head = [r"\toprule", r"Test & Registered prediction (tolerance) & Measured [95\% CI] & Best baseline & Verdict as registered \\", r"\midrule"]
    L = [r"{\scriptsize", r"\setlength{\tabcolsep}{2pt}", r"\renewcommand{\arraystretch}{1.08}", r"\begin{longtable}{@{}" + cols + r"@{}}",
         r"\caption{" + CAPTION2 + r"}\label{tab:ext-tests}\\"] + head + [r"\endfirsthead"] + head + [r"\endhead", r"\bottomrule", r"\endfoot"]
    first = True; prov = []; in1a = False
    def fix(x):
        for a, b in TEXT_MAP + GLOBAL_MAP: x = x.replace(a, b)
        return x
    for r in rows:
        if r[0] == "group":
            title = r[1]
            for a, b in GROUP_MAP:
                if title.startswith(a): title = b + title[len(a):]; break
            else:
                assert title.startswith(("E8,", "E7,")), "unmapped group: " + title
            in1a = title.startswith("Deep linear encoder")
            prov.append((title.split(" (")[0].split(",")[0], r[2]))
            if not first: L.append(r"\midrule")
            first = False
            L.append(r"\multicolumn{5}{@{}p{5.4in}@{}}{\raggedright\arraybackslash\textbf{" + title + r"}} \\*[1pt]")
        else:
            cells = [rename_row(r[1])] + [fix(c) for c in r[2:]]
            if in1a: cells = [c.replace("A1 MAE", "closed-form MAE").replace("(baseline $-$ A1)", "(baseline $-$ closed form)").replace("A1 equals", "the closed form equals").replace("A1 MAE below", "closed-form MAE below").replace("A1", "closed form") for c in cells]
            L.append(" & ".join(cells) + r" \\")
    PROV = r"\textit{Score files (results/):} " + "; ".join(r"\textbf{" + n + r"}: " + ", ".join(tt(x) for x in files) for n, files in prov) + "."
    L += [r"\addlinespace[3pt]", r"\multicolumn{5}{@{}p{5.4in}@{}}{" + fix(NOTE) + r" \texttt{stage\_qs} is the staged model of the schedule account, the baseline of the post-loss law." + r"} \\", r"\multicolumn{5}{@{}p{5.4in}@{}}{\tiny " + PROV + r"} \\", r"\end{longtable}", r"}"]
    return "\n".join(L) + "\n"

def make(outdir, tabdir):
    os.makedirs(tabdir, exist_ok=True)
    open(os.path.join(tabdir, "tab_ext_tests.tex"), "w").write(render())
    common.record_inputs(tabdir, "tab_ext_tests", sorted(set(USED)))

