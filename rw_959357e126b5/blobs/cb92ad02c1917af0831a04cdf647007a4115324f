    f"static bound MAE {f(A4P['static_bound']['mae'], 2)}, delivered race {f(A4P['delivered_race']['mae'], 2)} (all runs)", "N2 better, each")
ls_, aa, dm, ec = A4C["ln_static"], A4C["all_alive"], A4C["dev_median"], A4C["early_count"]
assert ls_["word"] == aa["word"] == dm["word"] == "N2 better" and ec["word"].startswith("N2 at least as good as the early")
row("A4, reported words", "not criteria; the early count is read by rung 1a's rule, never ``beats measurement''",
    f"(baseline $-$ N2), sample-robust runs: \\texttt{{ln\\_static}} {f(ls_['mean'], 2)} {cu(ls_['ci'])} ({f(ls_['differing_runs']['mean'], 2)} {cu(ls_['differing_runs']['ci'])} on its {ls_['differing_runs']['n_runs']} differing runs); \\texttt{{all\\_alive}} {f(aa['mean'], 2)} {cu(aa['ci'])}; \\texttt{{dev\\_median}} {f(dm['mean'], 2)} {cu(dm['ci'])}; early count {f(ec['mean'], 2)} {cu(ec['ci'])}",
    f"\\texttt{{ln\\_static}} {f(A4P['ln_static']['mae'], 2)}, \\texttt{{all\\_alive}} {f(A4P['all_alive']['mae'], 2)}, \\texttt{{dev\\_median}} (constant rank 7) not scored beside; MAEs on all runs",
    "N2 better than \\texttt{ln\\_static}, \\texttt{all\\_alive}, \\texttt{dev\\_median}; N2 at least as good as the early reading")
