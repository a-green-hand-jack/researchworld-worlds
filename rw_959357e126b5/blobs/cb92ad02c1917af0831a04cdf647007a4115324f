"""T-ext (tab:ext-tests): one row per registered extension test, in the README order. Every measured value, CI, baseline and verdict is read from
the score files named in each group header (results/ paths); only the registered predictions/tolerances (the text of the registration) are typed here."""
import os, sys, json
sys.path.insert(0, os.path.dirname(__file__))
import common

def np_mean(x): return sum(x) / len(x)

R = common.results_dir()
USED = []

def J(rel):
    p = os.path.join(R, rel); USED.append(p); return json.load(open(p))

def f(x, d=3): return f"{x:.{d}f}".replace("-", "$-$")
def ci(c, d=2): return f"[{f(c[0], d)}, {f(c[1], d)}]"
def cu(c, d=2): return ci([x + (1e-9 if x >= 0 else -1e-9) for x in c], d)
def rng(vals): return f"{min(vals)}--{max(vals)}" if min(vals) != max(vals) else f"{min(vals)}"
def tt(s): return r"\texttt{" + s.replace("_", r"\_") + "}"

BASE = {"all_alive": "all-alive", "persistence_K": "persistence at $K$", "static_bound": "static bound", "majority_oracle": "majority oracle",
        "delivered_race": "delivered race", "window_mu_wd": "window", "mu_count": "$\\mu$ count", "dev_median": "dev.\\ median",
        "early_25": "reading at $t{=}25$", "early_50": "reading at $t{=}50$", "window": "window", "staticL": "static$_L$", "static1": "static$_1$",
        "race_depth1": "race, depth 1"}

rows = []   # ("group", title, files) | ("row", test, pred, meas, base, verdict)
def group(title, files): rows.append(("group", title, files))
def row(*a): rows.append(("row",) + a)

# ---- A1 grid 1 (frozen v3)
def a1_block(d, tag, with_a1a):
    same = lambda t: "as in grid 1" if not with_a1a else t
    nr = d["runs"]
    if with_a1a:
        a = d["A1a"]
        row("A1a (reduction)", "state agr.\\ $\\ge$0.99 and rank equality $\\ge$0.99",
            f"{f(a['state_agreement'])} and {f(a['rank_equal'])} ({a['runs']} runs)", "--", "fails" if not a["pass"] else "passes")
    b = d["A1b"]
    row("A1b (burst wait)", same("median $|\\ln$ ratio$|\\le$0.05, p90 $\\le$0.15, misses $\\le$5\\%, median $\\le\\frac12$ oracle"),
        f"median {f(b['median'], 4)}, p90 {f(b['p90'], 4)}, misses {100 * b['miss_share']:.2f}\\% ({b['scored']} dirs.)",
        f"constant-wait oracle: median {f(b['constant_wait_oracle']['median'], 2)}", "passes" if b["pass"] else "fails")
    c = d["A1c"]
    row("A1c (return wait)", same("median $\\le$0.10, p90 $\\le$0.30, misses $\\le$5\\%, median $\\le\\frac12$ oracle"),
        f"median {f(c['median'], 4)}, p90 {f(c['p90'], 3)}, misses {100 * c['miss_share']:.2f}\\% ({c['scored']} dirs.)",
        f"constant-wait oracle: median {f(c['constant_wait_oracle']['median'], 2)}", "passes" if c["pass"] else "fails")
    e = d["A1d"]; er, fl = e["error_rate"], e["rank_within_1_failure"]
    bb = min((k for k in er if k != "model"), key=lambda k: er[k]); bf = min((k for k in fl if k != "model"), key=lambda k: fl[k])
    row("A1d (alive state, rank)", same("agr.\\ $\\ge$0.90; rank $\\pm1$ $\\ge$0.90; error $\\le\\frac12$ best baseline"),
        f"agr.\\ {f(1 - er['model'])}; rank $\\pm1$ {f(1 - fl['model'])}",
        f"{BASE[bb]}: error {f(er[bb])}; rank $\\pm1$ {f(1 - fl[bf])}", "passes" if e["pass"] else "fails")

A1 = J("e4/a1/a1_score.json")
