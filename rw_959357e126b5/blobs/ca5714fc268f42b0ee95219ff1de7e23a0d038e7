"""Review check (internal-review-repo): re-run a stratified subset of the A4 held-out runs (experiment c25c7a1, frozen
code/e4_a4.py md5 a7e50edf as registered in results/e4/prediction_a4.json rev. 3) with the registered run_one, under
the delivered runs' numpy (2.4.6), and compare every non-timing field (truth, floor, orth, flow, every prediction)
with the delivered runs. Subset rule in subset.json."""
import sys, os, json, gzip, time
os.environ.setdefault("OMP_NUM_THREADS", "1"); os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
SRC = "/hutian/work/a4h/src"; H = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, "/hutian/work/np246"); sys.path.insert(1, os.path.join(SRC, "code"))
from multiprocessing import Pool
import numpy as np
import e4_a4 as A

def one(cfg):
    t = time.time(); r = A.run_one(cfg)
    print(f"run {cfg['id']} done {time.time() - t:.0f}s", flush=True); return r

def leaves(d, pth=()):
    if isinstance(d, dict):
        for k, v in d.items(): yield from leaves(v, pth + (k,))
    elif isinstance(d, list):
        for i, v in enumerate(d): yield from leaves(v, pth + (i,))
    else: yield pth, d

if __name__ == "__main__":
    sub = json.load(open(os.path.join(H, "subset.json"))); ids = set(sub["ids"])
    cf = [c for c in A.configs("heldout") if c["id"] in ids]
    t0 = time.time()
    with Pool(8) as p:
        res = p.map(one, sorted(cf, key=lambda c: -c["T"] * c["d"]), chunksize=1)
    D = {r["cfg"]["id"]: r for r in map(json.loads, gzip.open(os.path.join(SRC, "results/e4/a4_heldout/a4_heldout_runs.jsonl.gz"), "rt"))}
    out = {}
    for r in res:
        i = r["cfg"]["id"]
        a = {k: v for k, v in D[i].items() if k not in ("cpu_s", "wall_s")}
        b = {k: v for k, v in json.loads(json.dumps(r)).items() if k not in ("cpu_s", "wall_s")}
        la, lb = dict(leaves(a)), dict(leaves(b))
        diff = [str(k) for k in set(la) | set(lb) if repr(la.get(k, "MISSING")) != repr(lb.get(k, "MISSING"))]
        out[i] = dict(n_leaves=len(la), n_diff=len(diff), diff=sorted(diff)[:10],
                      truth=[D[i]["truth"].get("rank"), r["truth"].get("rank")],
                      floor=[D[i]["floor"]["rank"], r["floor"]["rank"]], n2=[D[i]["pred"]["n2"], r["pred"]["n2"]],
                      orth=[D[i]["orth"], r["orth"]] if D[i].get("orth") else None)
    summ = dict(runs=len(res), fragile_in_subset=len(sub["fragile"]), runs_with_diff=sum(1 for v in out.values() if v["n_diff"]),
                leaves=sum(v["n_leaves"] for v in out.values()), leaves_diff=sum(v["n_diff"] for v in out.values()),
                numpy=np.__version__, code_md5=A.md5(A.__file__), wall_s=round(time.time() - t0, 1))
    json.dump(dict(summary=summ, subset=sub, runs=out), open(os.path.join(H, "rerun_subset.json"), "w"), indent=1)
    print("HUTIAN_WAKE: A4 held-out subset rerun done " + json.dumps(summ), flush=True)
