import numpy as np
def run(a0,p0,c,s,lam,eta=0.02,T=60000,b1=0.9,b2=0.999,eps=1e-8,opt="adam"):
    th=np.array([a0,p0],float); m=np.zeros(2); v=np.zeros(2); A=np.empty(T); Pp=np.empty(T)
    for t in range(1,T+1):
        a,p=th
        g=np.array([-a*(p*c-p*p*s), -a*a*(c-p*s)])
        if opt=="adam":
            m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g
            u=(m/(1-b1**t))/(np.sqrt(v/(1-b2**t))+eps)
        else: u=np.sign(g)
        th=th*(1-eta*lam)-eta*u; A[t-1]=th[0]; Pp[t-1]=th[1]
    return A,Pp
c,s=0.5,1.0
for lam in [0.003,0.01,0.03,0.1]:
  for opt in ["adam","sign"]:
    A,P=run(0.2,0.5,c,s,lam,opt=opt)   # start on the line p=c/s with a<c/s
    x=np.abs(A); dist=np.abs(x-c/s)
    # fit log dist slope over the first half of the relaxation
    i=np.arange(len(dist)); ok=(dist>0.02)&(dist<0.25)
    k=-np.polyfit(i[ok],np.log(dist[ok]),1)[0] if ok.sum()>50 else float('nan')
    print(lam,opt,"rate/step",f"{k:.2e}","eta*lam",f"{0.02*lam:.2e}","ratio",f"{k/(0.02*lam):.2f}","final|a|",f"{x[-1]:.3f}","p",f"{P[-1]:.3f}")
