"""Referee check of the E1b pre-registration (experiment-repo 0576788, results/e1b/prediction.json, code/e1b.py):
is the rank E1b will measure at each run's pre-registered horizon t_end the final rank, and does the
pre-registered "converged" flag (rank unchanged over the last 4 of 20 checks) certify it?

Aligned arms only, where the per-mode reduction is exact (orthogonal encoder columns, identity predictor
factors, co-diagonal statistics, GD): grid, ema_alpha, depth, balanced.  Own Euler implementation of the
reduced flow (same eta = 0.1, same update order as code/linjepa.py simulate(), same initial column norms
from the same RNG calls), validated on E1 (checks/e1_reduced_matches_gd.py, 34560/34560 labels).
Depth L: each identity factor stays q I on the mode, product p = q^L,
  dq/dt = alpha [q^(L-1) (c abar - p s a) a - lam q].
No outcome of the pre-registered predictions is computed here: only horizon finality of the measurement
and whether the pre-registered predictor is itself horizon-truncated.

Usage: python3 checks/e1b_horizon.py PREDICTION_JSON LINJEPA_PY
"""
import sys, json, importlib.util, collections
import numpy as np

pred_path, lin_path = sys.argv[1], sys.argv[2]
spec = importlib.util.spec_from_file_location("linjepa", lin_path); lin = importlib.util.module_from_spec(spec)
spec.loader.exec_module(lin)
D = json.load(open(pred_path))
n = d = 24; SIG = np.linspace(1.5, 0.5, n); C = SIG * 0.92 ** np.arange(n); ETA = 0.1; THR = 0.05
T_LONG = 40000.0; T_MID = 20000.0
R = [r for r in D["runs"] if r["exp"] in ("grid", "ema_alpha", "depth", "balanced")]

def init_norms(r):
    rng = np.random.default_rng(r["seed"])
    rng.standard_normal((d, n))
    return r["w0"] * np.exp(r["jitter"] * rng.standard_normal(n))

A0 = np.array([init_norms(r) for r in R])
N = len(R)
lam = np.array([r["lam"] for r in R])[:, None]; alpha = np.array([r["alpha"] for r in R])[:, None]
L = np.array([r["depth"] for r in R])[:, None].astype(float)
kap = np.array([0.0 if r["kappa"] is None else r["kappa"] for r in R])[:, None]
ema = np.array([r["kappa"] is not None for r in R])[:, None]
q = np.broadcast_to(np.array([r["p0"] ** (1.0 / r["depth"]) for r in R])[:, None], A0.shape).copy()
a = A0.copy(); ab = A0.copy()
T_end = np.array([int(r["t_end"] / ETA) for r in R])
checks = [set(np.linspace(0, T, 21).astype(int)[1:].tolist()) for T in T_end]
at_end = np.zeros_like(a); rank_hist = [[] for _ in range(N)]
step_to_runs = collections.defaultdict(list)
for j, cs in enumerate(checks):
    for s in cs:
        step_to_runs[s].append(j)
snap = {}
steps = int(T_LONG / ETA)
for i in range(1, steps + 1):
    p = q ** L
    tb = np.where(ema, ab, a)
    da = -p * p * SIG * a + p * C * tb - lam * a
    dq = alpha * (q ** (L - 1) * (C * tb - p * SIG * a) * a - lam * q)
    a = a + ETA * da; q = q + ETA * dq
    ab = np.where(ema, ab + ETA * kap * (a - ab), a)
    if i % 50 == 0:
        a[np.abs(a) < 1e-150] = 0.0; ab[np.abs(ab) < 1e-150] = 0.0; q[np.abs(q) < 1e-150] = 0.0
    if i in step_to_runs:
        for j in step_to_runs[i]:
            rank_hist[j].append(int((np.abs(a[j]) > THR).sum()))
            if i == T_end[j]:
                at_end[j] = a[j]
    if i * ETA in (T_MID, T_LONG):
        snap[i * ETA] = a.copy()

S_end = np.abs(at_end) > THR; S_long = np.abs(snap[T_LONG]) > THR; S_mid = np.abs(snap[T_MID]) > THR
conv = np.array([len(set(h[-4:])) == 1 for h in rank_hist])
pre = np.array([r["pred"] for r in R], bool)
# the pre-registered predictor without its horizon cut (aligned GD arms; balanced uses Tian's basin, no horizon)
pre_inf = np.array([[lin.escape_score(C[k], SIG[k], r["lam"], r["lam"], r["alpha"], r["p0"], np.log(A0[j, k]),
                                      kappa=r["kappa"], t_end=np.inf, depth=r["depth"]) >= 0 for k in range(n)]
                    if r["exp"] != "balanced" else r["pred"] for j, r in enumerate(R)], bool)
out = dict(source="experiment-repo 0576788 results/e1b/prediction.json, code/e1b.py, code/linjepa.py",
           T_long=T_LONG, labels_stable_20000_to_40000=bool(np.array_equal(S_mid, S_long)), arms={})
def summarise(name, g):
    rk_end = S_end[g].sum(1); rk_long = S_long[g].sum(1)
    nf = rk_end != rk_long
    ent = dict(runs=int(g.sum()),
               t_end_range=[float(min(r["t_end"] for r, x in zip(R, g) if x)), float(max(r["t_end"] for r, x in zip(R, g) if x))],
               mode_labels_not_final=int((S_end[g] != S_long[g]).sum()),
               runs_rank_at_t_end_not_final=int(nf.sum()),
               runs_flagged_converged=int(conv[g].sum()),
               runs_flagged_converged_but_not_final=int((conv[g] & nf).sum()),
               mean_abs_rank_change_after_t_end=float(np.abs(rk_end - rk_long).mean()),
               runs_where_preregistered_pred_differs_from_untruncated=int((pre[g].sum(1) != pre_inf[g].sum(1)).sum()))
    out["arms"][name] = ent
arms = collections.OrderedDict()
ex = np.array([r["exp"] for r in R]); lam0 = lam[:, 0] == 0
arms["grid lam=0 (t_end=1500)"] = (ex == "grid") & lam0
arms["grid lam>0"] = (ex == "grid") & ~lam0
for k in ["ema_alpha", "depth", "balanced"]:
    arms[k] = ex == k
arms["all aligned"] = np.ones(N, bool)
for nm, g in arms.items():
    summarise(nm, g)
# lam = 0: asymptotic survivors are the window p0 < c/s; amplitude w*^2 = c^2/s^2 - p0^2 + w0^2 (alpha = 1)
g0 = (ex == "grid") & lam0
p0v = np.array([r["p0"] for r in R])[g0][:, None]
win = p0v * C - p0v ** 2 * SIG > 0
wstar = np.sqrt(np.maximum((C / SIG) ** 2 - p0v ** 2 + A0[g0] ** 2, 0))
out["lam0"] = dict(window_modes=int(win.sum()), window_modes_with_wstar_below_thr=int((win & (wstar <= THR)).sum()),
                   window_modes_not_above_thr_at_t_end=int((win & ~S_end[g0]).sum()),
                   window_modes_not_above_thr_at_T_long=int((win & ~S_long[g0]).sum()))
# examples of non-final runs
ex_list = []
for j in np.where(S_end.sum(1) != S_long.sum(1))[0][:12]:
    r = R[j]
    ex_list.append(dict(exp=r["exp"], p0=r["p0"], lam=r["lam"], alpha=r["alpha"], kappa=r["kappa"], depth=r["depth"],
                        seed=r["seed"], t_end=round(r["t_end"], 1), rank_t_end=int(S_end[j].sum()),
                        rank_T_long=int(S_long[j].sum()), flagged_converged=bool(conv[j])))
out["examples"] = ex_list
print(json.dumps(out, indent=1))
json.dump(out, open("checks/e1b_horizon.json", "w"), indent=1)
