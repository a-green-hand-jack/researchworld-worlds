def render():
    W = ["0.72in", "1.38in", "1.46in", "0.94in", "0.64in"]
    cols = "".join(r">{\raggedright\arraybackslash}p{" + w + "}" for w in W)
    head = [r"\toprule", r"Test & Registered prediction (tolerance) & Measured [95\% CI] & Best baseline & Verdict as registered \\", r"\midrule"]
    L = [r"{\scriptsize", r"\setlength{\tabcolsep}{2pt}", r"\renewcommand{\arraystretch}{1.08}", r"\begin{longtable}{@{}" + cols + r"@{}}",
         r"\caption{" + CAPTION + r"}\label{tab:ext-tests}\\"] + head + [r"\endfirsthead"] + head + [r"\endhead", r"\bottomrule", r"\endfoot"]
    first = True
    for r in rows:
        if r[0] == "group":
            if not first: L.append(r"\midrule")
            first = False
            L.append(r"\multicolumn{5}{@{}p{5.4in}@{}}{\textbf{" + r[1] + r"} \quad {\tiny " + ", ".join(tt(x) for x in r[2]) + r"}} \\*[1pt]")
        else:
            L.append(" & ".join(r[1:]) + r" \\")
    L += [r"\addlinespace[3pt]", r"\multicolumn{5}{@{}p{5.4in}@{}}{" + NOTE + r"} \\", r"\end{longtable}", r"}"]
    return "\n".join(L) + "\n"

def make(outdir, tabdir):
    os.makedirs(tabdir, exist_ok=True)
    open(os.path.join(tabdir, "tab_ext_tests.tex"), "w").write(render())
    common.record_inputs(tabdir, "tab_ext_tests", sorted(set(USED)))

if __name__ == "__main__":
    root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
    make(None, sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, "paper", "tables"))
