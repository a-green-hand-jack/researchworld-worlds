group(f"E5, weight-decay schedules, held-out ({n(A5['runs'])} runs, frozen stage\\_model\\_qs)",
      ["e5/b1heldout/b1_heldout_score.json", "e5/b1_tolerance_v2.json", "e5/b1heldout/mu_baseline.json"])
cells5 = {k: c for k, c in V5["cells"].items() if c["pairs"] >= 100}
bad = [k for k, c in cells5.items() if not c["B1a_ok"]]
assert sorted(bad) == sorted(V5["B1a_prime"]["cells_failing"])
CELLN = {"base": "base", "alpha0.5": "$\\alpha{=}0.5$", "ema0.2": "EMA 0.2"}
