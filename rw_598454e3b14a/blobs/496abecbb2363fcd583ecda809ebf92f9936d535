B2 = E5["B2"]; a = B2["B2a"]; gr = B2["B2a"]["groups_all_pred_negative"]
row("B2a (warm-up sign)", "sign of final count (step-up $-$ constant high) agrees in $\\ge$0.90 of pairs; mean $D<0$ with CI below 0 where predicted negative on every seed",
    f"sign agreement {f(a['sign_agree'], 3)} ({a['pairs']} pairs; $D<0$ in {a['meas_negative']}, all predicted); {len(gr)} such groups, mean $D$ = {f(min(g['mean_meas'] for g in gr.values()), 2)} {ci(gr[next(iter(gr))]['ci'], 2)}",
    "--", "passes" if a["pass_"] else "fails")
b2b = B2["B2b"]
row("B2b (increasing-schedule bound)", "no run ends above the static count at the final $\\lambda$",
    f"{b2b['violations']} violations in {n(b2b['runs'])} runs", "--", "passes" if b2b["pass_"] else "fails")
c = B2["B2c"]
row("B2c (late decrease)", "predicted $R$ = measured $R$ in $\\ge$0.90 of runs",
    f"{f(c['agree'], 3)} ({n(c['runs'])} runs; non-fragile {f(c['agree_non_fragile'], 3)}); {100 * c['meas_R_zero']:.0f}\\% of runs revive nothing; runs with $R>0$ ({c['nonzero']['runs']}): {f(c['nonzero']['agree'], 2)}",
