"""T-ext (tab:ext-tests): one row per registered extension test, in the README order. Every measured value, CI, baseline and verdict is read from
the score files named in each group header (results/ paths); only the registered predictions/tolerances (the text of the registration) are typed here."""
import os, sys, json
sys.path.insert(0, os.path.dirname(__file__))
import common

R = common.results_dir()
USED = []

def J(rel):
    p = os.path.join(R, rel); USED.append(p); return json.load(open(p))

def f(x, d=3): return f"{x:.{d}f}".replace("-", "$-$")
def ci(c, d=2): return f"[{f(c[0], d)}, {f(c[1], d)}]"
def tt(s): return r"\texttt{" + s.replace("_", r"\_") + "}"

BASE = {"all_alive": "all-alive", "persistence_K": "persistence at $K$", "static_bound": "static bound", "majority_oracle": "majority oracle",
        "delivered_race": "delivered race", "window_mu_wd": "window", "mu_count": "$\\mu$ count", "dev_median": "dev.\\ median",
        "early_25": "reading at $t{=}25$", "early_50": "reading at $t{=}50$", "window": "window", "staticL": "static$_L$", "static1": "static$_1$",
        "race_depth1": "race, depth 1"}

rows = []   # ("group", title, files) | ("row", test, pred, meas, base, verdict)
def group(title, files): rows.append(("group", title, files))
def row(*a): rows.append(("row",) + a)

# ---- A1 grid 1 (frozen v3)
def a1_block(d, tag, with_a1a):
    same = lambda t: "as in grid 1" if not with_a1a else t
    nr = d["runs"]
    if with_a1a:
        a = d["A1a"]
        row("A1a (reduction)", "state agr.\\ $\\ge$0.99 and rank equality $\\ge$0.99",
            f"{f(a['state_agreement'])} and {f(a['rank_equal'])} ({a['runs']} runs)", "--", "fails" if not a["pass"] else "passes")
    b = d["A1b"]
    row("A1b (burst wait)", same("median $|\\ln$ ratio$|\\le$0.05, p90 $\\le$0.15, misses $\\le$5\\%, median $\\le\\frac12$ oracle"),
        f"median {f(b['median'], 4)}, p90 {f(b['p90'], 4)}, misses {100 * b['miss_share']:.2f}\\% ({b['scored']} dirs.)",
        f"constant-wait oracle: median {f(b['constant_wait_oracle']['median'], 2)}", "passes" if b["pass"] else "fails")
    c = d["A1c"]
    row("A1c (return wait)", same("median $\\le$0.10, p90 $\\le$0.30, misses $\\le$5\\%, median $\\le\\frac12$ oracle"),
        f"median {f(c['median'], 4)}, p90 {f(c['p90'], 3)}, misses {100 * c['miss_share']:.2f}\\% ({c['scored']} dirs.)",
        f"constant-wait oracle: median {f(c['constant_wait_oracle']['median'], 2)}", "passes" if c["pass"] else "fails")
    e = d["A1d"]; er, fl = e["error_rate"], e["rank_within_1_failure"]
    bb = min((k for k in er if k != "model"), key=lambda k: er[k]); bf = min((k for k in fl if k != "model"), key=lambda k: fl[k])
    row("A1d (alive state, rank)", same("agr.\\ $\\ge$0.90; rank $\\pm1$ $\\ge$0.90; error $\\le\\frac12$ best baseline"),
        f"agr.\\ {f(1 - er['model'])}; rank $\\pm1$ {f(1 - fl['model'])}",
        f"{BASE[bb]}: error {f(er[bb])}; rank $\\pm1$ {f(1 - fl[bf])}", "passes" if e["pass"] else "fails")

A1 = J("e4/a1/a1_score.json")
group(f"A1, held-out grid 1 (frozen v3; {A1['runs']} runs)", ["e4/a1/a1_score.json", "e4/a1_tolerance_v2.json"])
a1_block(A1, "a1", True)

H2 = J("e4/a1h2/a1h2_score.json")
group(f"A1\\_v4 H2, held-out grid 2 (frozen v4; {H2['runs']} runs)", ["e4/a1h2/a1h2_score.json", "e4/prediction.json"])
a1_block(H2, "h2", False)

H3 = J("e4/a1h3/a1h3_score.json")
un, se = H3["bins"]["unsettled_le_2.52"]["A1d"]["rank_within_1_failure"], H3["bins"]["settled_ge_12.6"]["A1d"]["rank_within_1_failure"]
bu = min((k for k in un if k != "model"), key=lambda k: un[k]); bs = min((k for k in se if k != "model"), key=lambda k: se[k])
nun, nse = H3["bins"]["unsettled_le_2.52"]["runs"], H3["bins"]["settled_ge_12.6"]["runs"]
binding = un["model"] > 0.10 and un["model"] > 2 * se["model"]
group(f"A1\\_v4 H3, scope of the settled law ($\\eta\\lambda T$ from 0.54 to 25.2; {H3['all']['runs']} runs)", ["e4/a1h3/a1h3_score.json", "e4/prediction.json"])
row("H3 scope (A-iv$'$)", "binding iff unsettled-bin rank-$\\pm1$ failure $>$0.10 and $>2\\times$ the settled bin's",
    f"failure: unsettled {f(un['model'])} ({nun} runs), settled {f(se['model'])} ({nse} runs)",
    f"{BASE[bu]} failure {f(un[bu], 2)} / {f(se[bs], 2)}", "binding" if binding else "not binding for the count")

# ---- A2, A2'
A2 = J("e4/a2/a2_score.json")["all"]
rk = A2["rank"]; bs2 = max((k for k in rk if k != "model"), key=lambda k: rk[k]["within1_strict"])
bc2 = min((k for k in rk if k != "model"), key=lambda k: rk[k]["mae_converged"])
group(f"A2, AdamW rank at $T_h$ (frozen v4; {A2['runs']} runs, {A2['runs'] - A2['nonconverged_finite']} converged)", ["e4/a2/a2_score.json", "e4/prediction.json"])
row("A2, strict", "rank $\\pm1\\ge0.90-f_{\\rm floor}$ (non-converged = miss) and every baseline's MAE-difference CI $>0$",
    f"rank $\\pm1$ {f(rk['model']['within1_strict'])}", f"{BASE[bs2]}: {f(rk[bs2]['within1_strict'])}", "fails" if not A2["pass"] else "passes")
d2 = A2["model_vs_baseline"][bc2]
row("A2, converged runs only", "registered secondary scoring; reported beside the failure, not a pass",
    f"MAE {f(rk['model']['mae_converged'])} ($\\pm1$ {f(rk['model']['within1_converged'])}); {BASE[bc2]} $-$ model {f(d2['mae_diff_baseline_minus_model'], 2)} {ci(d2['ci95'])}",
    f"{BASE[bc2]}: MAE {f(rk[bc2]['mae_converged'], 2)}", "not a pass")
A2p = J("e4/a2p/a2p_score.json")["all"]
rp = A2p["rank_at_T_h"]; bp = min((k for k in rp if k != "model"), key=lambda k: rp[k]["mae_finite"]); dp = A2p["model_vs_baseline"][bp]
group(f"A2$'$, prospective test at $T_h$ (frozen v4; {A2p['runs']} runs)", ["e4/a2p/a2p_score.json", "e4/prediction.json"])
row("A2$'$", "rank $\\pm1\\ge0.90-f_{\\rm floor}$ on all runs; every baseline's MAE-difference CI $>0$",
    f"rank $\\pm1$ {f(rp['model']['within1'])}, MAE {f(rp['model']['mae_finite'])}; {BASE[bp]} $-$ model {f(dp['mae_diff_baseline_minus_model'], 2)} {ci(dp['ci95'])}",
    f"{BASE[bp]}: MAE {f(rp[bp]['mae_finite'], 2)}; $\\pm1$ {f(rp[bp]['within1'], 2)}", A2p["reading"])

# ---- A3s_mech
A3 = J("e4/a3h/a3h_score.json")
m = A3["model"]; sep = A3["separation"]
gd = A3["baselines"]["gd_account"]
group(f"A3s\\_mech, rotation and weight-decay signs ({A3['runs']['truth']} runs, {m['pairs']} paired cells)", ["e4/a3h/a3h_score.json", "e4/a3_tolerance.json"])
row("A3s\\_mech", "sign precision $\\ge$0.80, opposite $\\le$0.05, right in $\\ge$0.80 of the pairs where the prediction differs from each baseline",
    f"precision {f(m['precision'], 4)} ({m['n_pred_nonzero']} cells), opposite {f(m['opposite'], 2)}, recall {f(m['recall'], 2)}; right vs.\\ baselines {f(min(v['right'] for v in sep.values()), 2)}",
    f"GD account: precision {f(gd['precision'], 2)}, opposite {f(gd['opposite'], 2)}", "passes" if A3["pass"] else "fails")

# ---- E6 rung 1a
E6 = J("e6/r1heldout/r1_heldout_score.json")
group(f"E6 rung 1a, deep linear encoder, held-out ({E6['runs']} runs; tolerance v2)", ["e6/r1heldout/r1_heldout_score.json", "e6/r1_tolerance_v2.json"])
c1 = E6["control_L1"]
row("control $L{=}1$", "A1 equals the depth-1 race on every run (code check, not scored)",
    f"equal on {c1['runs']}/{c1['runs']} runs" if c1["A1_equals_race_depth1"] else "differs", f"A1 MAE {f(c1['A1']['mae'])}", "holds")
first6 = True
for arm in ("aligned", "generic"):
    for key, lab in (("L2", "$L{=}2$"), ("L3", "$L{=}3$"), ("L_ge2", "pooled")):
        x = E6[arm][key]; bl = x["baselines"]; bb = min(bl, key=lambda k: bl[k]["mae"])
        row(f"{arm}, {lab}", "as above" if not first6 else "within-1 $\\ge$0.90; A1 MAE below every baseline's; paired CI of (baseline $-$ A1) $>0$",
            f"A1 MAE {f(x['A1']['mae'])} {ci(x['A1']['mae_ci'], 3)}, within-1 {f(x['A1']['within1'], 2)} ({x['runs']} runs)",
            f"{BASE[bb]}: {f(bl[bb]['mae'])}; margin {f(bl[bb]['minus_A1'], 3)} {ci(bl[bb]['minus_A1_ci'], 3)}", "passes" if x["pass"] else "fails")
        first6 = False

# ---- E6 rung 1b
NK = r"\texttt{n1g\_K}"
R1B = J("e6/r1b_heldout/r1b_heldout_score.json"); J("e6/r1b_tolerance.json"); J("e6/prediction_r1b.json")
group(f"E6 rung 1b, deep predictor with random factors, held-out ({R1B['base_runs']} runs; registered before the runs)",
      ["e6/r1b_heldout/r1b_heldout_score.json", "e6/r1b_tolerance.json", "e6/prediction_r1b.json"])
B1B = {"n1g_d1": "depth-1 rule", "race_id": "identity race", "static": "static bound", "early_50.0": "reading at $t{=}50$", "early_25.0": "reading at $t{=}25$", "window_P0": "window ($P_0$)"}
def best_mu(x):
    k = min((k for k in x["baselines"] if k.startswith("dvd")), key=lambda k: x["baselines"][k]["mae"]); return k, x["baselines"][k]
def bname(k): return B1B.get(k, tt(k))
def margin(b): return f"{f(b['mae'])}; margin {f(b['minus_primary'], 3)} {ci(b['minus_primary_ci'], 3)}"
ARM1B = (("gauss", "Gaussian"), ("nearid", "perturbed identity"))
x1, x2 = R1B["gauss_M1_control"], R1B["nearid_M1_control"]
assert x1["baselines"]["n1g_d1"]["minus_primary"] == 0 == x2["baselines"]["n1g_d1"]["minus_primary"]
row("control $M{=}1$", "\\texttt{n1g\\_K} equals the depth-1 rule by construction (all capture rules coincide at $M{=}1$); a control, not a verdict",
    f"MAE {f(x1['n1g_K']['mae'])} Gaussian, {f(x2['n1g_K']['mae'])} perturbed identity ({x1['runs']} runs each)",
    f"depth-1 rule: {f(x1['baselines']['n1g_d1']['mae'])} / {f(x2['baselines']['n1g_d1']['mae'])} (identical)", "control")
first1b = True
for arm, lab in ARM1B:
    x = R1B[f"{arm}_M_ge2"]; bl = x["baselines"]; bb = min(bl, key=lambda k: bl[k]["mae"]); mk, mb = best_mu(x)
    assert R1B["verdict"][f"{arm}_M_ge2"] == x["pass"] and bb == "n1g_d1"
    row(f"{lab}, $M{{\\ge}}2$", "within-1 $\\ge$0.90; \\texttt{n1g\\_K} MAE below every baseline's; paired CI of (baseline $-$ \\texttt{n1g\\_K}) $>0$" if first1b else "as above",
        f"{NK} MAE {f(x['n1g_K']['mae'])} {ci(x['n1g_K']['mae_ci'], 3)}, within-1 {f(x['n1g_K']['within1'], 2)} ({x['runs']} runs)",
        f"{bname(bb)}: {margin(bl[bb])}", "passes" if x["pass"] else "fails")
    row(f"\\quad other baselines", "same comparison",
        f"identity race {margin(bl['race_id'])}; static bound {margin(bl['static'])}; reading at $t{{=}}50$ {margin(bl['early_50.0'])}",
        f"best $\\mu$ variant ({tt(mk)}): {margin(mb)}", "all beaten")
    first1b = False
for arm, lab in ARM1B:
    for M in (2, 3, 4):
        x = R1B[f"{arm}_M{M}"]; bl = x["baselines"]; bb = min(bl, key=lambda k: bl[k]["mae"]); b1 = bl["n1g_d1"]
        if bl[bb]["minus_primary_ci"][0] > 0: vtxt = "beats every baseline here"
        else:
            vtxt = ("not resolved from the depth-1 rule (margin CI includes 0)" if bb == "n1g_d1" else "not beaten by " + bname(bb)) + ("; ill-posed by the floor" if x["floor"]["ill_posed"] else "")
        row(f"{lab}, $M{{=}}{M}$ (reported)", "same rule; reported per depth, not a verdict cell",
            f"{NK} MAE {f(x['n1g_K']['mae'])} {ci(x['n1g_K']['mae_ci'], 3)}, within-1 {f(x['n1g_K']['within1'], 2)} ({x['runs']} runs)",
            f"{bname(bb)}: {margin(bl[bb])}" + ("" if bb == "n1g_d1" else f"; depth-1 rule {f(b1['mae'])}, margin {f(b1['minus_primary'], 3)} {ci(b1['minus_primary_ci'], 3)}"), vtxt)
for arm, lab in ARM1B:
    x = R1B[f"{arm}_M_ge2"]; r = x["reported"]["early_f0.10"]
    row(f"{lab}, $M{{\\ge}}2$, reading at 0.1\\,$T$", "not registered; reported beside the verdict",
        f"MAE {f(r['mae'])}; (reading $-$ {NK}) {ci(r['minus_primary_ci'], 3)}", "--",
        ("reading better than \\texttt{n1g\\_K}" if r["minus_primary_ci"][1] < 0 else "\\texttt{n1g\\_K} better than the reading" if r["minus_primary_ci"][0] > 0 else "unresolved"))

# ---- E5
E5 = J("e5/b1heldout/b1_heldout_score.json"); MU5 = J("e5/b1heldout/mu_baseline.json")["all"]; J("e5/b1_tolerance_v2.json")
A5 = E5["all"]; V5 = E5["verdicts"]; B5 = A5["B1a_prime"]; TM = B5["truth_or_model"]; SC = E5["schedules"]
