    f"{len(bad)} of {len(cells5)} cells below: " + "; ".join(f"short pulse, {CELLN[k.split('|')[1]]} {f(cells5[k]['agree'], 2)} ({n(cells5[k]['pairs'])})" for k in bad) + f"; lowest other cell {f(lo5, 2)}",
    "--", "fails" if not V5["B1a_prime"]["pass_"] else "passes")
b = A5["B1b_prime"]
row("B1b$'$, post-knot events", "median $|\\ln$ ratio$|\\le$0.10, p90 $\\le$0.30, unmatched $\\le$5\\%, unmatched below capture-static's",
    f"median {f(b['model']['median'])}, p90 {f(b['model']['p90'], 2)}, unmatched {100 * b['model']['unmatched_share']:.1f}\\% ({n(b['model']['events'])} events)",
