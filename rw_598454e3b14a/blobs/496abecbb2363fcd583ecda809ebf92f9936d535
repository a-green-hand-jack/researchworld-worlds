row("B1d (predictor after loss)", "median $|\\ln(|p|/p_{\\rm model})|\\le$0.5",
    f"median {f(V5['B1d']['median_abs'], 2)} ({n(d5['pairs'])} post-loss pairs, {d5['runs']} runs)",
