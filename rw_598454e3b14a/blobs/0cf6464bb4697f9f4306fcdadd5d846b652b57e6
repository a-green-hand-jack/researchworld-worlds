"""E3: I-JEPA-style small ViT on CIFAR-10 (CPU or one GPU), with the heuristics of the plan as options and
collapse / rank / drive-vs-decay diagnostics logged from the first steps.

Data: CIFAR-10 as uint8 arrays (code/prepare_cifar10.py -> DATA/train.npz, test.npz).
Usage: python3 code/e3_ijepa.py --out DIR [--epochs 8 --full-epochs 100 ...]; see --help.
Writes DIR/config.json, DIR/log.jsonl (one JSON per measurement), DIR/final.json.
"""
import argparse, json, math, os, time
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F

# ----------------------------------------------------------------------------- args

