    a.add_argument("--batch", type=int, default=256)
    a.add_argument("--threads", type=int, default=8)
    a.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    # architecture
    a.add_argument("--width", type=int, default=128)
