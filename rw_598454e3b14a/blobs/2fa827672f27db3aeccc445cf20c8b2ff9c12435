import sys, numpy as np
sys.path.insert(0,'.')
from e1b import stats, configs, SV_THR, d, C, SIG
from linjepa import simulate
c0=[c for c in configs() if c['exp']=='adam'][0]
S11,S21=stats(c0)
np.set_printoptions(precision=3, linewidth=200)
print("c/s", C/SIG)
for lam in [0.005,0.05]:
  for T in [50000,400000]:
    o=simulate(S11,S21,d,lam,lam,p0=0.5,w0=1e-4,eta=0.02,T=T,w_init='orthogonal',jitter=0.1,optimizer='adam',seed=0)
    print(lam,T,"mode norms",np.round(o['mode_norms'],3))
    print("   P diag in mode basis?", np.round(np.sort(np.linalg.svd(o['P'],compute_uv=False))[::-1],3))
