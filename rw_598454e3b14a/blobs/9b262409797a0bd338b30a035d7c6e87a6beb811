"""T6: E3 against the pre-registered criteria (prediction.json 8668858, prediction_followup.json bd947e1). Every number is read from results/e3/summary.json,
summary_followup.json and runs.csv; only labels are typed here."""
import os, sys
sys.path.insert(0, os.path.dirname(__file__))
import common

def make(outdir, tabdir):
    rows, S, F, paths = common.load_e3()
    PH = S["post_hoc"]["C-rank arm T split"]
    C = S["criteria"]; FC = F["criteria"]
    P = lambda ok: r"\textbf{pass}" if ok else r"\textbf{fail}"
    num = lambda x: f"{x:.2f}".replace("-", "$-$")
    ci = lambda c: rf"$\rho={c['rho']:.2f}$ [{num(c['ci'][0])}, {num(c['ci'][1])}], {c['n']} configs"
    ts = {t["test"].split(":")[0].split(" (")[0]: t for t in C["C-theory signs"]}
    th = C["C-theory signs"]
    wdT, wdP, lrP, lrT, dep, nosg, fro, ema = th
    cnt = lambda ns, rr=rows: ", ".join(f"{rr[n]['count']:.0f}" for n in ns)
    cnt1 = lambda ns: ", ".join(f"{rows[n]['count']:.1f}" for n in ns)
    L = C["C-loc wd arm T"]; D = C["C-dir"]; k = lambda a: FC[a]
    fl = FC["C-full count"]
    pr = {x['name']: 100 * sum(x['probe']) / len(x['probe']) for x in F['rows'] if x['name'].startswith('F_')}
    def sci(x):
        m, e = f"{x:.1e}".split("e"); return rf"${m}\times10^{{{int(e)}}}$"
    nm = {"P_pinit3": "P init 1$\\to$3", "P_pdepth6": "P depth 3$\\to$6"}
    sfail = ", ".join(nm.get(x["high"], x["high"].replace("_", " ")) for x in D["signed"] if not x["holds"])
    nfail = {}
    for x in D["null_list"]:
        if not x["holds"]:
            nfail[x["factor"]] = nfail.get(x["factor"], 0) + 1
    nfail_s = ", ".join(f"{f.replace('_', ' ')} ({n})" for f, n in nfail.items())
    pairs = lambda t: f"{sum(p['holds'] for p in t['pairs'])}/{len(t['pairs'])}"
    c4 = lambda key: (k(key)["direction_held"], k(key)["n"], k(key)["crossing_held"], k(key)["crossing_eligible"])
    def c4row(label, key, extra=""):
        d, n, c, e = c4(key)
        ok = (d >= 0.5 * n)
        cross = rf"crossing {c}/{e}" if e else "crossing: no eligible pair"
        return (label, r"sign of $\Delta$RankMe in $\ge2$ of 3 seeds; rescue/break crosses the collapse line", rf"direction {d}/{n}, {cross}" + extra,
                r"\textbf{dir.\ " + ("pass" if d == n else "fail") + (r", cross fail}" if e and c == 0 else "}") )
    R = [
        (r"rule vs measured count, Arm T", r"Spearman $\ge0.5$, bootstrap CI excludes 0", ci(C["C-rank arm T"]), P(C["C-rank arm T"]["passed"])),
        (r"post hoc split of the Arm T ranking", r"not registered", rf"wd sweep $\rho={PH['wd sweep']['rho']:.2f}$ ({PH['wd sweep']['n']} configs); other factors {PH['other factors']['rho']:.2f} ({PH['other factors']['n']})", "post hoc"),
        (r"rule vs measured count, Arm P", r"same", ci(C["C-rank arm P"]), P(C["C-rank arm P"]["passed"])),
        (r"critical weight decay, Arm T", r"observed transition within $\times2$ of the rule's", rf"observed {L['observed']:.4f}, rule {L['predicted']:.3f} ($\times${L['predicted']/L['observed']:.1f})", P(L["passed"])),
        (r"C-dir: signed pairs", r"measured $\Delta$RankMe has the predicted sign in $\ge2$ of 3 seeds", rf"{D['signed_held']} of {D['signed_pairs']} hold; fails: {sfail}", f"{D['signed_held']}/{D['signed_pairs']}"),
        (r"C-dir: registered nulls", r"measured counts differ by $\le\max(2,\mathrm{sd}_a{+}\mathrm{sd}_b)$", rf"{D['nulls_held']} of {D['nulls']} hold; fail: {nfail_s}", f"{D['nulls_held']}/{D['nulls']}"),
        (r"theory: rank falls with weight decay", r"each adjacent pair, both arms", rf"T {pairs(wdT)} pairs, P {pairs(wdP)} pairs; P: {cnt(['P_wd0', 'P_wd0.04', 'P_wdlarge'])}", P(wdT["passed"] and wdP["passed"])),
        (r"theory: rank falls with predictor lr", r"both arms, lr $\times0.1,1,10$", rf"P {pairs(lrP)}: {cnt(['P_plr0.1', 'P_base', 'P_plr10'])}; T {pairs(lrT)}: {cnt1(['T_plr0.1', 'T_wd0.01', 'T_plr10'])}", P(lrP["passed"] and lrT["passed"])),
        (r"theory: rank falls with predictor depth", r"Arm P, depth 1, 3, 6", rf"{pairs(dep)} pairs: {cnt(['P_pdepth1', 'P_base', 'P_pdepth6'])}", P(dep["passed"])),
        (r"theory: no stop-gradient collapses completely", r"total variance $<10^{-6}$ of init, or RankMe $<1.5$", rf"0 of 3 seeds; variance ratio {sci(rows['P_nosg']['tv_ratio'])} (P), {sci(rows['T_nosg']['tv_ratio'])} (T)", P(nosg["passed"])),
        (r"theory: frozen target does not collapse", r"count $\ge0.5\times$ init", rf"collapsed seeds: P {fro['result']['P_frozen']}/3, T {fro['result']['T_frozen']}/3", P(fro["passed"])),
        (r"theory: EMA rate changes the count by less than the seed spread", r"Arm P", rf"range {ema['range']:.0f} vs seed s.d.\ {ema['max_seed_std']:.0f}: {cnt(['P_copy', 'P_ema0.9', 'P_ema0.99', 'P_ema0.999'])} (base {rows['P_base']['count']:.0f})", P(ema["passed"])),
        c4row(r"C4, Arm T, interventions from the theory", "C4 arm T theory"),
        c4row(r"C4, Arm T, interventions from the rule", "C4 arm T rule"),
        c4row(r"C4, Arm P, copy target", "C4 arm P theory"),
        (r"full length (50 ep.): collapse flag", r"rule's flag equals measured collapse ($\ge2$ of 3 seeds)", rf"{sum(x['flag_right'] for x in fl)} of {len(fl)} right; counts " + ", ".join(f"{x['count']:.0f}" for x in fl) + " (rule " + ", ".join(f"{x['count_pred']:.0f}" for x in fl) + ")", P(all(x["flag_right"] for x in fl))),
        (r"full length: linear probe", r"collapsing config below the baseline in $\ge2$ of 3 seeds", rf"{FC['C-full probe']['seeds_lower']} of 3 seeds; probe {pr['F_T_wd0.03']:.1f}\% vs {pr['F_T_wd0.01']:.1f}\% (random init {100*rows['P_base']['probe_init']:.1f}\%)", P(FC["C-full probe"]["passed"])),
    ]
    T = [r"{\footnotesize", r"\newcolumntype{R}[1]{>{\raggedright\arraybackslash}p{#1}}", r"\begin{tabular}{@{}R{0.21\linewidth}R{0.24\linewidth}R{0.31\linewidth}R{0.10\linewidth}@{}}", r"\toprule",
         r"Test & Pre-registered criterion & Observed & Verdict \\", r"\midrule"]
    T += [" & ".join(r) + r" \\ \addlinespace[1.5pt]" for r in R] + [r"\bottomrule", r"\end{tabular}", r"}"]
    os.makedirs(tabdir, exist_ok=True)
    open(os.path.join(tabdir, "tab_e3.tex"), "w").write("\n".join(T) + "\n")
    common.record_inputs(tabdir, "tab_e3", paths)
