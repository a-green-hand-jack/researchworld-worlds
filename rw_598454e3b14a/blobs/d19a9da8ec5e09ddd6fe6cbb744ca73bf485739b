    cmd, outdir = sys.argv[1], sys.argv[2]
    os.makedirs(outdir, exist_ok=True)
    if cmd == "predict":
        cmd_predict(outdir)
    elif cmd == "run":
        cmd_run(outdir)
    elif cmd == "analyze":
        from e2_analyze import main
        main(outdir)
