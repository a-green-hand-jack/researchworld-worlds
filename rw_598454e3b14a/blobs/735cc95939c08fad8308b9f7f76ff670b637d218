def load_e1b_summary():
    path = os.path.join(results_dir(), "e1b", "summary.json")
    return json.load(open(path)), path

@functools.lru_cache(maxsize=None)
def load_e2():
    """E2 runs (csv + jsonl joined on id), summary.json and the paths used."""
    d = os.path.join(results_dir(), "e2")
    with open(os.path.join(d, "e2_runs.csv")) as f:
        rows = {int(r["id"]): r for r in csv.DictReader(f)}
    for r in rows.values():
        for k in ["r", "lam", "p0", "seed", "rank_meas", "rank_pred", "rank_window", "rank_bound", "freq_acc", "target_frac"]:
            r[k] = num(r[k])
    with open(os.path.join(d, "e2_runs.jsonl")) as f:
        for line in f:
            x = json.loads(line)
            if x["id"] in rows:
                rows[x["id"]].update({k: x.get(k) for k in ("rank_t", "surv_freq", "t_end")})
    S = json.load(open(os.path.join(d, "summary.json")))
    return list(rows.values()), S, [os.path.join(d, n) for n in ("e2_runs.csv", "e2_runs.jsonl", "summary.json")]

def e2_pred_freq():
    """Per-run predicted surviving multiplicity per Fourier frequency (0..32), from the per-mode `pred` and the mode->frequency map."""
    import numpy as np
    p = json.load(open(os.path.join(results_dir(), "e2", "prediction.json")))
    freq = np.array(p["spectra"]["bern/0.5"]["freq"])
    return {r["id"]: np.bincount(freq, weights=np.array(r["pred"], float), minlength=33) for r in p["runs"] if "pred" in r}, os.path.join(results_dir(), "e2", "prediction.json")


@functools.lru_cache(maxsize=None)
def load_e3():
    """E3 sweep rows by name (numbers parsed, per-seed counts as a list), summary.json, summary_followup.json and the paths used."""
    d = os.path.join(results_dir(), "e3")
    rows = {}
    with open(os.path.join(d, "runs.csv")) as f:
        for r in csv.DictReader(f):
            for k in ("count_pred", "count", "count_sd", "dim_collapse", "complete_collapse", "probe_online", "probe_init", "rankme_c", "tv_ratio", "count_init"):
                r[k] = float(r[k])
            r["count_seeds"] = [float(x) for x in r["count_seeds"].split()]
            r["value"] = None if r["value"] == "" else float(r["value"]) if r["value"].replace(".", "", 1).replace("-", "", 1).replace("e", "", 1).isdigit() else r["value"]
            rows[r["name"]] = r
    S = json.load(open(os.path.join(d, "summary.json"))); F = json.load(open(os.path.join(d, "summary_followup.json")))
    return rows, S, F, [os.path.join(d, n) for n in ("runs.csv", "summary.json", "summary_followup.json")]


def load_e3_traj(followup=False):
    """Trajectories by (name, seed): dicts with epoch and logged series (jsonl, one line per run)."""
    p = os.path.join(results_dir(), "e3", "trajectories_followup.jsonl" if followup else "trajectories.jsonl")
    out = {}
    for line in open(p):
        x = json.loads(line); out[(x["name"], x["seed"])] = x
    return out, p
