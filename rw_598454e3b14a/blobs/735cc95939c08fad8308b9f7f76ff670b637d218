import functools
import csv, hashlib, json, os

def results_dir():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.environ.get("RESULTS_DIR", os.path.abspath(os.path.join(here, "..", "..", "results")))

def num(x):
    return None if x == "" else float(x)

def load_e1():
    path = os.path.join(results_dir(), "e1", "e1_runs.csv")
    with open(path) as f:
        rows = list(csv.DictReader(f))
    for r in rows:
        for k in ["d", "lam", "p0", "alpha", "w0", "kappa", "depth", "seed", "t_end", "t_race", "rank_meas", "rank_pred",
                  "rank_reduced", "rank_window", "rank_bound", "mode_acc", "mode_acc_reduced", "rankme", "p_final"]:
            r[k] = num(r[k])
        r["race_finished"] = r["race_finished"] == "True"
    return rows, path

def record_inputs(outdir, name, paths):
    """Write <name>.inputs.json next to the output: sha256 of each results file the output was made from."""
    ent = {os.path.relpath(p, results_dir()): hashlib.sha256(open(p, "rb").read()).hexdigest() for p in paths}
    os.makedirs(outdir, exist_ok=True)
    json.dump({"output": name, "inputs_sha256 (paths relative to results/)": ent}, open(os.path.join(outdir, name + ".inputs.json"), "w"), indent=1)


def knob_slice(rows, exp, knob, **fixed):
    """E1 slice (orthogonal init, d=32) varying one knob: [(value, meas mean, meas sd, pred mean, window mean, bound mean, n)]."""
    import numpy as np
    base = [r for r in rows if r["init"] == "orthogonal" and r["d"] == 32 and r["exp"] == exp and all(r[k] == v for k, v in fixed.items())]
    out = []
    for v in sorted(set(r[knob] for r in base), key=lambda z: (z is None, z or 0)):
        s = [r for r in base if r[knob] == v]
        f = lambda k: np.array([r[k] for r in s], float)
        out.append((v, f("rank_meas").mean(), f("rank_meas").std(), f("rank_pred").mean(), f("rank_window").mean(), f("rank_bound").mean(), len(s)))
    return out

