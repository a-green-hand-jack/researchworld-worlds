"""Post hoc (not scoring; review experiment-repo#11 c266 points 4-5): attribute the A1d wrong pairs and rank-error>1
checkpoints of the A1 held-out grid to the two mechanisms behind the second collapse, under the step definition (S)
of code/checks/e4_a1_posthoc.py (dead at a checkpoint at or after the per-step first crossing of 0.05).
Each wrong (S) pair, i.e. a checkpoint where the model says alive and the truth says dead after the first crossing,
is classed by the truth's |a| at that checkpoint: hover (|a| >= 0.025, a captured amplitude below the threshold),
collapse (|a| < 1e-3), intermediate otherwise. Each (S) direction is classed the same way by its step-level minimum
|a| after the first crossing. A rank-error>1 checkpoint is attributed to the classes of its wrongly predicted (S)
pairs. The truth is recomputed in 80-bit (as code/e4_a1.py) and checked against the stored alive states.
Also the step-level trajectory of held-out id 23, k = 20 (the note's hover example).
Usage: python3 code/checks/e4_a1_mechanism.py [NPROC] > results/e4/a1/mechanism.json"""
import sys, os, json, gzip, time
os.environ.setdefault("OMP_NUM_THREADS", "1")
import numpy as np
from multiprocessing import Pool
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import e4_a1 as A

K, T, THR = A.K, A.T, A.THR
CK = A.CHECKS; RUNS = "results/e4/a1/a1_runs.jsonl.gz"
HOVER, COLL = 0.025, 1e-3


def traj(cfg, ks=None):
    c, s = A.stats(cfg["stats"]); L = np.longdouble
    c, s = c.astype(L), s.astype(L)
    eta, lam, b1, b2 = (L(cfg[x]) for x in ("eta", "lam", "b1", "b2")); eps = L(1e-8)
    a = A.init_a(cfg).astype(L); p = np.full(c.shape, L(cfg["p0"]))
    ma = np.zeros_like(c); va = np.zeros_like(c); mp = np.zeros_like(c); vp = np.zeros_like(c)
    seen = np.zeros(c.size, bool); mn = np.full(c.size, np.inf); amin_t = np.zeros(c.size, int)
    ck = set(CK); amp_ck = []; dec = 1 - eta * lam; tr = {k: [] for k in (ks or [])}
    for t in range(1, T + 1):
        r = c - p * s; ga = -a * p * r; gp = -a * a * r
        ma = b1 * ma + (1 - b1) * ga; va = b2 * va + (1 - b2) * ga * ga
        mp = b1 * mp + (1 - b1) * gp; vp = b2 * vp + (1 - b2) * gp * gp
        bc1, bc2 = 1 - b1 ** t, 1 - b2 ** t
        a = a * dec - eta * (ma / bc1) / (np.sqrt(va / bc2) + eps); p = p * dec - eta * (mp / bc1) / (np.sqrt(vp / bc2) + eps)
        if t > K:
            Aa = np.abs(a).astype(float); seen |= Aa > THR
            upd = seen & (Aa < mn); mn = np.where(upd, Aa, mn); amin_t = np.where(upd, t, amin_t)
        if t in ck:
            amp_ck.append(np.abs(a).astype(float))
        for k in tr:
            tr[k].append(float(abs(a[k])))
    return np.array(amp_ck), mn, amin_t, tr


def job(args):
    r, cfg = args
    amp, mn, mt, _ = traj(cfg)
    return r["id"], amp, mn, mt


def main():
    nproc = int(sys.argv[1]) if len(sys.argv) > 1 else 8
    t0 = time.time()
    runs = [json.loads(l) for l in gzip.open(RUNS, "rt")]
    cfgs = {c["id"]: c for c in A.configs()}
    secs = {}
    for r in runs:
        Al = np.array(r["alive"], bool)
        tm = np.array([np.inf if x is None else x for x in r["alive_from"]])
        tm[np.abs(np.array(r["state_K"]["a"])) > THR] = K
        secs[r["id"]] = (np.array(CK)[:, None] >= tm[None, :]) & ~Al
    todo = [(r, cfgs[r["id"]]) for r in runs if secs[r["id"]].any()]
    with Pool(nproc) as pool:
        res = {i: (amp, mn, mt) for i, amp, mn, mt in pool.map(job, todo)}
    cls = lambda x: np.where(x >= HOVER, 0, np.where(x < COLL, 1, 2))
    names = ["hover", "collapse", "intermediate"]
    D = dict(directions={n: 0 for n in names}, wrong_pairs_total=0, wrong_S_pairs={n: 0 for n in names},
             rankbad_total=0, rankbad_S=0, rankbad_by_class={n: 0 for n in names}, rankbad_only={n: 0 for n in names},
             wrong_S_pairs_by_direction_class={n: 0 for n in names}, alive_check_mismatch=0)
    for r in runs:
        Al = np.array(r["alive"], bool); P = np.array(r["pred_alive"], bool); sec = secs[r["id"]]
        W = P != Al; bad = np.abs(P.sum(1) - Al.sum(1)) > 1
        D["wrong_pairs_total"] += int(W.sum()); D["rankbad_total"] += int(bad.sum())
        if r["id"] not in res:
            continue
        amp, mn, mt = res[r["id"]]
        D["alive_check_mismatch"] += int(((amp > THR) != Al).sum())
        dcl = cls(mn); WS = W & sec; pcl = cls(amp)
        for j, n in enumerate(names):
            D["directions"][n] += int((sec.any(0) & (dcl == j)).sum())
            D["wrong_S_pairs"][n] += int((WS & (pcl == j)).sum())
            D["wrong_S_pairs_by_direction_class"][n] += int((WS & (dcl == j)[None, :]).sum())
        has = [(WS & (pcl == j)).any(1) for j in range(3)]
        D["rankbad_S"] += int((bad & WS.any(1)).sum())
        for j, n in enumerate(names):
            D["rankbad_by_class"][n] += int((bad & has[j]).sum())
            D["rankbad_only"][n] += int((bad & has[j] & ~has[(j + 1) % 3] & ~has[(j + 2) % 3]).sum())
    D["shares"] = dict(
        wrong_pairs_of_all={n: D["wrong_S_pairs"][n] / D["wrong_pairs_total"] for n in names},
        rankbad_any_of_all={n: D["rankbad_by_class"][n] / D["rankbad_total"] for n in names},
        rankbad_only_of_all={n: D["rankbad_only"][n] / D["rankbad_total"] for n in names},
        directions_of_S={n: D["directions"][n] / max(1, sum(D["directions"].values())) for n in names})
    # id 23, k = 20
    cfg = cfgs[23]; amp, mn, mt, tr = traj(cfg, [20]); x = np.array(tr[20]); t = np.arange(1, T + 1)
    above = np.where((t > K) & (x > THR))[0]
    ex = {}
    if above.size:
        i0 = above[0]; after = np.arange(i0, T); below = after[x[after] <= THR]
        ex = dict(first_crossing_step=int(t[i0]), min_after_crossing=float(x[i0:].min()), min_step=int(t[i0 + np.argmin(x[i0:])]))
        if below.size:
            j0 = below[0]; back = np.arange(j0, T)[x[j0:] > THR]
            ex.update(peak_before_drop=float(x[i0:j0].max()), first_below_step=int(t[j0]),
                      back_above_step=int(t[back[0]]) if back.size else None)
        ex["checkpoint_min_after_crossing"] = float(min(amp[i, 20] for i, c in enumerate(CK) if c >= t[i0]))
    out = dict(definitions=dict(S="dead at a checkpoint at or after the per-step first crossing of 0.05 (alive_from; alive at K counts from K)",
                                pair_class="the truth's |a| at the checkpoint of a wrong (S) pair: hover >= 0.025, collapse < 1e-3, intermediate otherwise",
                                direction_class="step-level minimum |a| after the first crossing, same thresholds",
                                rankbad="checkpoints with |predicted rank - true rank| > 1; *_by_class: with at least one wrong (S) pair of that class; *_only: of that class alone"),
               attribution=D, id23_k20=ex, runs_recomputed=len(res), seconds=time.time() - t0,
               command="python3 code/checks/e4_a1_mechanism.py", input=RUNS)
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()
