"""E5 / B1' (plan Sec. 3 B; theory/ext_B_stagewise.md B-iii): a prospective test of the post-loss law of the predictor,
after B1's registered failure. The frozen model is `stage_model_pl` below: the E5 frozen model stage_model_qs
(code/e5_theory.py, unchanged) up to a direction's loss, and from the loss on, while the direction stays dead, the
linearised post-loss law of B-iii,
    dp/dt = -alpha lam_P(t) p + alpha c w^2,      d log w / dt = g(p, lam_W(t)) = p c - p^2 s - lam_W(t),
(copy target: wbar = w; the dropped term is -alpha s p w^2, negligible while w <= THR). A loss is the model's own
alive -> dead crossing (w falls below THR). When the direction is alive again (w > THR) the quasi-steady rule of
stage_model_qs resumes, so a regrowth after a short pulse is decided by the predictor the law has left. Scope: copy
target (the grid has no EMA variant); EMA targets are not claimed.

Everything else is E5's held-out machinery, unchanged and imported from code/e5_b1.py (md5 as frozen in
results/e5/prediction.json): the exact 80-bit truth, the two truth-floor re-runs per run, the v2 scorer score_run_v2 /
summ_v2 / verdicts, and the tolerances results/e5/b1_tolerance_v2.json. The scored set is extended by two baselines:
stage_qs (stage_model_qs as frozen for E5; its quasi-steady predictor p = max(own decay, c w^2/(lam_P + s w^2)) is the
rule B1d failed on) and mu_dvd (the 2610.02344 criterion read at the current lam_W: alive iff p0 c - p0^2 s > lam_W(t),
results/e5/b1heldout/mu_baseline.json). B1d is also computed for stage_qs on the same pairs.

Usage: python3 code/e5_b1p.py list GRID | pilot GRID I | run GRID OUTDIR [NPROC] | score GRID OUTDIR
       (GRID = b1p_pilot for the timed pilot on disjoint seeds, b1p for the registered grid)"""
import sys, os, json, time, gzip, hashlib
os.environ.setdefault("OMP_NUM_THREADS", "1")
import numpy as np
from multiprocessing import Pool
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from linjepa import growth_rate
import e5_theory as th
import e5_b1 as B

THR = th.THR
ETA = B.ETA

# Grid: statistics, values, p0, seeds and variants disjoint from E5's dev and held-out grids. Plateau values at
# geometric midpoints between adjacent static thresholds (|ln(lam/lam*_k)| >= 0.125 > WELL_POSED). Variants span
# alpha rho < 1, = 1 (alpha = 1 and alpha != 1) and > 1 (below and above the resonance alpha rho = 2).
GRID_B1P = dict(n=16, s=(1.25, 0.5), ratio=0.92, pairs=None, p0=[0.85, 1.25], w0=1e-3, seeds=[310, 311, 312, 313, 314],
                T_cap=16000.0, floor=True, pulse_ts_mult=[0.5, 1.0, 1.5], short_ts_mult=[1.0, 1.5], short_dur=[0.4, 0.8, 1.6],
                variants=["a0.6", "rP0.4", "base", "a0.8rP1.25", "a1.6", "rP1.6", "rP3"], kinds=["pulse", "short_pulse"])
VARIANTS_B1P = {"a0.6": dict(alpha=0.6, kappa=None, rho=1.0), "rP0.4": dict(alpha=1.0, kappa=None, rho=0.4),
                "base": dict(alpha=1.0, kappa=None, rho=1.0), "a0.8rP1.25": dict(alpha=0.8, kappa=None, rho=1.25),
                "a1.6": dict(alpha=1.6, kappa=None, rho=1.0), "rP1.6": dict(alpha=1.0, kappa=None, rho=1.6),
                "rP3": dict(alpha=1.0, kappa=None, rho=3.0)}
AR_CLASS = {"a0.6": "<1", "rP0.4": "<1", "base": "=1", "a0.8rP1.25": "=1", "a1.6": "1-2", "rP1.6": "1-2", "rP3": ">2"}


def midpoints(G):
    c, s = B.stats(G); ls = np.sort(th.static_threshold(c, s))
    return np.sqrt(ls[1:] * ls[:-1])


def _pairs(G):
    """Geometric midpoints (ascending index i): (m0, m11), (m0, m13), (m2, m12). The race captures only directions with
    lam* well above lo (lam* >= 0.07 at p0 0.85, >= 0.13 at p0 1.25 for lo = m0), so the highs sit among those."""
    m = midpoints(G)
    return [(round(float(m[a]), 6), round(float(m[b]), 6)) for a, b in ((0, 11), (0, 13), (2, 12))]


GRID_B1P["pairs"] = _pairs(GRID_B1P)
# timed pilot: the same construction on seeds disjoint from the registered grid (never a registered configuration)
GRID_PILOT = dict(GRID_B1P, seeds=[390])
B.GRIDS["b1p"] = GRID_B1P
B.GRIDS["b1p_pilot"] = GRID_PILOT
B.VARIANTS_HO.update(VARIANTS_B1P)
EXTRA = ["stage_qs", "mu_dvd"]
for k in EXTRA:
    if k not in B.SCORED:
        B.SCORED.append(k); B.BASELINES.append(k)


def stage_model_pl(c, s, w0, p0, knotsW, knotsP, alpha=1.0, kappa=None, T=1000.0, dt=0.1, t_out=None):
    """The frozen B1' model (module docstring). Same returns as e5_theory.stage_model_qs, plus `post` (checkpoint x
    direction: on the post-loss law)."""
    if kappa is not None:
        raise ValueError("stage_model_pl is stated for a copy target only")
    c = np.asarray(c, float); s = np.asarray(s, float); n = c.size
    w0 = np.broadcast_to(np.asarray(w0, float), c.shape)
    N = int(round(T / dt)); t = np.arange(N + 1) * dt
    lW = th.lam_of(knotsW, t); lP = th.lam_of(knotsP, t)
    logw = np.log(w0).copy(); p = np.full(n, float(p0))
    W = np.empty((N + 1, n)); P = np.empty((N + 1, n)); POST = np.zeros((N + 1, n), bool); tc = np.full(n, np.nan)
    alive = np.exp(logw) > THR; post = np.zeros(n, bool)

    def pnc(lw, lp):
        w2 = np.exp(2 * np.minimum(lw, 50.0))
        return c * w2 / (lp + s * w2)

    def fp(p, lw, lp):
        return alpha * (c * np.exp(2 * np.minimum(lw, 50.0)) - lp * p)
    for j in range(N + 1):
        W[j] = np.exp(np.minimum(logw, 50.0)); P[j] = p; POST[j] = post
        if j == N:
            break
        g1 = growth_rate(p, c, s, lW[j], kappa)
        # quasi-steady branch (stage_model_qs, verbatim)
        pdec = p * np.exp(-alpha * 0.5 * (lP[j] + lP[j + 1]) * dt)
        p1q = np.maximum(pdec, pnc(logw + dt * g1, lP[j + 1]))
        # post-loss branch: Heun on the linear law
        k1 = fp(p, logw, lP[j]); p1l = p + dt * k1
        p1 = np.where(post, p1l, p1q)
        g2 = growth_rate(p1, c, s, lW[j + 1], kappa)
        logw = logw + 0.5 * dt * (g1 + g2)
        pq = pnc(logw, lP[j + 1])
        new = np.isnan(tc) & (pq > pdec) & (g2 > 0) & ~post
        tc[new] = t[j + 1]
        pl = p + 0.5 * dt * (k1 + fp(p1l, logw, lP[j + 1]))
        p = np.where(post, pl, np.maximum(pdec, pq))
        now = np.exp(np.minimum(logw, 50.0)) > THR
        post = np.where(alive & ~now, True, np.where(now, False, post))
        alive = now
    al = W > THR
    ev = [(int(k), "gain" if al[j + 1, k] else "loss", float(t[j + 1])) for j, k in zip(*np.nonzero(al[1:] != al[:-1]))]
    if t_out is None:
        t_out = t
    idx = np.clip(np.round(np.asarray(t_out) / dt).astype(int), 0, N)
    return dict(t=np.asarray(t_out, float), W=W[idx], P=P[idx], post=POST[idx], tc=tc, events=ev)


def predict_b1p(cfg, t_chk):
    """E5's predict_v2 (the registered scored set, frozen model stage_model_qs) with its 'model' renamed stage_qs, the
    B1' model as 'model', and mu_dvd."""
    out = B.predict_v2(cfg, t_chk)
    out["stage_qs"] = out.pop("model")
    G = B.GRIDS[cfg["grid"]]; c, s = B.stats(G); n = c.size
    w0 = np.linalg.norm(B.init_amp(cfg, n), axis=0)
    N = int(round(cfg["T"] / ETA)); tf = np.arange(N + 1) * ETA
    ich = np.clip(np.round(np.asarray(t_chk) / ETA).astype(int), 0, N)
    iex = np.clip(np.round(np.asarray(cfg["t_extra"], float) / ETA).astype(int), 0, N)
    m = stage_model_pl(c, s, w0, cfg["p0"], cfg["kW"], cfg["kP"], cfg["alpha"], cfg["kappa"], cfg["T"], dt=ETA)
    A = m["W"] > THR
    out["model"] = dict(chk=[B.bits(x) for x in A[ich]], ext=[B.bits(x) for x in A[iex]], events=m["events"],
                        P=[[float(x) for x in row] for row in m["P"][ich]], tc=[None if np.isnan(x) else float(x) for x in m["tc"]],
                        post=[B.bits(x) for x in m["post"][ich]])
    mu = (cfg["p0"] * c - cfg["p0"] ** 2 * s)[None, :] > th.lam_of(cfg["kW"], tf)[:, None]
    out["mu_dvd"] = dict(chk=[B.bits(x) for x in mu[ich]], ext=[B.bits(x) for x in mu[iex]], events=B.crossing_events(mu, tf))
    return out


def run_one(cfg):
    t0 = time.time()
    tr = B.truth(cfg)
    rec = dict(cfg=cfg, truth=tr, floor={k: B.floor_rec(B.truth(cfg, k)) for k in ("w0", "lam")}, pred=predict_b1p(cfg, tr["t"]))
    if cfg["matrix"]:
        rec["matrix"] = B.matrix_flow(cfg)
    rec["seconds"] = time.time() - t0
    return rec


def md5(path):
    return hashlib.md5(open(path, "rb").read()).hexdigest()


def cmd_run(grid, outdir, nproc=8):
    os.makedirs(outdir, exist_ok=True)
    cfgs = B.configs(grid)
    t0 = time.time(); done = 0
    with gzip.open(os.path.join(outdir, f"b1p_{grid}_runs.jsonl.gz"), "wt") as fh, Pool(nproc) as pool:
        for rec in pool.imap_unordered(run_one, sorted(cfgs, key=lambda c: -c["T"] * (1 + 3 * c["matrix"])), chunksize=1):
            fh.write(json.dumps(rec) + "\n"); done += 1
            if done % 200 == 0 or done == len(cfgs):
                print(f"{done}/{len(cfgs)} {time.time() - t0:.0f}s", flush=True)
    here = os.path.dirname(os.path.abspath(__file__))
    meta = dict(grid=grid, runs=len(cfgs), seconds=time.time() - t0, numpy=np.__version__, command=f"code/e5_b1p.py run {grid} {outdir} {nproc}",
                skipped_short_pulse=getattr(B.configs_heldout, "skipped", []),
                md5={f: md5(os.path.join(here, f)) for f in ("e5_b1p.py", "e5_b1.py", "e5_theory.py", "linjepa.py")})
    json.dump(meta, open(os.path.join(outdir, f"b1p_{grid}_meta.json"), "w"), indent=1)


def score_run(rec):
    """score_run_v2 (E5, unchanged) plus B1d for stage_qs on the same post-loss pairs and the alpha rho class."""
    out = B.score_run_v2(rec)
    cfg, tr, pr = rec["cfg"], rec["truth"], rec["pred"]
    A = np.array(tr["a"], float); Pt = np.array(tr["p"], float); am = A > THR
    dead = np.maximum.accumulate(am, axis=0) & ~am
    out["ar_class"] = AR_CLASS.get(cfg["variant"]); out["ar"] = cfg["alpha"] * cfg["rho"]
    if dead.any():
        Pq = np.array(pr["stage_qs"]["P"], float)
        with np.errstate(divide="ignore", invalid="ignore"):
            out["post_loss"]["stage_qs"] = np.log(np.abs(Pt[dead]) / np.maximum(Pq[dead], 1e-300)).tolist()
        n = am.shape[1]
        out["post_loss"]["model_on_law"] = B.unbits(pr["model"]["post"], n)[dead].tolist()
        out["post_loss"]["rate"] = rate_errors(am, np.abs(Pt), {"model": np.array(pr["model"]["P"], float), "stage_qs": Pq})
    return out


def rate_errors(am, Pt, models):
    """B1'-rate: the post-loss law's rate, free of the level the model carries into the loss. For each truth loss
    episode (direction k dead from check j until it is alive again or T) with >= 2 checks, e_i = ln(|p_truth| / p_model)
    at its checks and the drift e_i - e_first for i after the first. Returns {model: [drifts]}, pooled per run."""
    out = {k: [] for k in models}
    for k in range(am.shape[1]):
        j = 1
        while j < am.shape[0]:
            if am[j - 1, k] and not am[j, k]:
                e = j
                while e < am.shape[0] and not am[e, k]:
                    e += 1
                if e - j >= 2:
                    for nm, M in models.items():
                        with np.errstate(divide="ignore", invalid="ignore"):
                            er = np.log(Pt[j:e, k] / np.maximum(M[j:e, k], 1e-300))
                        out[nm] += (er[1:] - er[0]).tolist()
                j = e
            j += 1
    return out


def b1d_summary(rows):
    PL = [r["post_loss"] for r in rows if "post_loss" in r]
    if not PL:
        return dict(runs=0)
    cat = lambda k: np.array([v for x in PL for v in x[k]], float)
    fr = np.array([v for x in PL for v in x["fragile"]], bool)
    med = lambda v: float(np.nanmedian(np.abs(v))) if v.size and np.isfinite(v).any() else None
    sg = lambda v: float(np.nanmedian(v)) if v.size and np.isfinite(v).any() else None
    law = np.array([v for x in PL for v in x["model_on_law"]], bool)
    out = dict(runs=len(PL), pairs=int(fr.size), fragile_share=float(fr.mean()), model_on_law_share=float(law.mean()))
    for k in ("model", "stage_qs", "own_decay", "slaved_truth_w"):
        v = cat(k)
        out[k] = dict(median_abs=med(v), median_signed=sg(v), median_abs_non_fragile=med(v[~fr]),
                      median_abs_model_on_law=med(v[law]) if k in ("model", "stage_qs") else None)
    for k in ("model", "stage_qs"):
        v = np.array([d for x in PL for d in x["rate"][k]], float)
        out[k]["rate"] = dict(median_abs=med(v), median_signed=sg(v), pairs=int(v.size))
    return out


# Registered B1' verdicts (results/e5/prediction_b1p.json). E5's v2 verdicts (B.verdicts: B1a', B1b', B1d) apply to the
# B1' model unchanged; B1' adds:
#   B1d_by_class  : B1d (median |ln(p_truth / p_model)| over post-loss pairs <= 0.5) per alpha rho class
#   B1d_vs_qs     : the paired bootstrap CI over runs of median_abs(stage_qs) - median_abs(model) has lower bound > 0
#   rate          : B1'-rate (rate_errors) median |drift| <= 0.5 pooled and per alpha rho class
#   rate_vs_qs    : reported (both models share the pre-loss level; the rate is where they differ)
B1D_TOL = 0.5
RATE_TOL = 0.5


def verdicts_b1p(b):
    out = dict(B1d_by_class={c: dict(median_abs=x["model"]["median_abs"], pass_=bool(x["model"]["median_abs"] is not None and x["model"]["median_abs"] <= B1D_TOL))
                             for c, x in b["by_class"].items() if x.get("runs")})
    ci = b["qs_minus_model_ci"]
    out["B1d_vs_qs"] = dict(ci=ci, pass_=bool(ci is not None and ci[0] > 0))
    r = b["all"]["model"]["rate"]["median_abs"]
    out["rate"] = dict(pooled=r, pooled_pass=bool(r is not None and r <= RATE_TOL),
                       by_class={c: dict(median_abs=x["model"]["rate"]["median_abs"],
                                         pass_=bool(x["model"]["rate"]["median_abs"] is not None and x["model"]["rate"]["median_abs"] <= RATE_TOL))
                                 for c, x in b["by_class"].items() if x.get("runs")})
    out["rate"]["pass_"] = bool(out["rate"]["pooled_pass"] and all(v["pass_"] for v in out["rate"]["by_class"].values()))
    out["rate_vs_qs"] = dict(ci=b.get("rate_qs_minus_model_ci"))
    return out


def boot_diff(a, b, B_=2000, seed=0):
    """Paired percentile bootstrap over runs of median_abs(b) - median_abs(a), a/b = per-run lists of log errors."""
    rng = np.random.default_rng(seed); idx = np.arange(len(a)); bs = []
    for _ in range(B_):
        pick = rng.choice(idx, idx.size)
        x = np.concatenate([a[i] for i in pick]); y = np.concatenate([b[i] for i in pick])
        if x.size:
            bs.append(float(np.nanmedian(np.abs(y)) - np.nanmedian(np.abs(x))))
    return [float(np.percentile(bs, 2.5)), float(np.percentile(bs, 97.5))] if bs else None


def cmd_score(grid, outdir):
    G = B.GRIDS[grid]; rows = []
    with gzip.open(os.path.join(outdir, f"b1p_{grid}_runs.jsonl.gz"), "rt") as fh:
        for line in fh:
            rows.append(score_run(json.loads(line)))
    rows.sort(key=lambda r: r["id"])
    res = dict(grid=grid, model="stage_model_pl (code/e5_b1p.py, frozen in results/e5/prediction_b1p.json)",
               tolerance="results/e5/b1_tolerance_v2.json (unchanged)", schedules=B.summ_v2(rows),
               by_kind={k: B.summ_v2([r for r in rows if r["kind"] == k]) for k in G["kinds"]},
               by_variant={v: B.summ_v2([r for r in rows if r["variant"] == v]) for v in G["variants"]},
               by_cell={f"{k}|{v}": B.summ_v2([r for r in rows if r["kind"] == k and r["variant"] == v]) for k in G["kinds"] for v in G["variants"]},
               nonfinite=int(sum(not r["finite"] for r in rows)))
    res["verdicts"] = B.verdicts(res)
    res["B1d_b1p"] = dict(all=b1d_summary(rows), by_class={c: b1d_summary([r for r in rows if r["ar_class"] == c]) for c in sorted(set(AR_CLASS.values()))},
                          by_variant={v: b1d_summary([r for r in rows if r["variant"] == v]) for v in G["variants"]})
    PLr = [r for r in rows if "post_loss" in r]
    res["B1d_b1p"]["qs_minus_model_ci"] = boot_diff([np.array(r["post_loss"]["model"], float) for r in PLr],
                                                    [np.array(r["post_loss"]["stage_qs"], float) for r in PLr])
    res["B1d_b1p"]["rate_qs_minus_model_ci"] = boot_diff([np.array(r["post_loss"]["rate"]["model"], float) for r in PLr],
                                                         [np.array(r["post_loss"]["rate"]["stage_qs"], float) for r in PLr], seed=1)
    res["verdicts_b1p"] = verdicts_b1p(res["B1d_b1p"])
    json.dump(res, open(os.path.join(outdir, f"b1p_{grid}_score.json"), "w"), indent=1)
    with gzip.open(os.path.join(outdir, f"b1p_{grid}_scored_runs.jsonl.gz"), "wt") as fh:
        for r in rows:
            fh.write(json.dumps(r) + "\n")
    print(json.dumps({k: v for k, v in res["verdicts"].items() if k != "cells"}, indent=1), flush=True)
    print(json.dumps(res["B1d_b1p"]["all"], indent=1), flush=True)
    print(json.dumps(res["verdicts_b1p"], indent=1), flush=True)


if __name__ == "__main__":
    cmd = sys.argv[1]
    if cmd == "list":
        cs = B.configs(sys.argv[2])
        print(len(cs), "runs;", sum(c["matrix"] for c in cs), "matrix; T", min(c["T"] for c in cs), max(c["T"] for c in cs),
              "pairs", B.GRIDS[sys.argv[2]]["pairs"], "skipped", getattr(B.configs_heldout, "skipped", []))
    elif cmd == "pilot":
        cs = B.configs(sys.argv[2]); i = int(sys.argv[3]); t0 = time.time(); rec = run_one(cs[i])
        print("pilot", i, "T", cs[i]["T"], f"{time.time() - t0:.1f}s")
    elif cmd == "run":
        cmd_run(sys.argv[2], sys.argv[3], int(sys.argv[4]) if len(sys.argv) > 4 else 8)
        print(os.environ.get("JOB_DONE_PREFIX", "done:"), "E5 B1' " + sys.argv[2] + " grid done", flush=True)
    elif cmd == "score":
        cmd_score(sys.argv[2], sys.argv[3])
