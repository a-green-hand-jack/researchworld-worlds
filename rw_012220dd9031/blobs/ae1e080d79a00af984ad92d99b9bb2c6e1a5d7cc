\title{Logistic Regression versus $k$-Nearest Neighbours on Iris}

\author{Anonymous Author(s)\\Affiliation\\Address\\\texttt{email}}

\begin{document}

\maketitle

\begin{abstract}
We compare multinomial logistic regression (LR) with $k$-nearest neighbours
($k$-NN, $k$ chosen by inner cross-validation) on the Iris data from OpenML
(dataset 61), using \Nreps{} repetitions of stratified \Nfolds-fold
cross-validation with the same splits for both methods. LR reaches a mean
accuracy of \LRmean\% (95\% interval \LRlo--\LRhi\%) and $k$-NN \KNNmean\%
(\KNNlo--\KNNhi\%). The paired difference LR$-k$-NN is \DIFFmean{}
percentage points (pp; 95\% interval \DIFFlo{} to \DIFFhi{} pp), so the data
show no detectable difference. Runs locally and as a CPU job on the KAUST
Ibex cluster (node \texttt{\IbexNode}) gave identical results.
\end{abstract}

\section{Setup}

\paragraph{Data.} Iris \citep{fisher1936}: \Nsamples{} flowers, four
continuous measurements, three species of equal size, downloaded by the
delivered code from OpenML \citep{vanschoren2014openml} (dataset 61, ARFF,
MD5 \texttt{\DataMD}, as listed by OpenML); the same file fed both runs.

\paragraph{Methods.} Both methods standardise the features inside a
pipeline fitted on the training part only. \emph{LR}: multinomial (softmax)
logistic regression, L2 penalty with $C=1$, lbfgs (\LRconvWarnings{}
convergence warnings). \emph{$k$-NN}: Euclidean distance, uniform weights;
$k$ in \Kgrid{} is chosen on each outer training set by a seeded (\texttt{code/cv.py}) stratified
\Ninner-fold inner cross-validation (highest mean accuracy, ties to the
smallest $k$) and the model is then refitted on the whole outer training set.

\paragraph{Protocol and intervals.} \Nreps{} repetitions of stratified
\Nfolds-fold cross-validation (seed \Seed) give $J=\Nouter$ outer folds of
$n_{\mathrm{train}}=\Ntrain$ and $n_{\mathrm{test}}=\Ntest$ flowers. Both
methods are scored on the same folds, so their accuracies are paired; we
report each method's mean over the $J$ folds and the mean of the per-fold
differences $d_j=\mathrm{acc}^{\mathrm{LR}}_j-\mathrm{acc}^{k\mathrm{NN}}_j$.
Folds share training data, so a naive $t$ interval that treats them as
independent is too narrow \citep{dietterich1998approximate}. Our 95\%
intervals use the \IntervalMethod{} interval
\citep{nadeau2003inference,bouckaert2004evaluating},
$\bar{x}\pm t_{J-1,0.975}\sqrt{(1/J+n_{\mathrm{test}}/n_{\mathrm{train}})\,s^2}$;
the naive interval is shown only for contrast.

\paragraph{Local and Ibex runs.} The complete cross-validation was run twice
with the same code, data, seed, numpy \NumpyVersion, SciPy \ScipyVersion{},
scikit-learn \SklearnVersion{} \citep{pedregosa2011scikit} and one BLAS/OpenMP thread: locally (\LocalCPU)
and as CPU-only SLURM job \IbexJob{} on Ibex, node \texttt{\IbexNode}
(\IbexCPU; Python \PythonVersion). We compare the per-fold results and every
test prediction byte for byte.

