"""Download the Iris dataset (OpenML data id 61) from OpenML and verify its checksum."""
import hashlib
import json
import pathlib
import urllib.request

DATA_ID = 61
HERE = pathlib.Path(__file__).resolve().parent
OUT = HERE / "data"


def get(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read()


def main():
    OUT.mkdir(exist_ok=True)
    meta = json.loads(get(f"https://www.openml.org/api/v1/json/data/{DATA_ID}"))["data_set_description"]
    arff = get(meta["url"])
    md5 = hashlib.md5(arff).hexdigest()
    if md5 != meta["md5_checksum"]:
        raise SystemExit(f"checksum mismatch: {md5} != {meta['md5_checksum']}")
    (OUT / "iris.arff").write_bytes(arff)
    keep = ["id", "name", "version", "file_id", "url", "md5_checksum", "default_target_attribute",
            "upload_date", "licence", "status"]
    (OUT / "openml_61_meta.json").write_text(json.dumps({k: meta.get(k) for k in keep}, indent=2) + "\n")
    print(f"saved iris.arff ({len(arff)} bytes, md5 {md5}) from {meta['url']}")


if __name__ == "__main__":
    main()
