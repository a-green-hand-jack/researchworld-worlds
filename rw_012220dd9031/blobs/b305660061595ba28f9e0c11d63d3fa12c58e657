#!/bin/bash
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --output=ibex_%j.log
# Full 10 x 5-fold CV as a CPU job on KAUST Ibex. Submitted from report/code/ with
#   sbatch --job-name "<tag>-iris-cv" ibex_job.sbatch
# ENV points to a venv made from Ibex's python/3.11.0 module with numpy==2.1.3,
# scipy==1.14.1, scikit-learn==1.5.2 installed (see README.md). PYTHONPATH from the
# module is removed so only the pinned packages are imported.
set -euo pipefail
module load python/3.11.0 >/dev/null 2>&1
unset PYTHONPATH
echo "node: ${SLURMD_NODENAME:-?} job: ${SLURM_JOB_ID:-?} host: $(hostname)"
"${ENV}/bin/python" -u cv.py ../results/ibex
