% Stand-in for the official ICLR 2025 style (not supplied): same page geometry
% (US letter, 5.5in x 9in text block, 10pt Times, 1.5in side margins).
\ProvidesPackage{iclr2025_conference}
\RequirePackage[numbers,sort&compress]{natbib}
\setlength{\textwidth}{5.5in}\setlength{\textheight}{9in}
\setlength{\oddsidemargin}{0.5in}\setlength{\evensidemargin}{0.5in}
\setlength{\topmargin}{-0.5in}\setlength{\headheight}{12pt}\setlength{\headsep}{25pt}
\setlength{\parindent}{0pt}\setlength{\parskip}{5.5pt}\makeatletter
\renewcommand\@maketitle{\vbox{\hsize\textwidth\linewidth\hsize\vskip 0.1in
 \centering{\LARGE\bfseries \@title\par}\vskip 0.25in
 {\large\bfseries \@author\par}\vskip 0.2in}}
\renewcommand{\abstractname}{Abstract}
\renewenvironment{abstract}{\vskip .075in\centerline{\large\bfseries Abstract}\vskip .5ex\begin{quote}}{\end{quote}\vskip 1ex}
\renewcommand\section{\@startsection{section}{1}{\z@}{-1.5ex plus -0.5ex minus -.2ex}{1ex plus .2ex}{\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-1.2ex plus -0.5ex minus -.2ex}{0.8ex plus .2ex}{\normalsize\bfseries}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}{1ex}{-1em}{\normalsize\bfseries}}
\newcommand{\iclrfinalcopy}{}
