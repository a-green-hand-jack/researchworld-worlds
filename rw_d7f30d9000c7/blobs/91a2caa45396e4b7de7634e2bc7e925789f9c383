"""Deterministic OLS fits and coefficient-contrast intervals from preserved NOAA CSV."""
from pathlib import Path
import hashlib, json, platform, time
import numpy as np
import pandas as pd
import scipy
from scipy.stats import t
start=time.perf_counter()
root=Path(__file__).resolve().parents[1]
p=root/'data/co2_annmean_mlo.csv'
prov=json.loads((root/'data/provenance.json').read_text())
assert hashlib.sha256(p.read_bytes()).hexdigest()==prov['sha256']
d=pd.read_csv(p,comment='#'); d=d.loc[d.year>=1960].copy()
assert d.year.is_unique and np.all(np.diff(d.year)==1) and np.isfinite(d['mean']).all()
y=d['mean'].to_numpy(); years=d.year.to_numpy(); center=float(years.mean()); x=years-center
n=len(y)
def fit(degree):
    X=np.vander(x,degree+1,increasing=True)
    beta=np.linalg.lstsq(X,y,rcond=None)[0]; residual=y-X@beta
    sse=float(residual@residual); df=n-X.shape[1]; bread=np.linalg.inv(X.T@X)
    cov=sse/df*bread
    # Independent polynomial implementation validates coefficients and predictions.
    alt=np.polynomial.Polynomial.fit(years,y,degree).convert()
    np.testing.assert_allclose(alt(years),X@beta,rtol=0,atol=1e-8)
    return X,beta,residual,cov,{'coefficients':beta.tolist(),'covariance_ols':cov.tolist(),
        'se_ols':np.sqrt(np.diag(cov)).tolist(),'df':df,'sse':sse,
        'rmse':float(np.sqrt(sse/n)),'residual_sd':float(np.sqrt(sse/df)),
        'r_squared':float(1-sse/np.sum((y-y.mean())**2)),
        'residual_lag1_correlation':float(np.corrcoef(residual[:-1],residual[1:])[0,1]),
        'durbin_watson':float(np.sum(np.diff(residual)**2)/sse)}
L,bl,rl,vl,lin=fit(1); Q,bq,rq,vq,quad=fit(2)
lin.update(intercept_ppm=float(bl[0]),slope_ppm_per_yr=float(bl[1]),slope_se=float(np.sqrt(vl[1,1])))
quad.update(a0_ppm=float(bq[0]),a1_ppm_per_yr=float(bq[1]),a2_ppm_per_yr2=float(bq[2]),cov_3x3=vq.tolist())
# Newey-West/Bartlett covariance, finite-sample n/(n-k) correction.
bread=np.linalg.inv(Q.T@Q); scores=Q*rq[:,None]
hac={}
for lag in (1,3,5,10):
    meat=scores.T@scores
    for j in range(1,lag+1):
        cross=scores[j:].T@scores[:-j]
        meat+=(1-j/(lag+1))*(cross+cross.T)
    hac[lag]=bread@meat@bread*n/(n-3)
quad['covariance_hac']={str(l):v.tolist() for l,v in hac.items()}
windows=[]
for label,a,b in [('1960s',1960,1969),('2016–2025',int(years[-1]-9),int(years[-1]))]:
    mid=(a+b)/2; contrast=np.array([0,1,2*(mid-center)]); rate=float(contrast@bq)
    def ci(cov):
        h=float(t.ppf(.975,n-3)*np.sqrt(contrast@cov@contrast))
        return [rate-h,rate+h]
    # Secant of the quadratic over window endpoints equals mean derivative.
    qa=np.array([1,a-center,(a-center)**2])@bq; qb=np.array([1,b-center,(b-center)**2])@bq
    np.testing.assert_allclose((qb-qa)/(b-a),rate,atol=1e-12)
    windows.append({'label':label,'years':[a,b],'midpoint_year':mid,'contrast':contrast.tolist(),
        'rate_ppm_per_yr':rate,'se_ols':float(np.sqrt(contrast@vq@contrast)),
        'ci95_ppm_per_yr':ci(vq),'ci95_hac_sensitivity':{str(l):ci(v) for l,v in hac.items()}})
out={'schema':'figtab-fits-handoff-1','input':str(p.relative_to(root)), 'input_sha256':prov['sha256'],
    'provenance':prov,'last_year':int(years[-1]),'n':n,'fit_years':[int(years[0]),int(years[-1])],
    'center_year':center,'predictor':'x = year - center_year','linear':lin,'quadratic':quad,
    'growth_definition':'Average quadratic derivative over each window, equivalently derivative at midpoint or endpoint fitted difference divided by 9 years.',
    'interval_method':'OLS residual-variance covariance; contrast includes coefficient covariance; two-sided Student t with n-3 df. Conditional on quadratic trend and independent homoskedastic errors.',
    'hac_method':'Newey-West Bartlett, lags 1,3,5,10, n/(n-3) correction, same t critical value; sensitivity only.',
    'growth_windows':windows,'versions':{'python':platform.python_version(),'numpy':np.__version__,'pandas':pd.__version__,'scipy':scipy.__version__}}
(root/'analysis/results.json').write_text(json.dumps(out,indent=2)+'\n')
d['linear_fit_ppm']=L@bl; d['quadratic_fit_ppm']=Q@bq; d['linear_residual_ppm']=rl; d['quadratic_residual_ppm']=rq
d.to_csv(root/'analysis/annual_fits.csv',index=False)
print(json.dumps({'n':n,'linear':lin,'quadratic':quad,'windows':windows,'elapsed_seconds':time.perf_counter()-start},indent=2))
