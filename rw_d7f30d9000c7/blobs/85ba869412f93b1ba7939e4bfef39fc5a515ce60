"""Download logic used in the original interactive fetch; refuse overwriting snapshot."""
import urllib.request, datetime, hashlib, json, pathlib
url = 'https://gml.noaa.gov/webdata/ccgg/trends/co2/co2_annmean_mlo.csv'
p = pathlib.Path('data/co2_annmean_mlo.csv')
if p.exists():
    raise SystemExit('Snapshot exists; use a fresh directory to fetch a new revision.')
p.parent.mkdir(parents=True, exist_ok=True)
b = urllib.request.urlopen(url).read()
p.write_bytes(b)
meta = {'url': url, 'fetched_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'sha256': hashlib.sha256(b).hexdigest(), 'bytes': len(b)}
pathlib.Path('data/provenance.json').write_text(json.dumps(meta, indent=2)+'\n')
