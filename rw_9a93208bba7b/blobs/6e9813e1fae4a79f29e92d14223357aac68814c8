"""Summary of the B3 post hoc precision check (not registered; reads e5_b3_precision.py output).
Question: are the held-out "round-off regrowth" indices (amendment 1's exact check, 80 in noisy runs, 20 in population
runs, all at p0 = 1.5) and the p0 = 1.5 rank results float64 round-off, or the exact dynamics?
Reads: OUTDIR/precision_{grid}_runs.jsonl.gz and the delivered results/e5/b3_{grid}/b3_{grid}_runs.jsonl.gz.
Usage: python3 code/checks/e5_b3_precision_summary.py GRID OUTDIR"""
import sys, os, json, gzip, collections
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import numpy as np
import e5_b3 as b3

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")


def load(p):
    return [json.loads(l) for l in gzip.open(p, "rt")]


if __name__ == "__main__":
    grid, out = sys.argv[1], sys.argv[2]
    rows = load(os.path.join(out, f"precision_{grid}_runs.jsonl.gz"))
    dl = {r["cfg"]["id"]: r for r in load(os.path.join(ROOT, "results", "e5", f"b3_{grid}", f"b3_{grid}_runs.jsonl.gz"))}
    by = collections.defaultdict(dict)
    for r in rows:
        by[r["cfg"]["id"]][r["prec"]] = r
    ok = lambda r: r is not None and r["truth"].get("counts") is not None
    precs = ["f32", "f64", "f80"]
    s = dict(question=__doc__.split("\n")[1:3], inputs=[f"precision_{grid}_runs.jsonl.gz", f"b3_{grid}_runs.jsonl.gz"])
    # 1. the f64 rerun reproduces the delivered held-out runs (same code path up to the Jacobi readout)
    eq = [(by[i]["f64"]["truth"]["counts"] == dl[i]["truth"]["counts"]) for i in by if ok(by[i].get("f64")) and ok(dl.get(i))]
    s["f64_rerun_vs_delivered"] = dict(runs=len(eq), count_trajectory_identical=int(sum(eq)),
                                       diverged={p: sorted(i for i in by if not ok(by[i].get(p))) for p in precs})
    # 2. per cell: regrowth indices, final rank, deepest relative singular value, per precision
    cells = {}
    for p0 in b3.GRIDS[grid]["p0"]:
        for kind in ("noisy", "pop"):
            c = {}
            for p in precs:
                rr = [r[p] for r in by.values() if ok(r.get(p)) and r[p]["cfg"]["p0"] == p0
                      and (r[p]["cfg"]["B"] > 0) == (kind == "noisy")]
                deep = [float(np.log10(max((np.array(r["truth"]["sv"]) / np.array(r["truth"]["sv"])[:, :1]).min(), 1e-300)))
                        for r in rr]
                c[p] = dict(runs=len(rr), roundoff_regrowth_indices=int(sum(b3.roundoff_regrowth(r) for r in rr)),
                            runs_with_regrowth=int(sum(b3.roundoff_regrowth(r) > 0 for r in rr)),
                            reescape_runs=int(sum(r["truth"]["reescape"] > 0 for r in rr)),
                            final_rank_mean=float(np.mean([r["truth"]["counts"][-1] for r in rr])),
                            deepest_log10_sv_rel_top_median=float(np.median(deep)))
            cells[f"p0{p0}_{kind}"] = c
    s["cells"] = cells
    # 3. trajectory agreement between precisions (count of singular values above THR at each of the NCHK checks)
    agree = {}
    for a, b in (("f64", "f80"), ("f32", "f80")):
        for p0 in b3.GRIDS[grid]["p0"]:
            ids = [i for i in by if ok(by[i].get(a)) and ok(by[i].get(b)) and by[i][a]["cfg"]["p0"] == p0]
            nd = [int(np.sum(np.array(by[i][a]["truth"]["counts"]) != np.array(by[i][b]["truth"]["counts"]))) for i in ids]
            fin = [by[i][a]["truth"]["counts"][-1] != by[i][b]["truth"]["counts"][-1] for i in ids]
            agree[f"{a}_vs_{b}_p0{p0}"] = dict(runs=len(ids), identical_trajectory=int(sum(x == 0 for x in nd)),
                                                final_rank_differs=int(sum(fin)), checks_differing=dict(collections.Counter(nd)))
    s["agreement"] = agree
    # 4. S4 statistic (mean noisy final rank minus its population run's), per precision, on runs defined in all three
    s4 = {}
    for p in precs:
        d = {}
        for p0 in b3.GRIDS[grid]["p0"]:
            v = []
            for i, r in by.items():
                c = r[precs[1]]["cfg"]
                if c["p0"] != p0 or c["B"] == 0 or not all(ok(r.get(q)) for q in precs):
                    continue
                pop = next(by[j][p] for j in by if by[j][p]["cfg"]["B"] == 0 and all(
                    by[j][p]["cfg"][k] == c[k] for k in ("lam", "p0", "eta", "seed")))
                v.append(r[p]["truth"]["counts"][-1] - pop["truth"]["counts"][-1])
            d[f"p0{p0}"] = float(np.mean(v))
        s4[p] = d
    s["S4_delta_by_precision"] = s4
    # 5. when the regrowing indices first sit at <= ROUND x top (check index, of NCHK)
    fc = collections.Counter()
    for r in by.values():
        if ok(r.get("f64")) and b3.roundoff_regrowth(r["f64"]) > 0:
            S = np.array(r["f64"]["truth"]["sv"]); ro = (S <= b3.ROUND * S[:, :1]).any(1)
            fc[int(np.argmax(ro))] += 1
    s["f64_first_check_at_roundoff_in_regrowth_runs"] = dict(sorted(fc.items()))
    json.dump(s, open(os.path.join(out, f"precision_{grid}_summary.json"), "w"), indent=1)
    print(json.dumps(dict(agreement=agree, S4=s4, cells={k: {p: v[p]["roundoff_regrowth_indices"] for p in v}
                                                          for k, v in cells.items()}), indent=0))
