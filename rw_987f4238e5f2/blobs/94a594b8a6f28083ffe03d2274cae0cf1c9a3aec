"""One-page rendering check for the delivered report.

Renders report/report.md to PDF at the review geometry (A4, 11pt Arial,
line-height 1.25, 18 mm margins, figure width-constrained to the text width)
and reports the page count. The report references the figure at its assigned
delivered path under report/figures/, so the check runs against an assembled
delivery directory, not the bare repository:

    ht-role delivery --into /tmp/opencode/render-check
    python3 code/render_report_check.py /tmp/opencode/render-check/report

Requires: markdown, weasyprint, pypdf, and pango/glib/fontconfig on the
library path (e.g. LD_LIBRARY_PATH=/hutian/.mamba/envs/render/lib).
Writes data-release/report-render-check.json and /tmp/report-render.pdf.
Fails if the figure is missing or does not appear in the rendered PDF.
"""

import datetime
import hashlib
import json
import sys
from pathlib import Path

import markdown
from pypdf import PdfReader
from weasyprint import HTML

CSS = """
@page { size: A4; margin: 18mm; }
body { font-family: Arial, Helvetica, sans-serif; font-size: 11pt;
       line-height: 1.25; }
h1 { font-size: 14pt; margin: 0 0 3mm 0; }
p { margin: 0 0 2.2mm 0; }
pre { margin: 0 0 2.2mm 0; font-size: 9.5pt; }
table { border-collapse: collapse; margin: 0 0 2.2mm 0;
        font-size: 9.5pt; width: 100%; }
th, td { border: 0.3pt solid #999; padding: 0.5mm 2mm; }
img { max-width: 100%; height: auto; }
"""

# Variant stylesheets used only for robustness checks (page counts recorded):
CSS_TOUGHER = CSS.replace("h1 { font-size: 14pt; margin: 0 0 3mm 0; }",
                          "h1 { font-size: 16pt; margin: 0 0 5mm 0; }") \
                  .replace("p { margin: 0 0 2.2mm 0; }",
                           "p { margin: 0 0 3mm 0; }") \
                  .replace("th, td { border: 0.3pt solid #999; padding: 0.5mm 2mm; }",
                           "th, td { border: 0.3pt solid #999; padding: 0.8mm 2mm; }") \
                  .replace("font-size: 9.5pt; width: 100%; }",
                           "font-size: 10pt; width: 100%; }")
CSS_FULLWIDTH = CSS.replace("img { max-width: 100%; height: auto; }",
                            "img { width: 100% !important; max-width: 100%; height: auto; }")

GEOMETRY = {
    "page": "A4 (210 x 297 mm)",
    "margins": "18 mm",
    "font": "Arial 11 pt (Helvetica fallback in the container)",
    "line_height": "1.25",
    "figure": "honors the width attribute in report.md; max-width 100% (174 mm text width)",
}


def main(report_dir: str) -> int:
    base = Path(report_dir)
    src = (base / "report.md").read_text(encoding="utf-8")
    fig = base / "figures" / "lightcurve_fit.png"
    if not fig.is_file() or fig.stat().st_size == 0:
        print(f"FAIL: figure missing at {fig}", file=sys.stderr)
        return 2

    body = markdown.markdown(src, extensions=["tables"])
    html = (
        "<html><head><meta charset='utf-8'><style>" + CSS + "</style></head>"
        "<body>" + body + "</body></html>"
    )
    doc = HTML(string=html, base_url=str(base) + "/").render()
    pages = len(doc.pages)
    doc.write_pdf("/tmp/report-render.pdf")

    body_html = markdown.markdown(src, extensions=["tables"])
    variants = {}
    for name, css in (("tougher-default-spacing", CSS_TOUGHER),
                      ("figure-forced-to-full-text-width", CSS_FULLWIDTH)):
        vhtml = ("<html><head><meta charset='utf-8'><style>" + css +
                 "</style></head><body>" + body_html + "</body></html>")
        vdoc = HTML(string=vhtml, base_url=str(base) + "/").render()
        variants[name] = len(vdoc.pages)

    reader = PdfReader("/tmp/report-render.pdf")
    n_images = sum(len(p.images) for p in reader.pages)
    if n_images == 0:
        print("FAIL: no image rendered into the PDF", file=sys.stderr)
        return 2

    record = {
        "checked_at_utc": datetime.datetime.now(datetime.timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%SZ"
        ),
        "report": "report/report.md",
        "report_sha256": hashlib.sha256(src.encode()).hexdigest(),
        "rendered_from": str(base),
        "geometry": GEOMETRY,
        "pages": pages,
        "figures_rendered": n_images,
        "robustness_variants_pages": variants,
        "one_page": pages == 1 and n_images >= 1 and all(v == 1 for v in variants.values()),
        "renderer": "weasyprint 70.0 (markdown 3.11.1, pypdf, pango via micromamba)",
        "pdf": "/tmp/report-render.pdf",
    }
    with open("data-release/report-render-check.json", "w") as fh:
        json.dump(record, fh, indent=2)
        fh.write("\n")
    print(json.dumps(record, indent=2))
    return 0 if record["one_page"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "report"))
