% Stand-in for the official icml2025.sty (not supplied, not installed): two-column ICML-like geometry.
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{icml2025}
\DeclareOption{accepted}{}\DeclareOption{preprint}{}\ProcessOptions\relax
\RequirePackage{times}\RequirePackage[round]{natbib}\RequirePackage{xcolor}\RequirePackage{fancyhdr}
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in]{geometry}
\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}
\renewcommand\normalsize{\@setfontsize\normalsize{10}{11}}\normalsize
\def\icmltitlerunning#1{\gdef\@icmlrun{#1}}
\def\icmltitle#1{\vskip 0.1in\begin{center}{\LARGE\bf #1\par}\end{center}}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\def\icmlauthor#1#2{#1}\def\icmlaffiliation#1#2{}\def\icmlcorrespondingauthor#1#2{}\def\icmlkeywords#1{}
\renewcommand\section{\@startsection{section}{1}{\z@}{-0.18in}{0.1in}{\large\bf}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-0.12in}{0.06in}{\normalsize\bf}}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyhead[C]{\small\@icmlrun}\fancyfoot[C]{\thepage}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
