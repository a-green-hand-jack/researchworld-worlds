"""2D Ising model on an L x L periodic lattice (J = 1, no field), Metropolis with checkerboard updates.

Usage:
  python3 ising.py --L 32 --temps 2.0 2.2 2.4 --seeds 1 2 --sweeps 20000 --burn 2000 --out results/a.json
  python3 ising.py ... --series results/series-a   # also keep each run's per-sweep |m| and e as .npy

Every (T, seed) run starts from a random lattice, discards --burn sweeps and measures every sweep after.
It prints one line per finished run and writes the summary JSON at the end: per run the means of
|m|, m^2, m^4, e and e^2 (m and e per site), the susceptibility chi = L^2 (<m^2> - <|m|>^2) / T,
the heat capacity c = L^2 (<e^2> - <e>^2) / T^2 and the Binder cumulant U = 1 - <m^4> / (3 <m^2>^2).
Needs numpy only. The run time grows with L^2 x sweeps x temperatures x seeds.
"""
import argparse
import json
import time
from pathlib import Path

import numpy as np


def run(L, T, seed, sweeps, burn):
    rng = np.random.default_rng(seed)
    s = rng.choice(np.array([-1, 1], dtype=np.int8), size=(L, L)).astype(np.int32)
    parity = (np.add.outer(np.arange(L), np.arange(L)) % 2).astype(bool)
    masks = (parity, ~parity)
    beta = 1.0 / T
    accept = {d: np.exp(-beta * d) for d in (4, 8)}
    ms, es = np.empty(sweeps), np.empty(sweeps)
    n = L * L
    for sweep in range(burn + sweeps):
        for mask in masks:
            nb = np.roll(s, 1, 0) + np.roll(s, -1, 0) + np.roll(s, 1, 1) + np.roll(s, -1, 1)
            dE = 2 * s * nb
            p = np.where(dE <= 0, 1.0, np.where(dE == 4, accept[4], accept[8]))
            flip = mask & (rng.random((L, L)) < p)
            s[flip] *= -1
        if sweep >= burn:
            i = sweep - burn
            ms[i] = abs(s.sum()) / n
            es[i] = -(s * (np.roll(s, 1, 0) + np.roll(s, 1, 1))).sum() / n
    m2, m4 = (ms ** 2).mean(), (ms ** 4).mean()
    summary = {
        'L': L, 'T': T, 'seed': seed, 'sweeps': sweeps, 'burn': burn,
        'abs_m': ms.mean(), 'm2': m2, 'm4': m4, 'e': es.mean(), 'e2': (es ** 2).mean(),
        'chi': n * (m2 - ms.mean() ** 2) / T, 'c': n * ((es ** 2).mean() - es.mean() ** 2) / T ** 2,
        'binder': 1 - m4 / (3 * m2 ** 2),
    }
    return {k: float(v) if isinstance(v, np.floating) else v for k, v in summary.items()}, ms, es


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--L', type=int, required=True)
    parser.add_argument('--temps', type=float, nargs='+', required=True)
    parser.add_argument('--seeds', type=int, nargs='+', default=[1])
    parser.add_argument('--sweeps', type=int, default=20000)
    parser.add_argument('--burn', type=int, default=2000)
    parser.add_argument('--out', required=True)
    parser.add_argument('--series', help='directory for each run\'s per-sweep |m| and e (.npy)')
    args = parser.parse_args()
    results, start = [], time.time()
    for T in args.temps:
        for seed in args.seeds:
            summary, ms, es = run(args.L, T, seed, args.sweeps, args.burn)
            results.append(summary)
            if args.series:
                folder = Path(args.series)
                folder.mkdir(parents=True, exist_ok=True)
                np.save(folder / f'L{args.L}-T{T:.4f}-s{seed}-m.npy', ms)
                np.save(folder / f'L{args.L}-T{T:.4f}-s{seed}-e.npy', es)
            print(f'L={args.L} T={T:.4f} seed={seed} |m|={summary["abs_m"]:.4f} '
                  f'U={summary["binder"]:.4f} chi={summary["chi"]:.3f} ({time.time() - start:.0f} s)', flush=True)
    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
    Path(args.out).write_text(json.dumps(results, indent=1))


if __name__ == '__main__':
    main()
