#!/usr/bin/env bash
# Stage 1 (pilot): L=64, T=1.5..3.5 step 0.1, seeds 1 and 2, 20000 measured sweeps after 2000 burn-in.
# The two seeds run as two concurrent processes (the job has 2 CPUs); their JSONs are merged by
# stage1_analysis.py. Run from the repository root.
set -euo pipefail
TEMPS=$(python3 -c "print(' '.join(f'{1.5 + 0.1*i:.1f}' for i in range(21)))")
mkdir -p data/stage1/raw
for s in 1 2; do
  python3 -u code/ising.py --L 64 --temps $TEMPS --seeds $s --sweeps 20000 --burn 2000 \
    --out data/stage1/raw/L64-s$s.json > data/stage1/raw/L64-s$s.log 2>&1 &
done
wait
python3 -u code/stage1_analysis.py
echo "HUTIAN_WAKE: stage 1 finished"
