"""Figure 1 (pilot chi, c vs T) and Figure 2 (Binder cumulants) from experiment-repo data.
Usage: python3 make_figures.py PATH_TO_EXPERIMENT_REPO_CHECKOUT"""
import sys, json, numpy as np, pandas as pd
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt
R = sys.argv[1] if len(sys.argv) > 1 else "/hutian/exp"
OUT = __file__.rsplit("/", 1)[0] if "/" in __file__ else "."
TC = 2 / np.log(1 + np.sqrt(2))
plt.rcParams.update({"font.size": 9, "axes.spines.top": False, "axes.spines.right": False})

# ---- Figure 1
t = pd.read_csv(f"{R}/data/stage1/table.csv")
pk = json.load(open(f"{R}/data/stage1/peak.json"))["chi_peak"]["mean"]["parabola3_T"]
fig, ax = plt.subplots(2, 1, sharex=True, figsize=(5.6, 5.4))
for a, q, lab in zip(ax, ["chi", "c"], [r"susceptibility $\chi$", r"heat capacity $c$ (per site)"]):
    a.axvspan(2.19, 2.43, color="0.9", label="stage-2 window")
    a.errorbar(t["T"], t[q + "_mean"], t[q + "_halfdiff"], fmt="-", color="0.3", lw=1, label="mean of 2 seeds (± half-difference)")
    a.plot(t["T"], t[q + "_s1"], "o", mfc="none", color="C0", ms=5, label="seed 1")
    a.plot(t["T"], t[q + "_s2"], "x", color="C1", ms=5, label="seed 2")
    a.axvline(TC, color="C3", ls="--", lw=1, label=r"exact $T_c$ = 2.2692")
    a.axvline(pk, color="C2", ls=":", lw=1.3, label=f"$\\chi$ peak (parabola) = {pk:.3f}")
    a.set_ylabel(lab)
ax[0].set_yscale("log"); ax[1].set_xlabel("T  (J = k_B = 1)")
ax[0].legend(fontsize=7, loc="upper right", frameon=False)
ax[0].set_title("Pilot, L = 64: both peak at T = 2.30 (grid), just above $T_c$", fontsize=9)
fig.tight_layout(); fig.savefig(f"{OUT}/fig1_pilot_chi_c.png", dpi=200); fig.savefig(f"{OUT}/fig1_pilot_chi_c.pdf")

# ---- Figure 2
cr = json.load(open(f"{R}/data/stage2/crossing.json"))
Tx, Ux = cr["estimate"]["fss_Tc"], cr["estimate"]["fss_Ustar"]
_ci = cr["ci95_seed_bootstrap"]["fss_Tc"]; lo, hi = _ci["lo"], _ci["hi"]
a_ = cr["fss_primary_params"]["a"]
s2 = pd.read_csv(f"{R}/data/stage2/points.csv")
s3 = pd.read_csv(f"{R}/data/stage3/points.csv")
cmp_ = json.load(open(f"{R}/data/stage3_long/compare.json"))
fig, axs = plt.subplots(1, 2, figsize=(10.5, 4.6), gridspec_kw={"width_ratios": [1.3, 1]})
cols = {32: "C0", 64: "C1", 128: "C2"}
for a, zoom in zip(axs, [True, False]):
    a.axvspan(lo, hi, color="C3", alpha=0.15, label=f"stage-2 $T_c$ 95% CI [{lo:.4f}, {hi:.4f}]")
    a.axvline(TC, color="C3", ls="--", lw=1, label=r"exact $T_c$ = 2.2692")
    a.axvline(Tx, color="0.3", ls=":", lw=1, label=f"stage-2 $T_c$ = {Tx:.4f}")
    for L, g in s2.groupby("L"):
        a.errorbar(g["T"], g.U_pooled, g.U_err_block_boot, fmt="o-", ms=4, lw=0.8, capsize=2, color=cols[L], label=f"L = {L}")
        if zoom:
            T = np.linspace(2.22, 2.31, 100); x = (T - Tx) * L
            a.plot(T, sum(c * x**k for k, c in enumerate(a_)), color=cols[L], lw=0.6, alpha=0.5)
    a.errorbar(s3["T"], s3.U_pooled, s3.U_err_boot, fmt="s", mfc="none", color="C4", capsize=2, ms=6,
               label=r"L = 256, 10$^4$ sweeps, not equilibrated (errors underestimated)")
    a.errorbar(cmp_["temps"], cmp_["U256"], cmp_["U256_err"], fmt="D", color="C4", capsize=2, ms=5,
               label=r"L = 256, 5$\times$10$^4$+5$\times$10$^4$ sweeps (equilibrated)")
    a.set_xlabel("T  (J = k_B = 1)"); a.set_ylabel(r"Binder cumulant $U = 1-\langle m^4\rangle/3\langle m^2\rangle^2$")
    if zoom: a.set_xlim(2.19, 2.34); a.set_ylim(0.0, 0.70); a.set_title("Zoom on the crossing (thin lines: stage-2 scaling fit)", fontsize=9)
    else: a.set_xlim(2.19, 2.43); a.set_ylim(-0.02, 0.70); a.set_title("Full stage-2 window", fontsize=9)
axs[0].legend(fontsize=6.5, loc="lower left", frameon=False)
fig.tight_layout(); fig.savefig(f"{OUT}/fig2_binder.png", dpi=200); fig.savefig(f"{OUT}/fig2_binder.pdf")
