#!/bin/sh
# Stage 1 (pilot): L = 64, T = 1.5 ... 3.5 step 0.1, seeds 1 2, 20,000 measured sweeps after 2,000 burn-in.
set -e
cd "$(dirname "$0")/.."
TEMPS=$(python3 -c "print(' '.join(f'{1.5 + 0.1 * i:.1f}' for i in range(21)))")
python3 -u code/run_points.py --L 64 --temps $TEMPS --seeds 1 2 --sweeps 20000 --burn 2000 --out data/stage1 --jobs 2
echo "HUTIAN_WAKE: stage 1 finished"
