"""Robustness check of the crossing estimator: the stage-2 estimator interpolates U between grid points 0.03 apart
with a cubic; here the same data are instead reweighted (single histogram, code/extra_long256_analysis.py) to a
0.0005 grid, so the crossings need no assumed curve shape.

Applied to the stage-2 runs (L = 32, 64, 128, 20,000 sweeps, seeds 1-3; blocks of 2,000 sweeps) and to the long
runs (100,000 sweeps, seeds 11-13; blocks of 10,000). Combined T_c = mean of the three pairwise crossings, as in
stage 2; 95 % intervals from the block bootstrap and from resampling whole seeds.
Output: results/reweighted_crossings.json
"""
import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent))
import extra_long256_analysis as rw  # noqa: E402

PAIRS = ((32, 64), (32, 128), (64, 128))
B = 1000
rng = np.random.default_rng(32128)


def run(label, folder, block):
    rw.RUNS = {L: (folder, f'summary-L{L}.json') for L in (32, 64, 128)}
    rw.BLOCK = block
    st = {L: rw.block_stats(L) for L in rw.RUNS}
    U = {L: rw.curve(st[L]['S']) for L in rw.RUNS}

    def est(Us):
        c = {f'{a}/{b}': rw.crossing(Us[a], Us[b], rw.TC_EXACT) for a, b in PAIRS}
        return c, float(np.mean([v[0] for v in c.values()])), float(np.mean([v[1] for v in c.values()]))

    pairs, tc, uc = est(U)
    bb, bs = [], []
    for _ in range(B):
        bb.append(est({L: rw.curve(st[L]['S'], rng.integers(0, st[L]['S'].shape[3], st[L]['S'].shape[2:]))
                       for L in rw.RUNS})[1])
        bs.append(est({L: rw.curve(st[L]['S'][:, :, rng.integers(0, st[L]['S'].shape[2], st[L]['S'].shape[2])])
                       for L in rw.RUNS})[1])
    bb, bs = np.array(bb), np.array(bs)
    rc = {L: {k: v for k, v in zip(('points', 'max_abs_diff'),
                                   (int(np.isfinite(st[L]['U_alt'] - U[L]).sum()),
                                    float(np.nanmax(np.abs(st[L]['U_alt'] - U[L])))))} for L in rw.RUNS}
    return {'data': folder, 'block_sweeps': block, 'seeds': st[32]['seeds'], 'temps': st[32]['temps'],
            'sweeps': st[32]['n'],
            'pairwise': {k: {'T': v[0], 'U': v[1]} for k, v in pairs.items()}, 'Tc': tc, 'U_at_crossing': uc,
            'ci95_block_bootstrap': np.nanpercentile(bb, [2.5, 97.5]).tolist(), 'failed_block_draws': int(np.isnan(bb).sum()),
            'ci95_seed_bootstrap': np.nanpercentile(bs, [2.5, 97.5]).tolist(), 'failed_seed_draws': int(np.isnan(bs).sum()),
            'reweighting_consistency': rc}


def main():
    res = {'method': rw.__doc__.split('\n')[0], 'kish_min': rw.KISH_MIN, 'tc_exact': rw.TC_EXACT,
           'stage2': run('stage2', 'data/stage2', 2000), 'long': run('long', 'data/extra_long', 10000)}
    s2 = json.loads((rw.ROOT / 'results/stage2_crossing.json').read_text())
    el = json.loads((rw.ROOT / 'results/extra_long_check.json').read_text())
    res['grid_cubic_estimates'] = {'stage2': {'Tc': s2['Tc'], 'ci95': s2['bootstrap_seeds']['ci95']},
                                   'long': {'Tc': el['Tc_long'], 'ci95': el['bootstrap_seeds_ci95']}}
    res['inputs'] = ['data/stage2/summary-L*.json', 'data/stage2/series/*.npz', 'data/extra_long/summary-L*.json',
                     'data/extra_long/series/*.npz', 'results/stage2_crossing.json', 'results/extra_long_check.json']
    (rw.ROOT / 'results/reweighted_crossings.json').write_text(json.dumps(res, indent=1))
    print(json.dumps(res, indent=1))


if __name__ == '__main__':
    main()
