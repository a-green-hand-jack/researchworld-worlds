"""Writes numbers.tex (LaTeX macros for every number in the text of report.tex).

Reads only experiment-repo's result files under report/results/:
  results/local/summary.json   means, corrected resampled-t intervals, ties, chosen k, settings
  results/reproducibility.json Ibex job id, node, local-vs-Ibex identity, versions
  results/provenance.json      OpenML download and checksum
  results/robustness.json      sensitivity variants
Run from report/:  python3 make_numbers.py
"""
import json
from pathlib import Path

here = Path(__file__).parent
res = here / "results"
S = json.loads((res / "local" / "summary.json").read_text())
R = json.loads((res / "reproducibility.json").read_text())
P = json.loads((res / "provenance.json").read_text())
B = json.loads((res / "robustness.json").read_text())


def pct(x, sign=False):
    return ("{:+.1f}" if sign else "{:.1f}").format(100 * x).replace("-", "$-$")


m = {}
for tag, key, sign in [("LR", "logistic_regression", False), ("KNN", "knn", False),
                       ("D", "difference_lr_minus_knn", True)]:
    m[tag + "mean"] = pct(S[key]["mean"], sign)
    m[tag + "lo"] = pct(S[key]["corrected"]["lo"], sign)
    m[tag + "hi"] = pct(S[key]["corrected"]["hi"], sign)
d = S["difference_lr_minus_knn"]
m["Dp"] = "{:.2f}".format(d["corrected"]["p_two_sided_vs_0"])
m["Dnaivelo"] = pct(d["naive"]["lo"], True)
m["Dnaivehi"] = pct(d["naive"]["hi"], True)

grid = S["protocol"]["k_grid"]
step = grid[1] - grid[0]
assert grid == list(range(grid[0], grid[-1] + 1, step))
m["Kgrid"] = r"\{%d, %d, \dots, %d\}" % (grid[0], grid[1], grid[-1])
kc = {int(k): v for k, v in S["k_selected_counts"].items()}
m["Kmin"], m["Kmax"] = str(min(kc)), str(max(kc))
m["Kmedian"] = "{:g}".format(S["k_selected_median"])
m["Kmode"] = str(max(kc, key=kc.get))
m["Kmodecount"] = str(kc[max(kc, key=kc.get)])
m["Kedge"] = str(S["k_selected_at_grid_edge"])
m["FoldsLR"] = str(S["folds_lr_better"])
m["FoldsKNN"] = str(S["folds_knn_better"])
m["FoldsTied"] = str(S["folds_tied"])
m["OuterSeed"] = str(S["protocol"]["outer_seed"])
m["MaxIter"] = "10000" if "max_iter=10000" in S["protocol"]["lr"] else None
m["ConvWarn"] = str(S["convergence_warnings"])
assert S["lr_multinomial_verified"] is True

m["IbexNode"] = R["ibex_node"]
m["IbexJob"] = R["ibex_job_id"]
m["IbexPartition"] = R["ibex_partition"]
assert R["ibex_node"] == R["ibex_node_from_job_log"]
m["Identical"] = "identical" if R["identical"] else "not identical"
ident_all = all(R[k] for k in ["folds_equal_elementwise", "predictions_equal_elementwise",
                               "summary_equal_as_floats"])
assert ident_all == R["identical"]
for side in ["local", "ibex"]:
    e = R["env"][side]
    m["CPU" + side.capitalize()] = e["cpu_model"].split()[0].replace("(R)", "")  # vendor
e = R["env"]["local"]
same = all(R["env"]["local"][k] == R["env"]["ibex"][k] for k in ["python", "numpy", "scipy", "scikit_learn"])
assert same
m["Versions"] = "Python %s, NumPy %s, SciPy %s, scikit-learn %s" % (
    e["python"], e["numpy"], e["scipy"], e["scikit_learn"])
m["NPred"] = str(S["pooled_correct"]["of"])

assert P["md5_matches_openml"] and P["openml_dataset_id"] == 61
m["DataMDfive"] = P["downloaded_md5"]
m["DataVersion"] = P["version"]

variants = [k for k in B if k != "main"]
covers0 = [B[k]["diff_corrected_lo"] <= 0 <= B[k]["diff_corrected_hi"] for k in variants]
m["NVariants"] = str(len(variants))
m["VariantsCoverZero"] = ("all %d" % len(variants)) if all(covers0) else "%d of %d" % (sum(covers0), len(variants))
dm = [B[k]["diff_mean"] for k in variants]
m["VariantDmin"], m["VariantDmax"] = pct(min(dm), True), pct(max(dm), True)

lines = ["% Generated by make_numbers.py from report/results/ -- do not edit by hand."]
for k, v in m.items():
    assert v is not None, k
    lines.append("\\newcommand{\\%s}{%s}" % (k, v))
(here / "numbers.tex").write_text("\n".join(lines) + "\n")
print("\n".join(lines))
