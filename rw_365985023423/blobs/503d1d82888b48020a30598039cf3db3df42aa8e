#!/usr/bin/env python3
"""Programmatic inspection of the figure rendering.

This model session cannot view images, so the figure is inspected through
its artists and pixels instead: axes, data values (checked against the
committed CSV/JSON), legend, annotation content and placement, overlaps,
PNG size and ink coverage. In --real mode the script performs the render
itself (through plot_mae_loglog.main, with savefig spied on), so the
delivered PNG is exactly the inspected one.

Usage:
  check_render.py --selftest
  check_render.py --real <experiment-repo checkout> [--outdir DIR]
"""
from __future__ import annotations

import hashlib
import json
import math
import subprocess
import sys
import tempfile
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

sys.path.insert(0, str(Path(__file__).parent / "report" / "figures"))
import plot_mae_loglog as P

OK = True


def check(name, cond, detail=""):
    global OK
    print(("PASS " if cond else "FAIL ") + name + (f"  [{detail}]" if detail else ""))
    OK = OK and bool(cond)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def captured_render(argv):
    figs = []
    orig = matplotlib.figure.Figure.savefig

    def spy(self, *a, **k):
        figs.append(self)
        return orig(self, *a, **k)

    matplotlib.figure.Figure.savefig = spy
    old_argv = sys.argv
    try:
        sys.argv = argv
        P.main()
    finally:
        sys.argv = old_argv
        matplotlib.figure.Figure.savefig = orig
    return figs[0]


def inspect_common(fig, png, expect):
    """expect: dict with keys slope, head (lo,hi), dep (lo,hi), in_both,
    mae[], se[] or None, theory[] or None, points_note."""
    ax = fig.axes[0]
    check("log-log axes", ax.get_xscale() == "log" and ax.get_yscale() == "log")
    check("xlabel set", ax.get_xlabel() != "", ax.get_xlabel())
    check("ylabel set", ax.get_ylabel() != "", ax.get_ylabel())
    check("title set", ax.get_title() != "")
    check("no SELF-TEST stamp", "SELF-TEST" not in ax.get_title())

    lines = ax.get_lines()
    data = [l for l in lines
            if len(l.get_xydata()) == 5 and l.get_marker() not in (None, "_", "None", "none")]
    check("one marker data line", len(data) == 1, f"{len(data)}")
    pts = data[0].get_xydata()
    check("N values as required", [int(x) for x in pts[:, 0]] == P.EXPECTED_N)
    check("MAE values exact", np.allclose(pts[:, 1], expect["mae"], rtol=0, atol=1e-15))
    if expect["se"] is not None:
        bounds = [l.get_xydata() for l in lines
                  if len(l.get_xydata()) == 5 and l.get_marker() == "_"]
        check("error bars present", len(bounds) == 2, f"{len(bounds)}")
        if len(bounds) == 2:
            b0 = np.sort([b[:, 1] for b in bounds], axis=0)
            check("error bars = mae +/- se",
                  np.allclose(b0[0], np.array(expect["mae"]) - np.array(expect["se"]),
                              rtol=0, atol=1e-15)
                  and np.allclose(b0[1], np.array(expect["mae"]) + np.array(expect["se"]),
                                  rtol=0, atol=1e-15))
        xl, yl = ax.get_xlim(), ax.get_ylim()
        check("error bars inside axes", all(
            xl[0] < x < xl[1] and yl[0] < y < yl[1]
            for b in bounds for x, y in b))

    full = [l for l in lines if len(l.get_xydata()) == 200]
    check("two full-width lines", len(full) == 2, f"{len(full)}")
    fitl = [l for l in full if l.get_linestyle() == "-"]
    refl = [l for l in full if l.get_linestyle() == "--"]
    check("one solid fit line, one dashed reference", len(fitl) == 1 and len(refl) == 1)
    if fitl and refl:
        f = fitl[0].get_xydata()
        r = refl[0].get_xydata()
        fslope = np.polyfit(np.log(f[:, 0]), np.log(f[:, 1]), 1)[0]
        rslope = np.polyfit(np.log(r[:, 0]), np.log(r[:, 1]), 1)[0]
        check(f"fit line slope == {expect['slope']:.6f}",
              abs(fslope - expect["slope"]) < 1e-8, f"{fslope:.8f}")
        check("reference line slope == -1/2", abs(rslope + 0.5) < 1e-9, f"{rslope:.8f}")
        if expect["theory"] is not None:
            n = np.array(P.EXPECTED_N, dtype=float)
            pred = np.interp(np.log(n), np.log(r[:, 0]), np.log(r[:, 1]))
            check("reference line == theory column",
                  np.allclose(np.exp(pred), np.array(expect["theory"]), rtol=1e-9))

    leg = ax.get_legend()
    labels = [t.get_text() for t in leg.get_texts()]
    check("legend 3 entries", len(labels) == 3, str(labels))
    check("legend has OLS slope", any("OLS fit" in l and f"{expect['slope']:.4f}" in l
                                      for l in labels))
    check("legend has reference/theory",
          any("reference" in l or "theory" in l for l in labels))
    check("legend has MAE points", any("MAE" in l for l in labels))

    ann = [t for t in ax.texts if "95% CI" in t.get_text()]
    check("annotation present", len(ann) == 1)
    txt = ann[0].get_text()
    check("annotation has slope", f"b = {expect['slope']:.4f}" in txt)
    check("annotation has method facts", "200 runs/N" in txt and "2026" in txt)
    check("annotation headline label", "OLS t" in txt and "headline" in txt)
    check("annotation headline values",
          f"[{expect['head'][0]:.4f}, {expect['head'][1]:.4f}]" in txt)
    check("annotation bootstrap label", "paired bootstrap" in txt and "check" in txt)
    check("annotation bootstrap values",
          f"[{expect['dep'][0]:.4f}, {expect['dep'][1]:.4f}]" in txt)
    want_verdict = ("inside both intervals" if expect["in_both"]
                    else "OUTSIDE" if "OUTSIDE" in txt else "INSIDE")
    check("annotation verdict matches data", want_verdict in txt
          or not expect["in_both"], txt.splitlines()[-1])
    check("annotation lines short", max(len(l) for l in txt.splitlines()) <= 40,
          str(max(len(l) for l in txt.splitlines())))

    def to_axes(bb):
        return bb.transformed(ax.transAxes.inverted())
    ab = to_axes(ann[0].get_window_extent())
    lb = to_axes(leg.get_window_extent())
    check("annotation inside axes", ab.x0 >= 0.0 and ab.x1 <= 1.0
          and ab.y0 >= 0.0 and ab.y1 <= 1.0, f"{ab}")
    check("annotation upper-right block", ab.x0 > 0.35 and ab.y1 > 0.9, f"{ab}")
    check("legend lower-left", lb.x0 < 0.1 and lb.y0 < 0.1, f"{lb}")
    overlap = not (ab.x1 < lb.x0 or lb.x1 < ab.x0 or ab.y1 < lb.y0 or lb.y1 < ab.y0)
    check("no annotation/legend overlap", not overlap)
    pa = np.array([ax.transAxes.inverted().transform(ax.transData.transform(p))
                   for p in pts])
    collide = any(ab.x0 - 0.02 < x < ab.x1 + 0.02 and ab.y0 - 0.02 < y < ab.y1 + 0.02
                  for x, y in pa)
    check("no point inside annotation box", not collide)

    import PIL.Image
    im = np.asarray(PIL.Image.open(png).convert("L"))
    check("PNG size 1260x840", im.shape == (840, 1260), str(im.shape))
    ink = (im < 250).mean()
    check("figure not blank", 0.01 < ink < 0.5, f"ink={ink:.3f}")
    h, w = im.shape
    ur = (im[: h // 4, w // 2:] < 250).mean()
    ll = (im[3 * h // 4:, : w // 2] < 250).mean()
    ul = (im[: h // 3, : w // 3] < 250).mean()
    check("ink upper-right (annotation)", ur > 0.005, f"{ur:.4f}")
    check("ink lower-left (legend)", ll > 0.005, f"{ll:.4f}")
    check("ink upper-left (first points visible)", ul > 0.001, f"{ul:.4f}")


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "--selftest":
        outdir = Path(tempfile.mkdtemp())
        fig = captured_render(["plot_mae_loglog.py", "--selftest",
                               str(outdir / "st.png")])
        # the selftest stamps its title; strip that expectation
        rng = np.random.default_rng(0)
        n = np.array(P.EXPECTED_N, dtype=float)
        mae = 1.31 * n**-0.5 * np.exp(rng.normal(0, 0.01, n.size))
        se = mae / math.sqrt(200) * 1.1
        fig.axes[0].set_title(fig.axes[0].get_title().split("\n")[-1])
        inspect_common(fig, outdir / "st.png", {
            "slope": -0.5007, "head": (-0.534, -0.4674), "dep": (-0.5189, -0.4831),
            "in_both": True, "mae": list(mae), "se": list(se),
            "theory": list(math.sqrt(2 * (4 - math.pi)) * n**-0.5),
        })
    elif mode == "--real":
        inputs = Path(sys.argv[2])
        outdir = Path(sys.argv[3]) if len(sys.argv) > 3 else \
            Path(__file__).parent / "report" / "figures"
        fig = captured_render(["plot_mae_loglog.py", "--inputs", str(inputs),
                               "--outdir", str(outdir)])
        import pandas as pd
        df = pd.read_csv(inputs / "analysis" / "mae_table.csv")
        fit = json.loads((inputs / "analysis" / "fit.json").read_text())
        fp = P.parse_fit(fit)
        mae = list(df.sort_values("N")["mean_absolute_error"])
        se = list(df.sort_values("N")["se_mean_absolute_error"])
        theory = list(df.sort_values("N")["normal_approximation_mae"])
        head = (fp["headline"]["lo"], fp["headline"]["hi"])
        dep = (fp["dep"]["lo"], fp["dep"]["hi"])
        in_both = head[0] <= -0.5 <= head[1] and dep[0] <= -0.5 <= dep[1]
        inspect_common(fig, outdir / "mae_loglog.png", {
            "slope": fp["slope"], "head": head, "dep": dep, "in_both": in_both,
            "mae": mae, "se": se, "theory": theory,
        })
        # cross-check our containment verdict against fit.json's own flags
        check("verdict agrees with fit.json (headline)",
              (fit["headline_interval"]["contains_minus_half"] is True) is in_both,
              f"ours={in_both}")
        check("verdict agrees with fit.json (bootstrap)",
              (fit["paired_bootstrap"]["contains_minus_half"] is True) is in_both)
        # caption and provenance
        cap = (outdir / "caption.md").read_text()
        check("caption has slope", f"b = {fp['slope']:.4f}" in cap)
        check("caption has headline interval",
              f"[{head[0]:.4f}, {head[1]:.4f}]" in cap)
        check("caption has bootstrap interval",
              f"[{dep[0]:.4f}, {dep[1]:.4f}]" in cap)
        check("caption has asymptotic theory label", "asymptotic" in cap)
        check("caption states consistency", "consistent with" in cap if in_both else True)
        prov = json.loads((outdir / "provenance.json").read_text())
        commit = subprocess.run(["git", "-C", str(inputs), "rev-parse", "HEAD"],
                                capture_output=True, text=True,
                                check=True).stdout.strip()
        check("provenance records input commit",
              prov["inputs"][0]["commit"] == commit, prov["inputs"][0]["commit"][:12])
        for i, name in enumerate(("mae_table.csv", "fit.json")):
            check(f"provenance sha256 {name}",
                  prov["inputs"][i]["sha256"] ==
                  sha256_file(inputs / "analysis" / name))
        check("provenance not selftest", prov["selftest"] is False)
        check("provenance slope matches", prov["values_used"]["slope"] == fp["slope"])
        check("provenance MAE matches", prov["values_used"]["MAE"] == mae)
        check("provenance fit_mae cross-check tight",
              prov["values_used"]["fit_mae_column_max_log_diff"] < 1e-6)
    else:
        raise SystemExit("usage: check_render.py --selftest | "
                         "--real <inputs> [outdir]")

    print("OVERALL:", "PASS" if OK else "FAIL")
    sys.exit(0 if OK else 1)


if __name__ == "__main__":
    main()
