#!/usr/bin/env python3
"""Render report/tables/table_mae.md from experiment-repo's committed results.

The table is the checkable rendering of the objective's "table of N and mean
absolute error": every value is copied from analysis/mae_table.csv and
analysis/fit.json (experiment-repo) at a recorded commit; nothing is
recomputed here. Column layout follows the report page (paper-repo):
N, MAE (200 runs), s.e. of MAE, analytic expectation, fitted MAE.

Usage:
  python3 render_table.py --inputs <experiment-repo checkout> [--outdir DIR]
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

import pandas as pd

SIG = "{:.5e}"  # 6 significant digits, checkable against the CSV


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def fmt(v: float) -> str:
    return SIG.format(v)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--inputs", type=Path, required=True,
                    help="experiment-repo checkout containing analysis/")
    ap.add_argument("--outdir", type=Path, default=Path(__file__).parent,
                    help="output directory (default: beside this script)")
    args = ap.parse_args()

    csv_path = args.inputs / "analysis" / "mae_table.csv"
    fit_path = args.inputs / "analysis" / "fit.json"
    for p in (csv_path, fit_path):
        if not p.exists():
            raise SystemExit(f"missing input: {p}")
    df = pd.read_csv(csv_path).sort_values("N")
    fit = json.loads(fit_path.read_text())

    try:
        commit = subprocess.run(
            ["git", "-C", str(args.inputs), "rev-parse", "HEAD"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        commit = "unknown"

    head = fit["headline_interval"]
    boot = fit["paired_bootstrap"]
    slope = fit["slope"]
    n_pow = {10**3: "10^3", 10**4: "10^4", 10**5: "10^5",
             10**6: "10^6", 10**7: "10^7"}

    rows = []
    for _, r in df.iterrows():
        rows.append(
            f"| {n_pow[int(r['N'])]} | {fmt(r['mean_absolute_error'])} "
            f"| {fmt(r['se_mean_absolute_error'])} "
            f"| {fmt(r['exact_binomial_mae'])} | {fmt(r['fit_mae'])} |"
        )
    expected_n = [10**k for k in range(3, 8)]
    if [int(v) for v in df["N"]] != expected_n:
        raise SystemExit(f"objective requires N = {expected_n}")

    in_head = head["ci"][0] <= -0.5 <= head["ci"][1]
    in_boot = boot["ci"][0] <= -0.5 <= boot["ci"][1]
    verdict = ("Both intervals contain the Monte Carlo value -1/2: the measured "
               "scaling is consistent with N^(-1/2)."
               if in_head and in_boot else
               "Interval verdicts: "
               f"headline {'contains' if in_head else 'excludes'} -1/2, "
               f"paired bootstrap {'contains' if in_boot else 'excludes'} -1/2.")

    md = [
        "# Table: mean absolute error of the Monte Carlo pi estimate",
        "",
        "| N | MAE (200 runs) | s.e. of MAE | analytic expectation* | fitted MAE |",
        "|---:|---:|---:|---:|---:|",
        *rows,
        "",
        "\\*Analytic, not simulated: the exact expectation of the estimator's",
        "absolute error, (4/N) * E|K - Np| with K ~ Binomial(N, p), p = pi/4,",
        "i.e. E|pi_hat - pi|. For large N it tends to sqrt(2(4 - pi)/N), the",
        "dashed asymptotic line in report/figures/mae_loglog.png.",
        "",
        "Definitions: MAE = mean over 200 independent runs of |pi_hat - math.pi|,",
        "pi_hat = 4 * #{x^2 + y^2 <= 1} / N with (x, y) uniform in the unit square;",
        "run i = 0..199 uses numpy.random.default_rng(2026 + i), and each run's",
        "five estimates use nested prefixes of one 10^7-point stream, so runs are",
        "independent while the five N within a run are dependent.",
        "s.e. of MAE = standard error of that mean over the 200 runs.",
        "fitted MAE = exp(intercept) * N^slope, the OLS fit of ln(MAE) on ln(N).",
        "",
        f"Fit (from analysis/fit.json): slope b = {slope:.6f} "
        f"(R^2 = {fit['r_squared']:.6f}).",
        f"Headline 95% interval (residual OLS Student-t, df = {head['df']}): "
        f"[{head['ci'][0]:.6f}, {head['ci'][1]:.6f}].",
        "Dependence-aware check (paired-run percentile bootstrap over the 200",
        f"five-N error vectors, {boot['replicates']} resamples): "
        f"[{boot['ci'][0]:.6f}, {boot['ci'][1]:.6f}].",
        verdict,
        "",
        "Provenance: rendered from world/experiment-repo `analysis/mae_table.csv`",
        f"and `analysis/fit.json` at commit {commit} by render_table.py;",
        f"SHA-256: mae_table.csv {sha256_file(csv_path)[:16]}..., "
        f"fit.json {sha256_file(fit_path)[:16]}....",
        "Values shown at 6 significant digits; the stored full-precision values",
        "are in the CSV. Command: " + " ".join(sys.argv) + ".",
        "",
    ]
    out = args.outdir / "table_mae.md"
    out.write_text("\n".join(md))
    print(f"table written to {out}")


if __name__ == "__main__":
    main()
