#!/usr/bin/env python3
"""Verify report/tables/table_mae.md against experiment-repo's committed
results (every cell, the fit numbers, and the provenance block)."""
from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

import pandas as pd

OK = True


def check(name, cond, detail=""):
    global OK
    print(("PASS " if cond else "FAIL ") + name + (f"  [{detail}]" if detail else ""))
    OK = OK and bool(cond)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def main():
    inputs = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/hutian/experiment-repo")
    table = Path(__file__).parent / "report" / "tables" / "table_mae.md"
    md = table.read_text()
    df = pd.read_csv(inputs / "analysis" / "mae_table.csv").sort_values("N")
    fit = json.loads((inputs / "analysis" / "fit.json").read_text())

    rows = re.findall(r"^\| (10\^\d) \| ([0-9.e-]+) \| ([0-9.e-]+) \| "
                      r"([0-9.e-]+) \| ([0-9.e-]+) \|$", md, re.M)
    check("five table rows", len(rows) == 5, f"{len(rows)}")
    n_map = {f"10^{k}": 10**k for k in range(3, 8)}
    cols = ["mean_absolute_error", "se_mean_absolute_error",
            "exact_binomial_mae", "fit_mae"]
    for (n_lab, *cells), (_, r) in zip(rows, df.iterrows()):
        check(f"N {n_lab} in order", n_map[n_lab] == int(r["N"]))
        for cell, col in zip(cells, cols):
            want = float(cell)
            check(f"{n_lab} {col} matches CSV at 6 sig digits",
                  f"{r[col]:.5e}" == cell, f"md={cell} csv={r[col]:.5e}")

    slope = fit["slope"]
    head = fit["headline_interval"]["ci"]
    boot = fit["paired_bootstrap"]["ci"]
    check("slope stated", f"b = {slope:.6f}" in md)
    check("R^2 stated", f"R^2 = {fit['r_squared']:.6f}" in md)
    check("headline interval stated", f"[{head[0]:.6f}, {head[1]:.6f}]" in md)
    check("bootstrap interval stated", f"[{boot[0]:.6f}, {boot[1]:.6f}]" in md)
    check("verdict true and stated",
          head[0] <= -0.5 <= head[1] and boot[0] <= -0.5 <= boot[1]
          and "Both intervals contain" in md)
    check("definitions present", "default_rng(2026 + i)" in md
          and "math.pi" in md and "nested prefixes" in md)
    check("footnote has estimator-scale formula", "(4/N)" in md
          and "E|K - Np|" in md and "asymptotic" in md)

    commit = subprocess.run(["git", "-C", str(inputs), "rev-parse", "HEAD"],
                            capture_output=True, text=True,
                            check=True).stdout.strip()
    check("provenance commit", commit in md)
    check("provenance sha256 mae_table.csv",
          sha256_file(inputs / "analysis" / "mae_table.csv")[:16] in md)
    check("provenance sha256 fit.json",
          sha256_file(inputs / "analysis" / "fit.json")[:16] in md)

    print("OVERALL:", "PASS" if OK else "FAIL")
    sys.exit(0 if OK else 1)


if __name__ == "__main__":
    main()
