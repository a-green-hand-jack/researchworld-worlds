% Minimal stand-in for icml2025.sty (official file not supplied): two-column, 10pt, ICML geometry.
\ProvidesPackage{icml2025}
\DeclareOption{accepted}{}\ProcessOptions\relax
\RequirePackage[letterpaper,top=0.75in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in,textwidth=6.75in,textheight=9in,headheight=12pt,headsep=0.25in,footskip=0.35in]{geometry}
\RequirePackage{times}\RequirePackage{natbib}\RequirePackage{fancyhdr}\RequirePackage{xcolor}
\renewcommand{\normalsize}{\@setfontsize\normalsize\@xpt\@xipt}\normalsize
\setlength{\parindent}{0pt}\setlength{\parskip}{3pt plus 1pt}
\newcommand{\icmltitlerunning}[1]{\gdef\@icmlrun{#1}}
\gdef\@icmlrun{}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\@icmlrun}\fancyfoot[C]{\thepage}
\newcommand{\icmltitle}[1]{\begin{center}{\Large\bfseries #1\par}\end{center}}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\newcommand{\icmlauthor}[2]{\textbf{#1}}
\newcommand{\icmlaffiliation}[2]{}
\newcommand{\icmlcorrespondingauthor}[2]{}
\newcommand{\icmlkeywords}[1]{}
\renewenvironment{abstract}{\begin{center}{\bfseries Abstract}\end{center}\begin{quote}\small}{\end{quote}}
\renewcommand\section{\@startsection{section}{1}{\z@}{-8pt plus -2pt minus -1pt}{4pt}{\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-6pt plus -2pt minus -1pt}{3pt}{\normalsize\bfseries}}
