"""Check saved count arithmetic independently of NumPy aggregation."""
import csv
import hashlib
import json
import math
from pathlib import Path
import statistics
from scipy.stats import t

root = Path(__file__).resolve().parents[1]
rows = list(csv.DictReader((root/'results/per_seed.csv').open()))
s = json.loads((root/'results/summary.json').read_text())
assert len(rows) == 20
assert [int(r['spawn_key']) for r in rows] == list(range(20))
assert all(int(r['n']) == 1_000_000 for r in rows)
values = []
for row in rows:
    count = int(row['inside'])
    assert 0 <= count <= int(row['n'])
    value = 4 * count / int(row['n'])
    assert value == float(row['estimate'])
    values.append(value)
assert sum(int(r['inside']) for r in rows) == s['total_inside']
assert sum(int(r['n']) for r in rows) == s['total_points'] == 20_000_000
mean = statistics.mean(values)
sd = statistics.stdev(values)
sem = sd/math.sqrt(20)
h = t.ppf(0.975, 19)*sem
for key, value in dict(mean_estimate=mean, sample_sd=sd, sem=sem,
                       ci_lower=mean-h, ci_upper=mean+h,
                       signed_error=mean-math.pi, absolute_error=abs(mean-math.pi)).items():
    assert math.isclose(s[key], value, rel_tol=1e-12, abs_tol=1e-15), key
assert hashlib.sha256((root/'code/estimate_pi.py').read_bytes()).hexdigest() == s['script_sha256']
print('PASS: 20 stream IDs, all counts and estimates, 20,000,000 total points, mean, SD, SEM, t interval, errors, and script hash.')
