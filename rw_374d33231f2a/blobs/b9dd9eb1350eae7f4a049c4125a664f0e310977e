"""Reproduce the fixed 20-seed study: python3 code/estimate_pi.py."""
import csv
import hashlib
import json
import math
from pathlib import Path
import platform
import time
from concurrent.futures import ThreadPoolExecutor

import numpy as np
import scipy
from scipy.stats import t, chi2

N = 1_000_000
K = 20
ROOT_SEED = 20261019
OUT = Path(__file__).resolve().parents[1] / 'results'


def replicate(seed):
    start = time.perf_counter()
    rng = np.random.Generator(np.random.PCG64(seed))
    xy = rng.random((N, 2))
    inside = int(np.count_nonzero(xy[:, 0] ** 2 + xy[:, 1] ** 2 <= 1.0))
    row = dict(spawn_key=seed.spawn_key[0], n=N, inside=inside,
               estimate=4.0 * inside / N)
    print(json.dumps(dict(row, elapsed_seconds=time.perf_counter() - start)), flush=True)
    return row


def main():
    OUT.mkdir(exist_ok=True)
    start = time.perf_counter()
    seeds = np.random.SeedSequence(ROOT_SEED).spawn(K)
    # Time the first required replicate as an execution pilot; retain it in the
    # prespecified study, without examining its value to change the design.
    pilot_start = time.perf_counter()
    rows = [replicate(seeds[0])]
    pilot_seconds = time.perf_counter() - pilot_start
    print(f'Timed first study replicate: {pilot_seconds:.6f} seconds; remaining 19 use two workers.', flush=True)
    with ThreadPoolExecutor(max_workers=2) as pool:
        rows.extend(pool.map(replicate, seeds[1:]))
    estimates = np.array([r['estimate'] for r in rows])
    assert len(rows) == K and len({r['spawn_key'] for r in rows}) == K
    assert all(r['n'] == N and 0 <= r['inside'] <= N for r in rows)
    mean = float(estimates.mean())
    sd = float(estimates.std(ddof=1))
    sem = sd / math.sqrt(K)
    critical = float(t.ppf(0.975, K - 1))
    halfwidth = critical * sem
    expected_variance = math.pi * (4 - math.pi) / N
    variance_stat = (K - 1) * sd ** 2 / expected_variance
    with (OUT / 'per_seed.csv').open('w') as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)
    summary = dict(
        n_seeds=K, points_per_seed=N, total_points=K*N,
        additional_pilot_points=0, total_inside=sum(r['inside'] for r in rows),
        mean_estimate=mean, sample_sd=sd, sem=sem, confidence_level=0.95,
        ci_method='Two-sided Student t interval across 20 seed estimates',
        degrees_of_freedom=K-1, t_critical=critical,
        ci_lower=mean-halfwidth, ci_upper=mean+halfwidth, ci_half_width=halfwidth,
        reference_math_pi=math.pi, signed_error=mean-math.pi,
        absolute_error=abs(mean-math.pi),
        theoretical_seed_sd=math.sqrt(expected_variance),
        variance_ratio=sd**2/expected_variance,
        approximate_variance_diagnostic_two_sided_p=float(2*min(
            chi2.cdf(variance_stat, K-1), chi2.sf(variance_stat, K-1))),
        root_seed=ROOT_SEED, stream_construction='numpy.random.SeedSequence(root_seed).spawn(20)',
        spawn_keys=[list(s.spawn_key) for s in seeds], bit_generator='PCG64',
        uniform_sampling='Generator.random((1000000, 2)), float64, [0,1)',
        inside_rule='x*x + y*y <= 1.0',
        software=dict(python=platform.python_version(), numpy=np.__version__, scipy=scipy.__version__),
        script_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        first_replicate_seconds=pilot_seconds, total_elapsed_seconds=time.perf_counter()-start)
    assert math.isclose(mean, 4*summary['total_inside']/summary['total_points'], abs_tol=1e-15)
    (OUT/'summary.json').write_text(json.dumps(summary, indent=2)+'\n')
    print(json.dumps(summary), flush=True)


if __name__ == '__main__':
    main()
