# Supplementary: same rules evaluated in 60-digit arithmetic, so errors far below float64 eps are resolved.
import csv, numpy as np
from mpmath import mp, mpf, exp, sqrt, atan, e
from scipy import stats
mp.dps=60
F={"exp":(lambda x:exp(x),e-1),"runge":(lambda x:1/(1+25*x**2),atan(5)/5),"sqrt":(lambda x:sqrt(x),mpf(2)/3)}
a=sqrt(mpf(3)/7-mpf(2)/7*sqrt(mpf(6)/5)); b=sqrt(mpf(3)/7+mpf(2)/7*sqrt(mpf(6)/5))
wa=(18+sqrt(mpf(30)))/36; wb=(18-sqrt(mpf(30)))/36
xg=[-b,-a,a,b]; wg=[wb,wa,wa,wb]
# check against numpy nodes
xn,wn=np.polynomial.legendre.leggauss(4); assert max(abs(float(u)-v) for u,v in zip(xg,xn))<1e-15 and max(abs(float(u)-v) for u,v in zip(wg,wn))<1e-15
def trap(f,n):
    h=mpf(1)/n; s=(f(mpf(0))+f(mpf(1)))/2+sum(f(i*h) for i in range(1,n)); return h*s
def simp(f,n):
    h=mpf(1)/n; s=f(mpf(0))+f(mpf(1))+2*sum(f(i*h) for i in range(1,n))+4*sum(f((i+mpf(1)/2)*h) for i in range(n)); return h/6*s
def gl(f,n):
    h=mpf(1)/n; return h/2*sum(w*f(i*h+h*(x+1)/2) for i in range(n) for x,w in zip(xg,wg))
R={"trapezoid":trap,"simpson":simp,"gauss4":gl}
rows=[]
for fn,(f,ex) in F.items():
    for rn,r in R.items():
        for k in range(1,13):
            n=2**k; rows.append((fn,rn,k,n,abs(r(f,n)-ex)))
with open("results/errors_highprec.csv","w",newline="") as fh:
    w=csv.writer(fh); w.writerow(["function","rule","k","n","abs_error"])
    for r in rows: w.writerow([r[0],r[1],r[2],r[3],mp.nstr(r[4],12)])
def fit(ks,es):
    x=np.log(2.0**np.array(ks)); y=np.array([float(mp.log(v)) for v in es]); m=len(x)
    res=stats.linregress(x,y); o=-res.slope; hw=stats.t.ppf(.975,m-2)*res.stderr
    return o,o-hw,o+hw,m
with open("results/orders_highprec.csv","w",newline="") as fh:
    w=csv.writer(fh); w.writerow(["function","rule","fit_range","order","ci95_lo","ci95_hi","n_points"])
    for fn in F:
        for rn in R:
            sel=[r for r in rows if r[0]==fn and r[1]==rn]
            ks=[r[2] for r in sel]; es=[r[4] for r in sel]
            loc=[float(-mp.log(es[i+1]/es[i])/mp.log(2)) for i in range(11)]
            print(fn,rn,[round(s,2) for s in loc])
            for lo in (1,5,8):  # all k; k>=5; k>=8
                if 12-lo+1>=3:
                    o,l,h,m=fit(ks[lo-1:],es[lo-1:]); w.writerow([fn,rn,f"k={lo}-12",f"{o:.4f}",f"{l:.4f}",f"{h:.4f}",m])
