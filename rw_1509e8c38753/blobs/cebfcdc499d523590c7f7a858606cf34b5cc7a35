#!/usr/bin/env python3
"""Working diagnostic plot (not the delivered figure): per-fold accuracies and paired differences."""
import sys
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt
import pandas as pd
f = pd.read_csv(sys.argv[1])
fig, ax = plt.subplots(1, 3, figsize=(11, 3.2))
ax[0].boxplot([f.acc_lr, f.acc_knn], labels=["LR", "k-NN"]); ax[0].set_ylabel("outer-fold accuracy")
d = f.acc_lr - f.acc_knn
ax[1].hist(d, bins=sorted(set(d)) + [d.max() + 0.0334], align="left", rwidth=0.8); ax[1].set_xlabel("LR - k-NN per fold")
ax[2].bar(*zip(*f.k.value_counts().sort_index().items())); ax[2].set_xlabel("chosen k")
fig.tight_layout(); fig.savefig(sys.argv[2], dpi=120)
