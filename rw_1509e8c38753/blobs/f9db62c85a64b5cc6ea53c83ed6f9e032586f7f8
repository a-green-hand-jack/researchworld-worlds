#!/usr/bin/env python3
"""Summary statistics from folds.csv written by cv_compare.py.

Usage (from report/code/): python summarize.py --results ../results
Reads ../results/run_local/folds.csv (the run whose numbers are quoted), and
if present run_ibex/folds.csv and reproducibility.json. Writes into ../results:
summary.json (all numbers), table.csv (the report's table), folds_long.csv
(per fold x method x run, for the figure) and numbers.tex (LaTeX macros for
every number the paper states).

Intervals (95%), over the J = 50 outer folds:
  corrected : Nadeau & Bengio (2003) corrected resampled t, as recommended for
              repeated k-fold CV by Bouckaert & Frank (2004):
              mean +/- t_{J-1} * sqrt((1/J + n_test/n_train) * s^2). PRIMARY.
  naive     : mean +/- t_{J-1} * s / sqrt(J); treats folds as independent,
              which they are not (overlapping training sets), so too narrow.
  rep_means : t interval over the 10 repetition means (df = 9).
"""
import argparse, json, os
import numpy as np
import pandas as pd
from scipy import stats


def intervals(x, n_test, n_train):
    x = np.asarray(x, float)
    J, m, s2 = len(x), x.mean(), x.var(ddof=1)
    t = stats.t.ppf(0.975, J - 1)
    hc = t * np.sqrt((1 / J + n_test / n_train) * s2)
    hn = t * np.sqrt(s2 / J)
    return {"mean": m, "sd_folds": np.sqrt(s2), "J": J, "t_crit": t,
            "corrected": [m - hc, m + hc], "naive": [m - hn, m + hn]}


def rep_interval(x, rep):
    r = pd.Series(np.asarray(x, float)).groupby(np.asarray(rep)).mean().to_numpy()
    h = stats.t.ppf(0.975, len(r) - 1) * r.std(ddof=1) / np.sqrt(len(r))
    return [r.mean() - h, r.mean() + h]


def block(f, a, b):
    n_test, n_train = f.n_test.mean(), f.n_train.mean()
    out = {}
    for name, x in (("lr", f[a]), ("knn", f[b]), ("diff_lr_minus_knn", f[a] - f[b])):
        d = intervals(x, n_test, n_train)
        d["rep_means"] = rep_interval(x, f.rep)
        out[name] = d
    d = (f[a] - f[b]).to_numpy()
    out["diff_lr_minus_knn"].update({
        "folds_lr_better": int((d > 0).sum()), "folds_tie": int((d == 0).sum()),
        "folds_knn_better": int((d < 0).sum()),
        # naive: ignores dependence between folds, reported for completeness only
        "wilcoxon_p_naive": float(stats.wilcoxon(d[d != 0]).pvalue) if (d != 0).any() else 1.0,
        "corrected_t_p": float(2 * stats.t.sf(abs(d.mean()) / np.sqrt(
            (1 / len(d) + n_test / n_train) * d.var(ddof=1)), len(d) - 1)) if d.var() > 0 else 1.0,
    })
    return out


def long_format(results):
    out = []
    for run in ("local", "ibex"):
        p = os.path.join(results, f"run_{run}", "folds.csv")
        if not os.path.exists(p):
            continue
        f = pd.read_csv(p)
        for method, col in (("logreg", "acc_lr"), ("knn", "acc_knn")):
            out.append(pd.DataFrame({"run": run, "repetition": f.rep, "fold": f.fold, "method": method,
                                     "accuracy": f[col], "chosen_k": f.k if method == "knn" else pd.NA,
                                     "n_test": f.n_test}))
    return pd.concat(out)


def pct(x, nd=1):
    return f"{100 * x:.{nd}f}"


def write_macros(s, path):
    m = s["main"]
    L = ["% Generated by report/code/summarize.py from results/run_local/folds.csv; do not edit.",
         "% Accuracies in percent (1 decimal); LR - k-NN differences in percentage points (2 decimals).",
         "% Negative values carry a plain '-': use them in math mode, e.g. $\\accDiffLo$."]
    def mac(name, val):
        L.append(f"\\newcommand{{\\{name}}}{{{val}}}")
    for key, nm, nd in (("lr", "LR", 1), ("knn", "KNN", 1), ("diff_lr_minus_knn", "Diff", 2)):
        d = m[key]
        mac(f"acc{nm}Mean", pct(d["mean"], nd))
        mac(f"acc{nm}Lo", pct(d["corrected"][0], nd)); mac(f"acc{nm}Hi", pct(d["corrected"][1], nd))
        mac(f"acc{nm}NaiveLo", pct(d["naive"][0], nd)); mac(f"acc{nm}NaiveHi", pct(d["naive"][1], nd))
        mac(f"acc{nm}SD", pct(d["sd_folds"], nd))
    d = m["diff_lr_minus_knn"]
    mac("foldsLRBetter", d["folds_lr_better"]); mac("foldsTie", d["folds_tie"]); mac("foldsKNNBetter", d["folds_knn_better"])
    mac("diffCorrectedP", f"{d['corrected_t_p']:.2f}")
    u = s["robustness_unscaled"]
    mac("accLRUnscaledMean", pct(u["lr"]["mean"])); mac("accKNNUnscaledMean", pct(u["knn"]["mean"]))
    mac("accDiffUnscaledMean", pct(u["diff_lr_minus_knn"]["mean"], 2))
    mac("accDiffUnscaledLo", pct(u["diff_lr_minus_knn"]["corrected"][0], 2)); mac("accDiffUnscaledHi", pct(u["diff_lr_minus_knn"]["corrected"][1], 2))
    k = s["k_summary"]
    mac("kMin", k["min"]); mac("kMax", k["max"]); mac("kMedian", f"{k['median']:g}"); mac("kMode", k["mode"])
    mac("kGridMin", 1); mac("kGridMax", 30)
    mac("nFolds", 50); mac("nRep", 10); mac("nSplits", 5); mac("nTrain", 120); mac("nTest", 30)
    mac("nDuplicateRows", s["n_duplicate_rows"])
    mac("tCrit", f"{m['lr']['t_crit']:.3f}")
    mac("seed", s["seed"]); mac("dataMDFive", s["data_md5"])
    r = s.get("reproducibility")
    if r:
        mac("ibexNode", r["run_b"]["slurmd_nodename"] or r["run_b"]["hostname"])
        mac("ibexJobId", r["run_b"]["slurm_job_id"])
        mac("ibexPartition", r["run_b"]["slurm_partition"])
        mac("runsIdentical", "yes" if r["all_numbers_identical"] else "no")
        mac("runsDifferingFolds", r["n_differing_folds"])
        mac("runsDifferingPredictions", r["n_differing_predictions"])
        mac("nPredictionsCompared", r["n_predictions_compared"])
        mac("verPythonIbex", r["run_b"]["python"])
    for key in ("python", "numpy", "scipy", "sklearn"):
        mac(f"ver{key.capitalize()}", s["versions_local"][key])
    open(path, "w").write("\n".join(L) + "\n")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--results", required=True)
    args = ap.parse_args()
    args.out = args.results
    args.folds = os.path.join(args.results, "run_local", "folds.csv")
    f = pd.read_csv(args.folds)
    assert len(f) == 50 and set(f.n_test) == {30} and set(f.n_train) == {120}
    s = {"source": os.path.relpath(args.folds, args.out),
         "design": "10 x stratified 5-fold CV, 50 paired outer folds, n_train=120, n_test=30",
         "primary_interval": "corrected (Nadeau-Bengio corrected resampled t, df=49)",
         "main": block(f, "acc_lr", "acc_knn"),
         "robustness_unscaled": block(f, "acc_lr_unscaled", "acc_knn_unscaled"),
         "k_chosen": {str(k): int(v) for k, v in f.k.value_counts().sort_index().items()},
         "k_chosen_unscaled": {str(k): int(v) for k, v in f.k_unscaled.value_counts().sort_index().items()},
         "k_summary": {"min": int(f.k.min()), "max": int(f.k.max()), "median": float(f.k.median()),
                       "mode": int(f.k.mode().min())},
         "k_grid": "1..30", "quoted_run": "local"}
    run = json.load(open(os.path.join(args.results, "run_local", "run.json")))
    s["seed"], s["data_md5"] = run["seed"], run["data_md5"]
    import arff  # rows identical to an earlier row (features and label); left in the data
    s["n_duplicate_rows"] = int(pd.DataFrame(arff.load(open(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "data", "iris.arff")))["data"]).duplicated().sum())
    s["versions_local"] = {k: run[k] for k in ("python", "numpy", "scipy", "sklearn", "pandas")}
    rp = os.path.join(args.results, "reproducibility.json")
    if os.path.exists(rp):
        s["reproducibility"] = json.load(open(rp))
    json.dump(s, open(os.path.join(args.out, "summary.json"), "w"), indent=2,
              default=lambda o: o.item() if hasattr(o, "item") else str(o))

    m = s["main"]
    rows = []
    for key, label in (("lr", "Multinomial logistic regression"),
                       ("knn", "k-NN (k by inner 5-fold CV)"),
                       ("diff_lr_minus_knn", "Paired difference (LR - k-NN)")):
        d = m[key]
        rows.append({"row": label, "mean_accuracy": d["mean"],
                     "ci95_low_corrected": d["corrected"][0], "ci95_high_corrected": d["corrected"][1],
                     "ci95_low_naive": d["naive"][0], "ci95_high_naive": d["naive"][1],
                     "sd_over_folds": d["sd_folds"]})
    pd.DataFrame(rows).to_csv(os.path.join(args.out, "table.csv"), index=False, float_format="%.6f")
    long_format(args.results).to_csv(os.path.join(args.out, "folds_long.csv"), index=False, float_format="%.17g")
    write_macros(s, os.path.join(args.out, "numbers.tex"))
    print(pd.DataFrame(rows).to_string(index=False))
    print(json.dumps({k: s[k] for k in ("k_chosen", "k_summary")}))
    print(json.dumps({k: v for k, v in m["diff_lr_minus_knn"].items()}, default=float))
    print("unscaled:", json.dumps({k: (v["mean"], v["corrected"]) for k, v in s["robustness_unscaled"].items()}, default=float))


if __name__ == "__main__":
    main()
