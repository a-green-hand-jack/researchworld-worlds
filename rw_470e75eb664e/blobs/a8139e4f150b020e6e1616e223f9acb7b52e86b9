% Local stand-in for the official icml2025.sty (not supplied): two-column, 10pt, US letter, ICML geometry.
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{icml2025}[2025/01/01 stand-in]
\DeclareOption{accepted}{}\DeclareOption{preprint}{}\ProcessOptions\relax
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in,footskip=0.5in]{geometry}
\RequirePackage{times}\RequirePackage{natbib}\RequirePackage{xcolor}\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\setlength{\parindent}{0pt}\setlength{\parskip}{3pt plus 1pt}
\renewcommand{\normalsize}{\@setfontsize\normalsize{10}{11}}\normalsize
\newcommand{\icmltitlerunning}[1]{\gdef\@icmlrunning{#1}}
\gdef\@icmlrunning{}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancyhead[C]{\small\@icmlrunning}
\newcommand{\icmltitle}[1]{\begin{center}{\LARGE\bf #1\par}\end{center}}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\newcommand{\icmlauthor}[2]{\textbf{#1}\textsuperscript{#2}\ }
\newcommand{\icmlaffiliation}[2]{}\newcommand{\icmlcorrespondingauthor}[2]{}\newcommand{\icmlkeywords}[1]{}
\newcommand{\icmlEqualContribution}{}
\renewenvironment{abstract}{\begin{center}{\large\bf Abstract}\end{center}\begin{quote}\small}{\end{quote}}
\renewcommand\section{\@startsection{section}{1}{\z@}{-8pt plus -2pt minus -1pt}{4pt}{\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-6pt plus -2pt minus -1pt}{3pt}{\normalsize\bfseries}}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}
\long\def\@makecaption#1#2{\vskip 4pt\small #1: #2\par}
