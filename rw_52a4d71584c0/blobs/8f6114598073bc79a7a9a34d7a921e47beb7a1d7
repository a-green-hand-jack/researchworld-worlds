"""Plot data + OLS fit + 95% band from experiment-repo's results (results/data.csv, results/fit.json).
Usage (from the delivery root): python3 figures/make_fit.py [results_dir] [out.png]"""
import json, sys
import numpy as np, matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

rdir = sys.argv[1] if len(sys.argv) > 1 else "results"
out = sys.argv[2] if len(sys.argv) > 2 else "figures/fit.png"
f = json.load(open(f"{rdir}/fit.json"))
d = np.genfromtxt(f"{rdir}/data.csv", delimiter=",", names=True)
x, y = d["x"], d["y"]
n, s, t = f["n"], f["residual_sd"], f["t_crit_975"]
assert len(x) == n and np.allclose(d["fitted"], f["intercept"] + f["slope"] * x, atol=1e-6)

xg = np.linspace(x.min(), x.max(), 200)
yhat = f["intercept"] + f["slope"] * xg
se_mean = s * np.sqrt(1 / n + (xg - x.mean()) ** 2 / ((x - x.mean()) ** 2).sum())

fig, ax = plt.subplots(figsize=(6.4, 4.4), dpi=200)
ax.fill_between(xg, yhat - t * se_mean, yhat + t * se_mean, color="#9ecae1", alpha=0.6,
                label="95% CI of fitted line", lw=0)
ax.plot(xg, f["true_intercept"] + f["true_slope"] * xg, color="0.5", ls="--", lw=1.2,
        label="true line (2.5 + 0.8 x)")
ax.plot(xg, yhat, color="#08519c", lw=2, label="OLS fit")
ax.scatter(x, y, s=22, color="k", zorder=3, label=f"data (n = {n})")
ax.set_xlabel("x"); ax.set_ylabel("y")
sc, ic = f["slope_ci95"], f["intercept_ci95"]
ax.text(0.03, 0.97,
        f"slope = {f['slope']:.3f}  (95% CI {sc[0]:.3f}, {sc[1]:.3f})\n"
        f"intercept = {f['intercept']:.3f}  (95% CI {ic[0]:.3f}, {ic[1]:.3f})\n"
        f"residual SD = {s:.3f}",
        transform=ax.transAxes, va="top", fontsize=8.5,
        bbox=dict(boxstyle="round", fc="white", ec="0.7"))
ax.legend(loc="lower right", fontsize=8, frameon=False)
ax.spines[["top", "right"]].set_visible(False)
fig.tight_layout()
fig.savefig(out)
import platform
with open(out.rsplit("/", 1)[0] + "/versions.txt" if "/" in out else "versions.txt", "w") as v:
    v.write(f"python {platform.python_version()}\nnumpy {np.__version__}\nmatplotlib {matplotlib.__version__}\n"
            "scipy not used by this script (scipy is used only by experiment-repo's code/fit.py)\n")
