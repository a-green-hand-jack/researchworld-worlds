"""Reaggregate the saved integer counts without rerunning sampling."""
import csv
import hashlib
import json
import math
from pathlib import Path
import numpy as np
from scipy.stats import t

root = Path(__file__).resolve().parents[1]
s = json.loads((root / 'results/summary.json').read_text())
rows = list(csv.DictReader((root / 'results/per_seed.csv').open()))
assert len(rows) == 20
assert [int(r['stream']) for r in rows] == list(range(20))
assert all(int(r['points']) == 1_000_000 for r in rows)
assert all(int(r['root_seed']) == s['root_seed'] for r in rows)
assert [[int(r['spawn_key'])] for r in rows] == s['spawn_keys']
counts = np.array([int(r['inside']) for r in rows])
assert np.all((0 <= counts) & (counts <= 1_000_000))
x = 4 * counts / 1_000_000
assert np.array_equal(x, [float(r['estimate']) for r in rows])
mean = float(x.mean())
se = float(x.std(ddof=1) / np.sqrt(len(x)))
lo, hi = t.interval(.95, df=19, loc=mean, scale=se)
expected = {'mean_estimate': mean, 'standard_error': se, 'ci_lower': lo,
            'ci_upper': hi, 'signed_error': mean - math.pi,
            'absolute_error': abs(mean - math.pi), 'total_inside': int(counts.sum()),
            'total_points': sum(int(r['points']) for r in rows)}
for key, value in expected.items():
    assert math.isclose(value, s[key], rel_tol=1e-12, abs_tol=1e-14), key
for key, path in [('source_script_sha256', 'code/monte_carlo.py'),
                  ('source_counts_sha256', 'results/per_seed.csv')]:
    assert hashlib.sha256((root / path).read_bytes()).hexdigest() == s[key]
print('PASS: all 20 seeds, counts, totals, estimates, mean, t interval, errors, and source hashes.')
