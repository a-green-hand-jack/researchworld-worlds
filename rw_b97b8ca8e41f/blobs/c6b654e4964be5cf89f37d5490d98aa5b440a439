"""Feasibility benchmark: CPU throughput of a representative JEPA training step.

Measures steps/sec and time/epoch of a faithful JEPA step:
  context encoder (trainable) over VISIBLE patches
  -> predictor (narrow, trainable) over MASKED target positions
  -> target encoder (EMA, no grad) over MASKED target patches
  -> MSE loss; Adam on online+predictor; EMA update of target each step.

Two setups, matching idea-repo's minimum credible scope (BRIEF.md s6):
  A: linear JEPA on synthetic data (theory vehicle)         -> lin_*
  B: small ViT JEPA at CIFAR-10 scale (3x32x32, patch 4)    -> vit_*

Not a study result: feasibility evidence only. Synthetic tensors carry CIFAR
shapes; data content is irrelevant to throughput.
Run: python3 bench_jepa_cpu.py [--steps N] [--configs ...]
"""
import argparse, json, math, sys, time
import torch
import torch.nn as nn
import torch.nn.functional as F


def set_threads(n):
    torch.set_num_threads(n)
    return torch.get_num_threads()


class LinearJEPA(nn.Module):
    """Deep-linear (2-layer) online encoder + linear predictor, EMA target."""

    def __init__(self, in_dim=784, hidden=512, emb=256, pred_hidden=0):
        super().__init__()
        self.enc = nn.Sequential(nn.Linear(in_dim, hidden), nn.Linear(hidden, emb))
        self.pred = nn.Linear(emb, emb)
        self.enc_t = nn.Sequential(nn.Linear(in_dim, hidden), nn.Linear(hidden, emb))
        for p in self.enc_t.parameters():
            p.requires_grad_(False)
        for pt, po in zip(self.enc_t.parameters(), self.enc.parameters()):
            pt.data.copy_(po.data)

    def forward(self, x_ctx, x_tgt):
        z = self.enc(x_ctx)
        p = self.pred(z)
        with torch.no_grad():
            t = self.enc_t(x_tgt)
        loss = F.mse_loss(p, t)
        return loss


class ViTTiny(nn.Module):
    def __init__(self, dim=192, depth=6, heads=3, npatch=64, pdim=0, pdim_out=0):
        super().__init__()
        pdim = pdim or dim
        pdim_out = pdim_out or dim
        self.pos = nn.Parameter(torch.randn(1, npatch, pdim) * 0.02)
        self.blocks = nn.ModuleList(
            [nn.TransformerEncoderLayer(dim, heads, dim * 4, dropout=0.0,
                                        activation="gelu", batch_first=True,
                                        norm_first=True)
             for _ in range(depth)])
        self.norm = nn.LayerNorm(dim)

    def forward(self, x):  # x: (B, N, dim)
        h = x + self.pos[:, : x.shape[1]]
        for b in self.blocks:
            h = b(h)
        return self.norm(h)


class ViTJEPA(nn.Module):
    """I-JEPA-like: patch embed online+target (tied or EMA), encoder on visible,
    narrow predictor on masked positions, EMA target encoder on masked."""

    def __init__(self, img=32, patch=4, dim=192, depth=6, heads=3,
                 pred_dim=64, pred_depth=2):
        super().__init__()
        self.npatch = (img // patch) ** 2
        self.embed = nn.Conv2d(3, dim, patch, patch)
        self.enc = ViTTiny(dim, depth, heads, self.npatch)
        self.pred = nn.Sequential(
            nn.Linear(dim, pred_dim),
            * [nn.TransformerEncoderLayer(pred_dim, 2, pred_dim * 4, dropout=0.0,
                                          activation="gelu", batch_first=True,
                                          norm_first=True) for _ in range(pred_depth - 1)],
            nn.Linear(pred_dim, dim))
        self.enc_t = ViTTiny(dim, depth, heads, self.npatch)
        self.enc_t.load_state_dict(self.enc.state_dict())
        for p in self.enc_t.parameters():
            p.requires_grad_(False)

    def mask_split(self, B, device, mask_ratio, n_block=4):
        """Block-ish random split into visible and masked index sets."""
        idx = torch.randperm(self.npatch, device=device)
        nmask = int(self.npatch * mask_ratio)
        return idx[nmask:].unsqueeze(0).expand(B, -1).contiguous(), \
               idx[:nmask].unsqueeze(0).expand(B, -1).contiguous()

    def step(self, imgs, mask_ratio=0.75, no_sg=False):
        B = imgs.shape[0]
        vis, msk = self.mask_split(B, imgs.device, mask_ratio)
        tok = self.embed(imgs).flatten(2).transpose(1, 2)  # (B, npatch, dim)
        bv = vis.unsqueeze(-1).expand(-1, -1, tok.shape[-1])
        bm = msk.unsqueeze(-1).expand(-1, -1, tok.shape[-1])
        z_ctx = self.enc(torch.gather(tok, 1, bv))          # visible only
        if no_sg:
            # no-stop-gradient control: shared online encoder on the target
            # side, gradients flow through the target path as well
            z_tgt = self.enc(torch.gather(tok, 1, bm))
        else:
            with torch.no_grad():
                z_tgt = self.enc_t(torch.gather(tok, 1, bm))  # masked only
        # predictor: mask-token embedding at masked positions
        mask_tok = tok.mean(dim=1, keepdim=True) * 0 + self.embed.weight.norm() * 0.01
        inp = mask_tok.expand(B, msk.shape[1], tok.shape[-1]) + self.pred[0].weight.norm() * 0
        pred = self.pred(inp)
        loss = F.mse_loss(pred, z_tgt)
        return loss


def run_config(name, model, batch, steps, warmup, lr=1.5e-4, mask_ratio=0.75,
               in_dim=784, img=None, ema=0.996, no_sg=False):
    dev = torch.device("cpu")
    if img is not None:
        imgs = torch.randn(batch, 3, img, img)
    else:
        x_ctx = torch.randn(batch, in_dim)
        x_tgt = torch.randn(batch, in_dim)
    opt = torch.optim.Adam(
        [p for p in model.parameters() if p.requires_grad], lr=lr)
    tps = [p for p in model.enc_t.parameters()] if hasattr(model, "enc_t") else []
    t_map = dict(model.enc_t.named_parameters()) if hasattr(model, "enc_t") else {}
    o_map = dict(model.enc.named_parameters()) if hasattr(model, "enc") else {}

    def ema_update():
        with torch.no_grad():
            for k, pt in t_map.items():
                pt.mul_(ema).add_(o_map[k].data, alpha=1 - ema)

    def one():
        opt.zero_grad(set_to_none=True)
        if img is not None:
            loss = model.step(imgs, mask_ratio, no_sg=no_sg)
        else:
            loss = model(x_ctx, x_tgt)
        loss.backward()
        opt.step()
        ema_update()

    for _ in range(warmup):
        one()
    t0 = time.perf_counter()
    for _ in range(steps):
        one()
    dt = time.perf_counter() - t0
    sps = steps / dt
    nparam = sum(p.numel() for p in model.parameters() if p.requires_grad)
    return {"config": name, "batch": batch, "steps": steps, "seconds": round(dt, 2),
            "steps_per_s": round(sps, 2), "ms_per_step": round(1000 * dt / steps, 1),
            "trainable_params_M": round(nparam / 1e6, 2)}


CONFIGS = {
    # theory vehicle: linear JEPA, synthetic data
    "lin_784_256": lambda: (LinearJEPA(), dict(in_dim=784, img=None)),
    # Tier-B-like small ViT on synthetic 16x16 (patch 4 -> 16 patches)
    "vit_d128_L4_p16_b256": lambda: (ViTJEPA(img=16, patch=4, dim=128, depth=4, heads=4,
                                             pred_dim=32, pred_depth=2),
                                     dict(in_dim=None, img=16)),
    # ViT JEPAs at CIFAR-10 scale, I-JEPA-like shapes
    "vit_d192_L6_p64_b256": lambda: (ViTJEPA(dim=192, depth=6, heads=3),
                                     dict(in_dim=None, img=32)),
    "vit_d192_L12_p64_b256": lambda: (ViTJEPA(dim=192, depth=12, heads=3),
                                      dict(in_dim=None, img=32)),
    "vit_d256_L8_p64_b128": lambda: (ViTJEPA(dim=256, depth=8, heads=4),
                                     dict(in_dim=None, img=32)),
}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--steps", type=int, default=100)
    ap.add_argument("--warmup", type=int, default=15)
    ap.add_argument("--threads", type=int, nargs="*", default=[8])
    ap.add_argument("--configs", nargs="*", default=list(CONFIGS))
    ap.add_argument("--batch", type=int, default=256)
    ap.add_argument("--mask", type=float, default=0.75)
    ap.add_argument("--nosg", action="store_true",
                    help="no-stop-gradient control (shared online encoder, grads through target path)")
    ap.add_argument("--out", default="-")
    a = ap.parse_args()
    res = {"torch": torch.__version__, "mask_ratio": a.mask, "no_sg": a.nosg,
           "results": []}
    for th in a.threads:
        set_threads(th)
        for cfg in a.configs:
            model, kw = CONFIGS[cfg]()
            batch = a.batch if kw["img"] else a.batch
            r = run_config(f"{cfg}__th{th}", model, batch, a.steps, a.warmup,
                           mask_ratio=a.mask, no_sg=a.nosg, **kw)
            r["threads"] = th
            res["results"].append(r)
            print(json.dumps(r), flush=True)
    if a.out != "-":
        with open(a.out, "w") as f:
            json.dump(res, f, indent=1)
    else:
        print(json.dumps(res, indent=1))


if __name__ == "__main__":
    main()
