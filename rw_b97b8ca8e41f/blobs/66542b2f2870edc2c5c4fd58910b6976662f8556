"""Table: reductions to and departures from the closest prior spectral accounts.

Source: paper-repo notes/prior_comparison.md @ 45cf7f9 (answer to paper-repo#5);
derivations in paper-repo appendix/proofs.tex, subsection app:prior. Every cell is
paper-repo's statement, transcribed verbatim; presentation writes none of them.
Evidence is a proof or the mode-ODE numerical check (app:survival), not a
measurement on trained JEPAs. Cells use \\citet/\\cref and the paper's macros, so the
fragment compiles only inside the paper (tools/check.py stubs them).
"""
import pathlib

ROWS = [
    # account, setting, reduces to / agrees, departs / new, evidence
    (r"\citet{tian2021understanding} (DirectPred)",
     r"Linear BYOL/SimSiam, trained linear predictor, EMA or stop-grad, weight decay, isotropic augmentation",
     r"\cref{prop:decouple,prop:window} with $s_j=1$, $c_j=1+\sigma^2$, $\lambda=\alpha\lambda_P$: "
     r"their eigenmode ODE and weight-decay threshold",
     r"Masking makes $s_j,c_j$ direction-dependent; predictor drift gives survival $\Phi_j>0$ and $\hat R$",
     r"Proof (\cref{app:prior}); stop-grad: \cref{prop:stopgrad}"),
    (r"\citet{wang2021demystify}",
     r"Linear network, predictor set from statistics (DirectPred/DirectCopy), weight decay, augmentation noise",
     r"Two-view noise model: $\rho_js_j>4\lambda$ discards high-augmentation-variance directions, as they prove",
     r"Trained predictor drifts through the window; masking-induced $s_j,c_j$; rank prediction",
     r"Proof (\cref{app:prior})"),
    (r"\citet{littwin2024jepa}",
     r"Deep linear JEPA encoder, linear predictor, stop-grad, no weight decay, small init",
     r"$\lambda=\lambda_P=0$: window $(0,\rho_j)$ never closes; predictor $\to\rho_j$, their regression coefficient",
     r"Weight decay closes windows, so directions can die; their encoder-depth ordering not derived",
     r"Proof (\cref{app:prior})"),
    (r"\citet{ziyin2023shapes}",
     r"Loss landscape of linear SSL objectives with weight decay near the origin",
     r"Count of directions with $\rho_js_j>4\lambda$ = stationary-point (landscape-type) collapse threshold",
     r"Dynamical: which basin a small-init trajectory reaches; fixed-point count over-predicts rank",
     r"Mode-ODE check: 297 vs 183 of 300 (\cref{app:survival})"),
    (r"\citet{simon2023stepwise}",
     r"Linearized Barlow Twins, no predictor, small initialization, stepwise eigenmode learning",
     r"$\lambda_P\to0$: onset time $\log(w/\varepsilon_j)/r_j(p_0)$, log in init scale, one mode at a time",
     r"With $\lambda_P>0$ onset is finite only if $\Phi_j>0$; late modes never learned",
     r"Proof (\cref{app:prior}, phase I of \cref{app:survival})"),
    (r"\citet{zhuo2023rank}",
     r"BYOL/\allowbreak SimSiam/\allowbreak DINO-type asymmetric branches; rank difference between branch outputs",
     r"Online and target outputs differ by $p_j$ per direction, so ranks differ when $p_j$ varies",
     r"No derived sign of the rank difference; our mechanism is early-time drive vs decay",
     r"None derived"),
    (r"\citet{halvagal2023implicit}",
     r"Linear non-contrastive SSL, eigenmode analysis of predictor eigenvalues",
     r"Predictor gain $p_j$ sets each direction's drive $p_js_j$ and decay $p_j^2c_j$",
     r"Weight decay and predictor drift set a finite growth window",
     r"Proof (\cref{prop:decouple})"),
    (r"\citet{wen2022head}",
     r"Nonlinear two-layer network with prediction head, feature-learning analysis",
     r"The head is necessary: with $p_j=0$ (no predictor along $j$) no direction is driven, $r_j=-\lambda$",
     r"Per-direction quantitative criterion; masking and depth terms",
     r"Proof (predictor width, \cref{sec:heuristics})"),
]

WIDTHS = (0.12, 0.20, 0.25, 0.22, 0.12)  # fractions of \linewidth; + 4 gaps of 2*4pt
HEAD = ("Account", "Setting", "Reduces to / agrees", "Departs / new", "Evidence")

spec = "".join(r"p{%.2f\linewidth}" % w for w in WIDTHS)  # no array package in the paper
lines = [
    r"\setlength{\tabcolsep}{4pt}",
    r"\begin{tabular}{@{}" + spec + r"@{}}",
    r"\toprule",
    " & ".join(r"\raggedright " + c for c in HEAD) + r" \tabularnewline",
    r"\midrule",
]
for i, row in enumerate(ROWS):
    if i:
        lines.append(r"\addlinespace[3pt]")
    lines.append(" & ".join(r"\raggedright " + c for c in row) + r" \tabularnewline")
lines += [r"\bottomrule", r"\end{tabular}", ""]

out = pathlib.Path(__file__).resolve().parents[2] / "tables" / "tab_prior_comparison.tex"
out.write_text("% Generated by figures/src/tab_prior_comparison.py -- do not edit by hand.\n"
               + "\n".join(lines))
print(out)
