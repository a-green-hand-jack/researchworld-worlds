"""P6 (C6): transfer of the early-window statistic to a small vision JEPA on real
images (Tier C), with the frozen-backbone linear probe as a sanity check.

Input: experiment-repo (commit in data.py)
  results/raw/vit_runs/c_*/{summary,trajectory}_seed<N>.csv and data_provenance.json
  (Tier C, CIFAR-10 from the pinned Hugging Face uoft-cs/cifar10 parquet), and
  results/derived/vit_transfer_diagnostics.csv (Tier B and C, one row per run).
Model: ViT d192/L6, 64 patches, predictor d64/L2, batch 256, 50 epochs (9,800 steps).
Masks: each patch hidden independently with probability mask_fraction (expected
fraction, Bernoulli per patch, not contiguous blocks).
Rank: numerical rank, eigenvalues of the online encoder's embedding covariance
(512 images, one fixed context mask per seed) at least 1e-3 of the largest.
(a) online rank against step, per seed (thin) and seed mean (thick); shaded: the
    early window, steps 25-250.
(b) early statistic against late rank, one point per run: the count of aligned
    eigen-directions with positive log-slope over steps 25-250
    (early_positive_unfiltered = summary early_predicted_rank) and the same count
    restricted to directions whose step-25 eigenvalue is at least 1e-3 of the largest
    (early_positive_above_1e3_floor). Neither is a linear-theory prediction
    (results/README.md, nonlinear early-rate sensitivity). Dashed: identity.
(c) test accuracy of a RidgeClassifier(alpha=1) on the frozen, mean-pooled online
    encoder (full images, all 50,000 train / 10,000 test rows), per seed and mean;
    when summaries carry probe_accuracy_init: the same probe on the same-seed
    untrained encoder (open markers, dashed mean), joined to its trained run;
    dotted: chance (0.1). Where a configuration has >= 2 seeds: the paired gain
    trained - init (mean over seeds, percentage points) with its 95% t-interval.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
import style, data

style.apply()
R = data.results()
s, t = data.vit_runs("C_real_cifar10")
diag = pd.read_csv(R / "derived" / "vit_transfer_diagnostics.csv")
# P6 compares the trained probe with the same-seed untrained encoder (experiment-repo
# code/add_init_probe.py); drawn once every committed Tier C run carries it.
HAS_INIT = bool("probe_accuracy_init" in s and s.probe_accuracy_init.notna().all())
assert (s.epochs == 50).all() and (s.steps == s.late_checkpoint_step).all()
prov = {c: json.loads((R / "raw" / "vit_runs" / c / "data_provenance.json").read_text())
        for c in s.config_id.unique()}
# config: (label, color, marker, line style); low/high levels share a hue
CFG = {
    "c_reference": ("reference", "#555555", "o", "-"),
    "c_scale_low": ("pred. scale 0.5", style.COLORS[0], "v", "--"),
    "c_scale_high": ("pred. scale 2", style.COLORS[0], "^", "-"),
    "c_mask_low": ("mask frac. .25", style.COLORS[1], "v", "--"),
    "c_mask_high": ("mask frac. .75", style.COLORS[1], "^", "-"),
    "c_ema_slow": ("EMA $\\tau=.999$", style.COLORS[2], "^", "-"),
}
NMAX = 192
X0 = 12  # where step 0 is drawn on the log axis

fig, (a, b, c) = plt.subplots(1, 3, figsize=(style.TEXTWIDTH, 2.1),
                              gridspec_kw=dict(width_ratios=[1.2, 1, 0.95], wspace=0.38))
a.axvspan(25, 250, color="#eeeeee", lw=0, zorder=0)
for cid, (lab, col, mk, ls) in CFG.items():
    tr = t[t.config_id == cid]
    if tr.empty:
        continue
    per = tr.groupby(["seed", "step"]).numerical_rank.first().unstack("seed")
    x = np.where(per.index == 0, X0, per.index)
    for seed in per.columns:
        a.plot(x, per[seed], color=col, ls=ls, lw=0.5, alpha=0.6)
    a.plot(x, per.mean(axis=1), color=col, ls=ls, lw=1.4, label=f"{lab} ($n$={per.shape[1]})")
a.set_xscale("log")
a.set_xlim(X0 * 0.85, 12000)
a.set_xticks([X0, 25, 250, 9800])
a.set_xticklabels(["0", "25", "250", "9800"])
a.xaxis.set_minor_locator(plt.NullLocator())
a.set_ylim(0, NMAX)
a.set_xlabel("step (196 per epoch)", labelpad=1)
a.set_ylabel("online rank")
a.legend(loc="upper left", handlelength=1.4, borderaxespad=0.1, labelspacing=0.15, fontsize=6.5)
a.set_title("(a) rank over training", loc="left", pad=3)

d = diag.copy()
b.axhline(NMAX, color="#bbbbbb", lw=0.6, zorder=1)
b.plot([0, NMAX], [0, NMAX], color=style.THEORY, ls="--", lw=0.8, zorder=1)
for tier, sub in d.groupby("tier"):
    for _, r in sub.iterrows():
        if tier == "B_controlled":
            col, mk, z = "#aaaaaa", "o", 2
        else:
            _, col, mk, _ = CFG[r.config_id]
            z = 3
        b.scatter(r.late_numerical_rank, r.early_positive_unfiltered, s=12, marker=mk,
                  facecolor="white", edgecolor=col, lw=0.8, zorder=z)
        b.scatter(r.late_numerical_rank, r.early_positive_above_1e3_floor, s=12, marker=mk,
                  facecolor=col, edgecolor=col, lw=0.8, zorder=z)
b.set_xlim(0, NMAX)
b.set_xticks([0, 50, 100, 150])
b.set_ylim(0, 250)  # headroom above the 192 directions for the legend
b.set_yticks([0, 50, 100, 150, NMAX])
b.set_xlabel("late rank", labelpad=1)
b.set_ylabel("early positive count", labelpad=1)
b.set_title("(b) early statistic (P6)", loc="left", pad=3)
nb, nc = (d.tier == "B_controlled").sum(), (d.tier == "C_real_cifar10").sum()
b.legend(handles=[
    Line2D([], [], ls="", marker="o", mfc="white", mec="#555555", label="all directions"),
    Line2D([], [], ls="", marker="o", mfc="#555555", mec="#555555", label="resolved at step 25"),
    Line2D([], [], ls="", marker="o", mfc="#aaaaaa", mec="#aaaaaa", label=f"Tier B ({nb} runs)"),
], loc="upper left", handletextpad=0.2, labelspacing=0.15,
    fontsize=6.5, borderaxespad=0.1)

ids = list(CFG)
gains = []
for i, cid in enumerate(ids):
    lab, col, mk, _ = CFG[cid]
    r = s[s.config_id == cid]
    if r.empty:
        c.text(i, 0.02, "–", ha="center", va="bottom", fontsize=6.5, color="#999999")
        continue
    y = r.probe_accuracy.to_numpy()
    jit = (np.arange(len(y)) - (len(y) - 1) / 2) * 0.06
    if HAS_INIT:
        # paired by seed: same-seed untrained encoder (open) -> trained (filled)
        y0 = r.probe_accuracy_init.to_numpy()
        for k in range(len(y)):
            c.plot([i - 0.17 + jit[k], i + 0.17 + jit[k]], [y0[k], y[k]], color=col, lw=0.5,
                   alpha=0.6, zorder=2)
        c.scatter(i - 0.17 + jit, y0, s=10, marker=mk, facecolor="white", edgecolor=col,
                  linewidth=0.7, zorder=3)
        c.plot([i - 0.32, i - 0.02], [y0.mean()] * 2, color=col, lw=1.0, ls="--", zorder=2)
        x1 = i + 0.17 + jit
        c.plot([i + 0.02, i + 0.32], [y.mean()] * 2, color=col, lw=1.4, zorder=2)
        if len(y) >= 2:
            # paired gain trained - init, mean and 95% t-interval over seeds
            g = y - y0
            h = stats.t.ppf(0.975, len(g) - 1) * g.std(ddof=1) / np.sqrt(len(g))
            gains.append((cid, len(g), g.mean(), g.mean() - h, g.mean() + h))
            c.text(i, max(y.max(), y0.max()) + 0.02,
                   f"$\\Delta${100 * g.mean():+.1f} pp"
                   + (f" ($n$={len(g)})" if len(g) < 3 else "")
                   + f"\n[{100 * (g.mean() - h):.1f}, {100 * (g.mean() + h):.1f}]",
                   rotation=90, ha="center", va="bottom", fontsize=5.5, color="#333333",
                   linespacing=1.0)
    else:
        x1 = i + jit
        c.plot([i - 0.25, i + 0.25], [y.mean()] * 2, color=col, lw=1.4, zorder=2)
    c.scatter(x1, y, s=10, marker=mk, color=col, zorder=3)
    if len(y) < 3 and not (HAS_INIT and len(y) >= 2):  # else n is in the gain label
        c.text(i, y.max() + 0.02, f"{len(y)}", ha="center", va="bottom", fontsize=6.5,
               color="#555555")
c.axhline(0.1, color="#555555", ls=":", lw=0.8)
if HAS_INIT:
    c.legend(handles=[
        Line2D([], [], ls="", marker="o", mfc="white", mec="#555555", label="init (step 0)"),
        Line2D([], [], ls="", marker="o", mfc="#555555", mec="#555555", label="trained"),
    ], loc="lower right", bbox_to_anchor=(1, 0.13), handletextpad=0.2, labelspacing=0.15,
        fontsize=6.5, borderaxespad=0.1)
c.set_xticks(range(len(ids)))
c.set_xticklabels([CFG[i][0] for i in ids], rotation=40, ha="right", rotation_mode="anchor",
                  fontsize=6.5)
c.set_xlim(-0.6, len(ids) - 0.4)
c.set_ylim(0, 0.7)  # headroom for the paired-gain labels
c.set_ylabel("probe test accuracy", labelpad=1)
c.grid(axis="x", visible=False)
c.set_title("(c) frozen linear probe", loc="left", pad=3)
style.save(fig, "fig_realdata")

for cid, p in prov.items():
    dd = p["data"]
    assert dd["source_revision"] == "0b2714987fa478483af9968de7c934580d0bb9a2", cid
    assert (dd["train_rows"], dd["test_rows"]) == (50000, 10000), cid
    print(cid, dd["source"], dd["source_revision"], dd["train_rows"], dd["test_rows"])
print(s[["config_id", "seed", "late_numerical_rank", "late_effective_rank", "late_target_numerical_rank",
         "early_predicted_rank", "probe_accuracy"] + ["probe_accuracy_init"] * HAS_INIT].to_string(index=False))
print(pd.DataFrame(gains, columns=["config_id", "n", "gain", "ci_lo", "ci_hi"]).round(4).to_string(index=False))
print(d[["tier", "config_id", "seed", "early_positive_unfiltered", "early_positive_above_1e3_floor",
         "late_numerical_rank"]].to_string(index=False))
