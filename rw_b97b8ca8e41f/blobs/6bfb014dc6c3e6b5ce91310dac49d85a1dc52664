def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config-id", required=True)
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--data-root", type=Path, default=Path("data/cifar10"))
    parser.add_argument("--output-root", type=Path, default=Path("results/raw/vit_runs"))
    parser.add_argument("--steps", type=int, default=None, help="override Tier-B steps for a pilot")
    parser.add_argument("--epochs", type=int, default=None, help="override Tier-C epochs for a pilot")
    args = parser.parse_args()
    config = config_by_id(args.config_id)
    if args.steps is not None:
        if config.tier != "B_controlled":
            raise ValueError("--steps is only valid for Tier B")
        config = replace(config, steps=args.steps)
    if args.epochs is not None:
        if config.tier != "C_real_cifar10":
            raise ValueError("--epochs is only valid for Tier C")
        config = replace(config, epochs=args.epochs)
    if config.tier == "B_controlled":
        data = controlled_data()
        data_metadata = {"dataset": "generated controlled Fourier-pattern images", "seed": 0}
    else:
        data = cifar_data(args.data_root)
        data_metadata = data[-1]
        data = data[:4]
    output_directory = args.output_root / config.config_id
    train(config, args.seed, data, output_directory)
    with (output_directory / "data_provenance.json").open("w", encoding="utf-8") as handle:
        json.dump(
            {
                "config_id": config.config_id,
                "tier": config.tier,
                "data": data_metadata,
                "python": sys.version,
                "torch": torch.__version__,
                "numpy": np.__version__,
                "pyarrow": __import__("pyarrow").__version__,
                "pillow": Image.__version__,
                "platform": platform.platform(),
                "masking": {
                    "sampler": MASK_SAMPLER,
                    "geometry": MASK_GEOMETRY,
                    "fraction_semantics": MASK_FRACTION_SEMANTICS,
                    "training_policy": TRAINING_MASK_POLICY,
                    "rank_evaluation_policy": RANK_EVALUATION_MASK_POLICY,
                    "rank_evaluation_sampler": MASK_SAMPLER,
                },
            },
            handle,
            indent=2,
            sort_keys=True,
        )
        handle.write("\n")
    print(json.dumps({"config_id": config.config_id, "seed": args.seed, "status": "PASS"}, sort_keys=True))


if __name__ == "__main__":
    main()
