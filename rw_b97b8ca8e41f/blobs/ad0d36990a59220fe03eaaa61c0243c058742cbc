"""P1 (C1), the mechanism in data: per-direction eigenvalue trajectories of a
linear JEPA at the reference configuration.

Input: experiment-repo results/raw/trajectories.csv.gz (commit in data.py),
config_id scale_p0p500 (p0=0.5, lambda=lambda_P=0.005, alpha=1, m=0.65, 16 dims).
(a) representation_eigenvalue mu_j vs time for every direction of seed 0;
(b) the same directions in the (predictor_amplitude p_j, mode_amplitude w_j) plane,
for comparison with fig_mechanism (b).
Survival: final mu_j >= 1e-2 * max_j mu_j and above its own initial value (the
collapse-aware rank of results/README.md).
Color: the direction's context-target covariance s_j (cross_covariance at step 0).
The survivor set is checked to be identical in all 8 seeds.
"""
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm
import style, data

style.apply()
CFG, SEED = "scale_p0p500", 0
t = pd.read_csv(data.results() / "raw" / "trajectories.csv.gz", low_memory=False)
t = t[t.config_id == CFG]
last = t[t.step == t.step.max()].pivot(index="seed", columns="direction_index",
                                        values="representation_eigenvalue")
first = t[t.step == 0].pivot(index="seed", columns="direction_index",
                                values="representation_eigenvalue")
surv_all = last.ge(1e-2 * last.max(axis=1), axis=0) & (last > first)
assert (surv_all.nunique() == 1).all(), "survivor set differs across seeds"
alive = surv_all.iloc[0].to_numpy()
n_seeds = len(last)

s0 = t[t.seed == SEED].sort_values(["direction_index", "step"])
dirs = sorted(s0.direction_index.unique())
sj = s0[s0.step == 0].set_index("direction_index").cross_covariance.reindex(dirs).to_numpy()
norm = TwoSlopeNorm(vcenter=0.0, vmin=sj.min(), vmax=sj.max())  # white = no drive
cmap = plt.get_cmap(style.DIV_CMAP)

fig, (a, b) = plt.subplots(1, 2, figsize=(style.TEXTWIDTH, 2.0),
                           gridspec_kw=dict(width_ratios=[1.25, 1], wspace=0.32))
for k, j in enumerate(dirs):
    g = s0[s0.direction_index == j]
    col, ls = cmap(norm(sj[k])), ("-" if alive[k] else ":")
    lw = 1.1 if alive[k] else 0.8
    gt = g[g.time > 0]
    a.plot(gt.time, gt.representation_eigenvalue, ls=ls, color=col, lw=lw, marker="o", ms=1.6)
    b.plot(g.predictor_amplitude, g.mode_amplitude, ls=ls, color=col, lw=lw, marker="o", ms=1.6)
a.set_xscale("log"); a.set_yscale("log")
a.set_xlabel(r"time $t$ (steps $\times\eta$)"); a.set_ylabel(r"eigenvalue $\mu_j$")
a.set_title(f"(a) {alive.sum()} of {len(dirs)} directions survive (seed {SEED})", loc="left")
a.axvspan(0.1, 5.0, color="#eeeeee", lw=0, zorder=0)
a.text(0.7, 0.03, "rate-fit\nwindow", transform=a.get_xaxis_transform(), fontsize=6.5, ha="center")
b.set_yscale("log")
b.set_xlabel(r"predictor eigenvalue $p_j$"); b.set_ylabel(r"mode amplitude $w_j$")
b.set_title(r"(b) trajectories in $(p_j, w_j)$", loc="left")
p0 = s0[s0.step == 0]
b.scatter(p0.predictor_amplitude.iloc[:1], p0.mode_amplitude.median(), s=14, color="k", zorder=5)
b.annotate("init", (p0.predictor_amplitude.iloc[0], p0.mode_amplitude.median()),
           xytext=(4, -9), textcoords="offset points", fontsize=6.5)
from matplotlib.lines import Line2D
b.legend([Line2D([], [], color="0.3", ls="-"), Line2D([], [], color="0.3", ls=":")],
         ["survives", "collapses"], loc="lower right", fontsize=6.5)
sm = plt.cm.ScalarMappable(norm=norm, cmap=cmap)
cb = fig.colorbar(sm, ax=b, pad=0.02, fraction=0.06)
cb.set_label(r"context-target covariance $s_j$", fontsize=7); cb.ax.tick_params(labelsize=6.5)
style.save(fig, "fig_trajectories")
print("survivors", np.flatnonzero(alive), "seeds", n_seeds, "s_j", np.round(sj, 3))
