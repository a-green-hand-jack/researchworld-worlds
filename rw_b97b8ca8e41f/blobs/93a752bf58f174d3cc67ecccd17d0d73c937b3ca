"""Table: what each anti-collapse heuristic changes in the drive/decay balance.

Source: paper-repo sections/theory.tex and appendix/proofs.tex @ 80bb79c
(Props. window, survival, stopgrad, masking; Cor. depth). These are the theory's
qualitative predictions. The table is theory-only at paper-repo's request
(figtab-repo#2, 9-page body): the measured counterparts are in the paper's Sec. 5,
App. C and figures/fig_phase.pdf.
"""
import pathlib

ROWS = [
    # heuristic, what changes in r_j = p s_j - (p^2 c_j + lambda), predicted effect on rank
    (r"Stop-gradient on target",
     r"removing it adds $c^{t}_j - p\,s_j$ to the decay; the total rate "
     r"$-[c_j(p-\rho_j)^2 + c^{t}_j-\rho_j s_j+\lambda]$ is negative for every $p$ "
     r"($c^{t}_j\ge\rho_j s_j$)",
     r"without it every direction collapses"),
    (r"Encoder weight decay $\lambda$ (direct L2)",
     r"adds $\lambda$ to the decay of every direction",
     r"rank $\le \#\{j: \rho_j s_j > 4\lambda\}$; $\Phi_j$ decreases with $\lambda$"),
    (r"Predictor init.\ scale $p_0$",
     r"below $p^-_j$ the window is never entered; far above $p^+_j$, "
     r"$\tfrac{c_j}{2}p_0^2/(\alpha\lambda_P)$ of log-amplitude is lost before entering it",
     r"non-monotone in $p_0$"),
    (r"Predictor lr $\alpha$",
     r"near collapse $p_j$ drifts out of the window at rate $\alpha\lambda_P$; "
     r"a faster predictor reaches the nullcline at lower amplitude",
     r"falls with $\alpha$ at fixed decay coefficient $\lambda_P$; "
     r"rises with $\alpha$ at fixed decay rate $\alpha\lambda_P$"),
    (r"Predictor weight decay $\lambda_P$",
     r"raises the drift rate $\alpha\lambda_P$ out of the window",
     r"lowers rank under either convention"),
    (r"Predictor depth $L$",
     r"balanced $L$-layer predictor: near collapse the gain decays at rate $L\alpha\lambda_P$",
     r"at fixed initial gain $p_0$, deeper predictors close the window $L\times$ faster: lower rank"),
    (r"Predictor width $k$",
     r"$p_j=0$ outside the predictor's range, so $r_j=-\lambda$",
     r"rank $\le k$"),
    (r"Masking ratio $m$",
     r"changes $s_k, c_k$; only directions with above-average power ($S_k>\sigma^2$) "
     r"are driven, and the drive vanishes at $m=0$ and $m=1$",
     r"below-average-power directions are never kept; rank is low at both extremes of $m$"),
    (r"EMA target ($\tau$)",
     r"same window; lowers the growth rate inside it and the predictor's signal "
     r"$w_j\bar w_j s_j$ (acts like a smaller gain)",
     r"same existence condition; lowers $\Phi_j$, so no higher rank (linear model)"),
]

lines = [
    r"\begin{tabular}{@{}p{0.2\linewidth}p{0.42\linewidth}p{0.32\linewidth}@{}}",
    r"\toprule",
    r"Heuristic & Effect on drive $p\,s_j$ vs.\ decay $p^2c_j+\lambda$ & Predicted effect on rank \tabularnewline",
    r"\midrule",
]
for i, (h, mech, eff) in enumerate(ROWS):
    if i:
        lines.append(r"\addlinespace[3pt]")
    lines.append(f"\\raggedright {h} & \\raggedright {mech} & \\raggedright {eff} \\tabularnewline")
lines += [r"\bottomrule", r"\end{tabular}", ""]

out = pathlib.Path(__file__).resolve().parents[2] / "tables" / "tab_heuristics.tex"
out.write_text("% Generated by figures/src/tab_heuristics.py -- do not edit by hand.\n"
               + "\n".join(lines))
print(out)
