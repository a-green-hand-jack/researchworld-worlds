        "config_id": config.config_id,
        "seed": seed,
        "architecture": config.architecture,
        "mask_fraction": config.mask_fraction,
        "predictor_scale": config.predictor_scale,
        "predictor_width": config.predictor_width,
        "ema_tau": config.ema_tau,
        "predictor_lr_ratio": config.predictor_lr_ratio,
        "predictor_weight_decay": config.predictor_weight_decay,
        "predictor_depth": config.predictor_depth,
        "signal_scale": config.signal_scale,
        "weight_decay": config.weight_decay,
        "learning_rate": config.learning_rate,
        "steps": config.steps,
        "data_dimension": config.data_dimension,
        "embedding_dimension": config.embedding_dimension,
        "initial_weight": config.initial_weight,
        "rank_threshold": RANK_THRESHOLD,
        "step": step,
        "time": step * config.learning_rate,
        "status": "final",
        "covariance_model": config.covariance_model,
    }


def trajectory_rows_reduced(
    config: ExperimentConfig,
    seed: int,
    step: int,
    weights: np.ndarray,
    predictors: np.ndarray,
    target_weights: np.ndarray,
    covariances: dict[str, np.ndarray],
    prediction: dict[str, Any],
) -> list[dict[str, Any]]:
    context_variance = covariances["context_variance"]
    target_variance = covariances["target_variance"]
    cross_covariance = covariances["cross_covariance"]
    frequency = covariances["frequency"]
    representation_eigenvalues, predictor_eigenvalues, target_eigenvalues = snapshot_reduced(
        weights, predictors, target_weights, context_variance, target_variance
    )
    rows: list[dict[str, Any]] = []
    for mode_index in range(len(weights)):
        row = common_metadata(config, seed, step)
        row.update(
            {
                "direction_index": mode_index,
                "frequency": frequency[mode_index],
                "context_variance": context_variance[mode_index],
                "target_variance": target_variance[mode_index],
                "cross_covariance": cross_covariance[mode_index],
                "theory_correlation": covariances["correlation"][mode_index],
                "theory_root_lower": prediction["root_lower"][mode_index],
                "theory_root_upper": prediction["root_upper"][mode_index],
                "theory_fixed_point_eligible": bool(prediction["fixed_point_eligible"][mode_index]),
                "theory_initial_rate": prediction["initial_rate"][mode_index],
                "theory_max_cumulative_gain": prediction["maximum_cumulative_gain"][mode_index],
                "theory_early_gain_survival": bool(prediction["early_gain_survival"][mode_index]),
                "mode_amplitude": abs(weights[mode_index]),
                "target_mode_amplitude": abs(target_weights[mode_index]),
                "predictor_amplitude": abs(predictors[mode_index]),
                "representation_eigenvalue": representation_eigenvalues[mode_index],
                "predictor_eigenvalue": predictor_eigenvalues[mode_index],
                "target_representation_eigenvalue": target_eigenvalues[mode_index],
                "measured_growth_rate": (
                    predictors[mode_index] * cross_covariance[mode_index]
                    - predictors[mode_index] ** 2 * context_variance[mode_index]
                    - config.weight_decay
                ),
            }
        )
        rows.append(row)
    return rows


def simulate_reduced(
    config: ExperimentConfig,
    seed: int,
    covariances: dict[str, np.ndarray],
    theory: dict[str, Any],
) -> SimulationResult:
    random_generator = np.random.default_rng(seed)
    context_variance = covariances["context_variance"]
    target_variance = covariances["target_variance"]
    cross_covariance = covariances["cross_covariance"]
    weights = config.initial_weight * np.exp(
        config.initial_lognoise * random_generator.normal(size=config.data_dimension)
    )
    target_weights = weights.copy()
    initial_representation_eigenvalues = weights**2 * context_variance
    predictor_factors: np.ndarray | None = None
    if config.architecture == "shared_scalar":
        predictor_state = float(config.predictor_scale)
        predictors = np.full(config.data_dimension, predictor_state, dtype=float)
    elif config.architecture == "deep":
        factor_scale = config.predictor_scale ** (1.0 / config.predictor_depth)
        predictor_factors = np.full(config.data_dimension, factor_scale, dtype=float)
        predictors = predictor_factors ** config.predictor_depth
    else:
        predictors = np.full(config.data_dimension, config.predictor_scale, dtype=float)
        if config.architecture == "bottleneck":
            predictors[config.predictor_width :] = 0.0
    trajectory_rows: list[dict[str, Any]] = []
    spectra_by_step: dict[int, np.ndarray] = {}
    checkpoints = set(CHECKPOINTS)
    for step in range(config.steps + 1):
        if step in checkpoints:
            representation_eigenvalues, _, _ = snapshot_reduced(
                weights, predictors, target_weights, context_variance, target_variance
            )
            spectra_by_step[step] = np.sort(representation_eigenvalues)[::-1]
            trajectory_rows.extend(
                trajectory_rows_reduced(
                    config, seed, step, weights, predictors, target_weights, covariances, theory
                )
            )
        if step == config.steps:
            break
        residual = predictors * weights * context_variance - target_weights * cross_covariance
        encoder_gradient = predictors * residual + config.weight_decay * weights
        if config.differentiate_target:
            encoder_gradient = (
                encoder_gradient
                + target_variance * weights
                - predictors * weights * cross_covariance
            )
        if config.architecture == "shared_scalar":
            predictor_gradient = config.predictor_lr_ratio * (
                float(np.mean(residual * weights))
                + config.predictor_weight_decay * predictor_state
            )
            predictor_state -= config.learning_rate * predictor_gradient
            predictors.fill(predictor_state)
        elif config.architecture == "deep":
            factor_gradient = config.predictor_lr_ratio * (
                predictor_factors ** (config.predictor_depth - 1)
                * residual * weights
                + config.predictor_weight_decay * predictor_factors
            )
            predictor_factors -= config.learning_rate * factor_gradient
            predictors = predictor_factors ** config.predictor_depth
        else:
            predictor_gradient = config.predictor_lr_ratio * (
                residual * weights + config.predictor_weight_decay * predictors
            )
            if config.architecture == "bottleneck":
                predictor_gradient[config.predictor_width :] = 0.0
            predictors -= config.learning_rate * predictor_gradient
            if config.architecture == "bottleneck":
                predictors[config.predictor_width :] = 0.0
        weights -= config.learning_rate * encoder_gradient
        target_weights = config.ema_tau * target_weights + (1.0 - config.ema_tau) * weights
    representation_eigenvalues, predictor_eigenvalues, target_eigenvalues = snapshot_reduced(
        weights, predictors, target_weights, context_variance, target_variance
    )
    summary = summary_from_spectra(
        config=config,
        seed=seed,
        representation_eigenvalues=representation_eigenvalues,
        predictor_eigenvalues=predictor_eigenvalues,
        target_eigenvalues=target_eigenvalues,
        theory=theory,
        initial_representation_eigenvalues=initial_representation_eigenvalues,
        mode_representation_eigenvalues=representation_eigenvalues,
    )
    return SimulationResult(trajectory_rows, summary, spectra_by_step)


def simulate_full(
    config: ExperimentConfig,
    seed: int,
    covariances: dict[str, np.ndarray],
    theory: dict[str, Any],
) -> SimulationResult:
    random_generator = np.random.default_rng(seed)
    context_variance = covariances["context_variance"]
    target_variance = covariances["target_variance"]
    cross_covariance = covariances["cross_covariance"]
    diagonal_weights = config.initial_weight * np.exp(config.initial_lognoise * random_generator.normal(size=config.data_dimension))
    encoder = np.diag(diagonal_weights)
    if config.off_diagonal_noise > 0.0:
        encoder += config.off_diagonal_noise * config.initial_weight * random_generator.normal(
            size=(config.embedding_dimension, config.data_dimension)
        )
    predictor = config.predictor_scale * np.eye(config.embedding_dimension)
    target_encoder = encoder.copy()
    initial_representation_spectrum, _, _ = snapshot_full(
        encoder, predictor, target_encoder, context_variance, target_variance
    )
    context_covariance = np.diag(context_variance)
    target_covariance = np.diag(target_variance)
    cross_covariance_matrix = np.diag(cross_covariance)
    trajectory_rows: list[dict[str, Any]] = []
    spectra_by_step: dict[int, np.ndarray] = {}
    checkpoints = set(CHECKPOINTS)
    for step in range(config.steps + 1):
        if step in checkpoints:
            representation_eigenvalues, predictor_eigenvalues, target_eigenvalues = snapshot_full(
                encoder, predictor, target_encoder, context_variance, target_variance
            )
            spectra_by_step[step] = representation_eigenvalues.copy()
            for direction_index in range(config.embedding_dimension):
                row = common_metadata(config, seed, step)
                row.update(
                    {
                        "direction_index": direction_index,
                        "frequency": np.nan,
                        "context_variance": np.nan,
                        "target_variance": np.nan,
                        "cross_covariance": np.nan,
                        "theory_correlation": np.nan,
                        "theory_root_lower": np.nan,
                        "theory_root_upper": np.nan,
                        "theory_fixed_point_eligible": np.nan,
                        "theory_initial_rate": np.nan,
                        "theory_max_cumulative_gain": np.nan,
                        "theory_early_gain_survival": np.nan,
                        "mode_amplitude": np.nan,
                        "target_mode_amplitude": np.nan,
                        "predictor_amplitude": np.nan,
                        "representation_eigenvalue": representation_eigenvalues[direction_index],
                        "predictor_eigenvalue": predictor_eigenvalues[direction_index],
                        "target_representation_eigenvalue": target_eigenvalues[direction_index],
                        "measured_growth_rate": np.nan,
                    }
                )
                trajectory_rows.append(row)
        if step == config.steps:
            break
        residual = predictor @ encoder @ context_covariance - target_encoder @ cross_covariance_matrix.T
        encoder_gradient = predictor.T @ residual + config.weight_decay * encoder
        predictor_gradient = residual @ encoder.T + config.predictor_weight_decay * predictor
        if config.differentiate_target:
            encoder_gradient = (
                encoder_gradient
                - predictor @ encoder @ cross_covariance_matrix.T
                + target_encoder @ target_covariance
            )
        encoder -= config.learning_rate * encoder_gradient
        predictor -= config.learning_rate * predictor_gradient
        target_encoder = config.ema_tau * target_encoder + (1.0 - config.ema_tau) * encoder
    representation_eigenvalues, predictor_eigenvalues, target_eigenvalues = snapshot_full(
        encoder, predictor, target_encoder, context_variance, target_variance
    )
    summary = summary_from_spectra(
        config=config,
        seed=seed,
        representation_eigenvalues=representation_eigenvalues,
        predictor_eigenvalues=predictor_eigenvalues,
        target_eigenvalues=target_eigenvalues,
        theory=theory,
        initial_representation_eigenvalues=initial_representation_spectrum,
        mode_representation_eigenvalues=representation_eigenvalues,
    )
    return SimulationResult(trajectory_rows, summary, spectra_by_step)


def summary_from_spectra(
    config: ExperimentConfig,
    seed: int,
    representation_eigenvalues: np.ndarray,
    predictor_eigenvalues: np.ndarray,
    target_eigenvalues: np.ndarray,
    theory: dict[str, Any],
    initial_representation_eigenvalues: np.ndarray | None = None,
    mode_representation_eigenvalues: np.ndarray | None = None,
) -> dict[str, Any]:
    summary = common_metadata(config, seed, config.steps)
    if initial_representation_eigenvalues is None or mode_representation_eigenvalues is None:
        collapse_aware_rank = 0
    else:
        final_modes = np.asarray(mode_representation_eigenvalues, dtype=float)
        initial_modes = np.asarray(initial_representation_eigenvalues, dtype=float)
        final_max = float(np.max(final_modes, initial=0.0))
        collapse_aware_rank = int(np.sum(
            (final_modes >= RANK_THRESHOLD * final_max) & (final_modes > initial_modes)
        )) if final_max > 0.0 else 0
    summary.update(
        {
            "final_effective_rank": effective_rank(representation_eigenvalues),
            "final_threshold_rank": threshold_rank(representation_eigenvalues),
            "final_predictor_effective_rank": effective_rank(predictor_eigenvalues),
            "final_target_effective_rank": effective_rank(target_eigenvalues),
            "final_representation_trace": float(np.sum(representation_eigenvalues)),
            "final_max_representation_eigenvalue": float(np.max(representation_eigenvalues, initial=0.0)),
            "final_absolute_rank": int(np.sum(representation_eigenvalues >= 1.0e-12)),
            "collapse_aware_rank": collapse_aware_rank,
            "collapsed": bool(np.max(representation_eigenvalues, initial=0.0) < 1.0e-12),
            "theory_fixed_point_rank": theory["fixed_point_rank"],
            "theory_initial_rate_rank": theory["initial_rate_rank"],
            "theory_early_gain_rank": theory["early_gain_rank"],
            "theory_required_gain": theory["required_gain"],
            "theory_predictor_decay_rate": theory["predictor_decay_rate"],
            "differentiate_target": config.differentiate_target,
            "signal_scale": config.signal_scale,
            "off_diagonal_noise": config.off_diagonal_noise,
        }
    )
    return summary


def add_prediction_rows(
    prediction_rows: list[dict[str, Any]],
    config: ExperimentConfig,
    covariances: dict[str, np.ndarray],
    theory: dict[str, Any],
) -> None:
    active_modes = np.ones(config.data_dimension, dtype=bool)
    if config.architecture == "bottleneck":
        active_modes[config.predictor_width :] = False
    for mode_index in range(config.data_dimension):
        prediction_rows.append(
            {
                "experiment": config.experiment,
                "config_id": config.config_id,
                "architecture": config.architecture,
                "mask_fraction": config.mask_fraction,
                "predictor_scale": config.predictor_scale,
                "predictor_width": config.predictor_width,
                "ema_tau": config.ema_tau,
                "predictor_lr_ratio": config.predictor_lr_ratio,
                "predictor_weight_decay": config.predictor_weight_decay,
                "predictor_depth": config.predictor_depth,
                "signal_scale": config.signal_scale,
                "weight_decay": config.weight_decay,
                "covariance_model": config.covariance_model,
                "learning_rate": config.learning_rate,
                "steps": config.steps,
                "direction_index": mode_index,
                "frequency": covariances["frequency"][mode_index],
                "context_variance": covariances["context_variance"][mode_index],
                "target_variance": covariances["target_variance"][mode_index],
                "cross_covariance": covariances["cross_covariance"][mode_index],
                "theory_correlation": covariances["correlation"][mode_index],
                "theory_discriminant": theory["discriminant"][mode_index],
                "theory_root_lower": theory["root_lower"][mode_index],
                "theory_root_upper": theory["root_upper"][mode_index],
                "theory_fixed_point_eligible": bool(theory["fixed_point_eligible"][mode_index]),
                "theory_initial_rate": theory["initial_rate"][mode_index],
                "theory_max_cumulative_gain": theory["maximum_cumulative_gain"][mode_index],
                "theory_early_gain_survival": bool(theory["early_gain_survival"][mode_index]),
                "theory_predictor_decay_rate": theory["predictor_decay_rate"],
                "predictor_active": bool(active_modes[mode_index]),
                "theory_model_scope": (
                    "modewise_reduced_model"
                    if config.architecture in {"diagonal", "bottleneck"}
                    else "modewise_reference_not_shared_predictor_solution"
                ),
            }
        )


def write_csv(path: Path, rows: Iterable[dict[str, Any]], fieldnames: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    opener = gzip.open if path.suffix == ".gz" else open
    with opener(path, "wt", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames, extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow(row)


def aggregate_metric(values: list[float]) -> tuple[float, float, float, float, float]:
    array = np.asarray(values, dtype=float)
    count = len(array)
    mean = float(np.mean(array)) if count else float("nan")
    standard_deviation = float(np.std(array, ddof=1)) if count > 1 else 0.0
    standard_error = standard_deviation / math.sqrt(count) if count else float("nan")
    margin = 1.96 * standard_error if count else float("nan")
    return mean, standard_deviation, standard_error, mean - margin, mean + margin


def primary_parameter(config: dict[str, Any]) -> tuple[str, str]:
    experiment = config["experiment"]
    if experiment == "predictor_scale":
        return "predictor_scale", str(config["predictor_scale"])
    if experiment == "masking":
        return "mask_fraction", str(config["mask_fraction"])
    if experiment == "target_ema":
        return "ema_tau", str(config["ema_tau"])
    if experiment == "predictor_design":
        if config["architecture"] == "bottleneck":
            return "predictor_width", str(config["predictor_width"])
        return "architecture", str(config["architecture"])
    if experiment == "stop_gradient_ablation":
        return "target_gradient", str(config["differentiate_target"])
    return "configuration", config["config_id"]


def make_claim_metrics(
    summaries: list[dict[str, Any]],
    comparisons: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    grouped: dict[tuple[str, str], list[dict[str, Any]]] = {}
    for summary in summaries:
        if summary["experiment"] == "ode_vs_full":
            continue
        grouped.setdefault((summary["experiment"], summary["config_id"]), []).append(summary)
    rows: list[dict[str, Any]] = []
    metric_specs = (
        ("final_threshold_rank", "realized_threshold_rank", "theory_early_gain_rank"),
        ("final_effective_rank", "realized_effective_rank", "theory_fixed_point_rank"),
    )
    for (experiment, config_id), group in sorted(grouped.items()):
        reference = group[0]
        parameter, parameter_value = primary_parameter(reference)
        for metric_name, output_name, theory_name in metric_specs:
            values = [float(item[metric_name]) for item in group]
            mean, standard_deviation, standard_error, ci_low, ci_high = aggregate_metric(values)
            theory_value = float(np.mean([item[theory_name] for item in group]))
            rows.append(
                {
                    "claim_id": {
                        "predictor_scale": "C3_predictor_scale",
                        "masking": "C4_masking",
                        "target_ema": "C5_target_ema",
                        "predictor_design": "C2_predictor_design",
                        "stop_gradient_ablation": "C6_stop_gradient",
                    }.get(experiment, "C1_rank_dynamics"),
                    "experiment": experiment,
                    "config_id": config_id,
                    "metric": output_name,
                    "parameter": parameter,
                    "parameter_value": parameter_value,
                    "n_seeds": len(values),
                    "mean": mean,
                    "std": standard_deviation,
                    "standard_error": standard_error,
                    "ci95_low": ci_low,
                    "ci95_high": ci_high,
                    "theory_prediction": theory_value,
                    "mean_minus_theory": mean - theory_value,
                    "status": "final",
                }
            )
    comparison_groups: dict[str, list[dict[str, Any]]] = {}
    for comparison in comparisons:
        comparison_groups.setdefault(comparison["config_id"], []).append(comparison)
    for config_id, group in sorted(comparison_groups.items()):
        for metric in ("final_rank_difference", "max_spectral_relative_error", "max_trajectory_relative_error"):
            values = [float(item[metric]) for item in group]
            mean, standard_deviation, standard_error, ci_low, ci_high = aggregate_metric(values)
            rows.append(
                {
                    "claim_id": "C1_reduced_vs_full",
                    "experiment": "ode_vs_full",
                    "config_id": config_id,
                    "metric": metric,
                    "parameter": "configuration",
                    "parameter_value": config_id,
                    "n_seeds": len(values),
                    "mean": mean,
                    "std": standard_deviation,
                    "standard_error": standard_error,
                    "ci95_low": ci_low,
                    "ci95_high": ci_high,
                    "theory_prediction": 0.0,
                    "mean_minus_theory": mean,
                    "status": "final",
                }
            )
    return rows


