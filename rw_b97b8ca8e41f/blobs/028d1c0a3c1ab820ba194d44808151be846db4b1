            handle,
            indent=2,
            sort_keys=True,
        )
    trajectory_rows: list[dict[str, Any]] = []
    summary_rows: list[dict[str, Any]] = []
    prediction_rows: list[dict[str, Any]] = []
    comparisons: list[dict[str, Any]] = []
    for config in configs:
        covariances = make_covariances(
            config.data_dimension, config.mask_fraction, config.signal_scale
        )
        theory = theory_prediction(
            covariances["context_variance"],
            covariances["cross_covariance"],
            config.predictor_scale,
            config.weight_decay,
            config.initial_weight,
            RANK_THRESHOLD,
            config.predictor_lr_ratio,
            config.predictor_weight_decay,
            config.predictor_depth,
            config.predictor_width if config.architecture == "bottleneck" else None,
        )
        add_prediction_rows(prediction_rows, config, covariances, theory)
        for seed in SEEDS:
            simulation = simulate_reduced(config, seed, covariances, theory)
            trajectory_rows.extend(simulation.trajectory_rows)
            summary_rows.append(simulation.summary)
    for config in validation_configs:
        covariances = make_covariances(
            config.data_dimension, config.mask_fraction, config.signal_scale
        )
        theory = theory_prediction(
            covariances["context_variance"],
