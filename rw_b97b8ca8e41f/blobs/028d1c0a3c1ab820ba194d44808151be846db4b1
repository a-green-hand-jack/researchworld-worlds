def comparison_for_validation(
    config_id: str,
    seed: int,
    reduced: SimulationResult,
    full: SimulationResult,
) -> dict[str, Any]:
    rank_difference = abs(
        int(reduced.summary["final_threshold_rank"]) - int(full.summary["final_threshold_rank"])
    )
    max_spectral_relative_error = 0.0
    max_trajectory_relative_error = 0.0
    for step in CHECKPOINTS:
        reduced_spectrum = np.sort(reduced.spectra_by_step[step])[::-1]
        full_spectrum = np.sort(full.spectra_by_step[step])[::-1]
        denominator = max(float(np.max(reduced_spectrum, initial=0.0)), 1.0e-12)
        relative_error = float(np.max(np.abs(reduced_spectrum - full_spectrum)) / denominator)
        max_trajectory_relative_error = max(max_trajectory_relative_error, relative_error)
        if step == CHECKPOINTS[-1]:
            max_spectral_relative_error = relative_error
    return {
        "config_id": config_id,
        "seed": seed,
        "final_rank_difference": rank_difference,
        "max_spectral_relative_error": max_spectral_relative_error,
        "max_trajectory_relative_error": max_trajectory_relative_error,
        "status": "final",
    }


def run(output_directory: Path) -> None:
    start_time = time.time()
    output_directory.mkdir(parents=True, exist_ok=True)
    for subdirectory in ("raw", "derived", "configs"):
        (output_directory / subdirectory).mkdir(parents=True, exist_ok=True)
    configs, validation_configs = build_configs()
    all_configs = configs + validation_configs
    with (output_directory / "configs" / "experiment_grid.json").open("w", encoding="utf-8") as handle:
        json.dump(
            {
                "global": {
                    "checkpoints": list(CHECKPOINTS),
                    "rank_threshold": RANK_THRESHOLD,
                    "seeds": list(SEEDS),
                    "validation_seeds": list(VALIDATION_SEEDS),
                },
                "configs": [config_dict(config) for config in all_configs],
