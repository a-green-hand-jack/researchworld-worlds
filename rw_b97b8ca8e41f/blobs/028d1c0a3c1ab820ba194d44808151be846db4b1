            trajectory_rows.extend(full.trajectory_rows)
            summary_rows.append(reduced.summary)
            summary_rows.append(full.summary)
            comparisons.append(comparison_for_validation(config.config_id, seed, reduced, full))
    trajectory_fields = [
        "experiment", "run_id", "config_id", "seed", "architecture", "mask_fraction", "predictor_scale",
