def format_number(value: float, digits: int = 3) -> str:
    return f"{value:.{digits}f}".replace("-", "n").replace(".", "p")


def make_config_id(prefix: str, **values: Any) -> str:
    parts = [prefix]
    for key, value in values.items():
        if isinstance(value, float):
            encoded = format_number(value)
        else:
            encoded = str(value)
        parts.append(f"{key}{encoded}")
    return "_".join(parts)


def make_covariances(
    data_dimension: int,
    mask_fraction: float,
    signal_scale: float = 1.0,
) -> dict[str, np.ndarray]:
    mode_index = np.arange(data_dimension, dtype=float)
    spectrum = np.geomspace(3.0, 0.05, data_dimension)
    mean_spectrum = float(np.mean(spectrum))
    context_probability = 1.0 - mask_fraction
    context_variance = context_probability * (
        context_probability * spectrum + (1.0 - context_probability) * mean_spectrum
    )
    target_variance = (1.0 - context_probability) * (
        context_probability * spectrum + (1.0 - context_probability) * mean_spectrum
    )
    cross_covariance = signal_scale * context_probability * (1.0 - context_probability) * (
        spectrum - mean_spectrum
    )
    frequency = mode_index / max(data_dimension - 1, 1)
    normalizer = np.sqrt(np.maximum(context_variance * target_variance, 1.0e-30))
    correlation = np.divide(
        cross_covariance,
        normalizer,
        out=np.zeros_like(cross_covariance),
        where=normalizer > 0.0,
    )
    return {
        "context_variance": context_variance,
        "target_variance": target_variance,
        "cross_covariance": cross_covariance,
        "correlation": correlation,
        "frequency": frequency,
        "spectrum": spectrum,
        "mean_spectrum": np.asarray(mean_spectrum),
        "context_probability": np.asarray(context_probability),
        "signal_scale": np.asarray(signal_scale),
    }


def effective_rank(eigenvalues: np.ndarray) -> float:
    values = np.clip(np.asarray(eigenvalues, dtype=float), 0.0, None)
    total = float(values.sum())
    if total <= 0.0:
        return 0.0
    probabilities = values[values > 0.0] / total
    return float(np.exp(-np.sum(probabilities * np.log(probabilities))))


def threshold_rank(eigenvalues: np.ndarray, relative_threshold: float = RANK_THRESHOLD) -> int:
    values = np.clip(np.asarray(eigenvalues, dtype=float), 0.0, None)
    maximum = float(values.max(initial=0.0))
    if maximum <= 0.0:
        return 0
    return int(np.sum(values / maximum >= relative_threshold))


def theory_prediction(
    context_variance: np.ndarray,
    cross_covariance: np.ndarray,
    predictor_scale: float,
    weight_decay: float,
    initial_weight: float,
    rank_threshold_value: float,
    predictor_lr_ratio: float = 1.0,
    predictor_weight_decay: float = WEIGHT_DECAY,
    predictor_depth: int = 1,
    active_width: int | None = None,
) -> dict[str, np.ndarray | int | float]:
    discriminant = cross_covariance**2 - 4.0 * context_variance * weight_decay
    eligible = (discriminant > 0.0) & (cross_covariance > 0.0) & (context_variance > 0.0)
    roots_lower = np.full_like(discriminant, np.nan)
    roots_upper = np.full_like(discriminant, np.nan)
    valid = eligible
    nonzero_context = valid & (context_variance > 0.0)
    roots_lower[nonzero_context] = (
        cross_covariance[nonzero_context] - np.sqrt(discriminant[nonzero_context])
    ) / (2.0 * context_variance[nonzero_context])
    roots_upper[nonzero_context] = (
        cross_covariance[nonzero_context] + np.sqrt(discriminant[nonzero_context])
    ) / (2.0 * context_variance[nonzero_context])
    initial_rate = (
        predictor_scale * cross_covariance
        - predictor_scale**2 * context_variance
        - weight_decay
    )
    predictor_decay_rate = predictor_depth * predictor_lr_ratio * predictor_weight_decay
    if predictor_decay_rate > 0.0:
        time_grid = np.linspace(0.0, 12.0 / predictor_decay_rate, 4_001)
        predictor_path = predictor_scale * np.exp(-predictor_decay_rate * time_grid)
        rates = (
            predictor_path[None, :] * cross_covariance[:, None]
            - predictor_path[None, :] ** 2 * context_variance[:, None]
            - weight_decay
        )
        increments = 0.5 * (rates[:, :-1] + rates[:, 1:]) * np.diff(time_grid)[None, :]
        cumulative_gain = np.concatenate(
            [np.zeros((len(context_variance), 1)), np.cumsum(increments, axis=1)],
            axis=1,
        )
        maximum_cumulative_gain = np.max(cumulative_gain, axis=1)
    else:
        maximum_cumulative_gain = np.full_like(context_variance, np.inf)
    if active_width is not None:
        active_modes = np.arange(len(context_variance)) < active_width
        initial_rate = np.where(active_modes, initial_rate, -weight_decay)
        maximum_cumulative_gain = np.where(active_modes, maximum_cumulative_gain, -np.inf)
        eligible = eligible & active_modes
    required_gain = math.log(rank_threshold_value / initial_weight)
    early_gain_survival = maximum_cumulative_gain >= required_gain
    return {
        "discriminant": discriminant,
        "root_lower": roots_lower,
        "root_upper": roots_upper,
        "fixed_point_eligible": eligible,
        "initial_rate": initial_rate,
        "maximum_cumulative_gain": maximum_cumulative_gain,
        "required_gain": required_gain,
        "early_gain_survival": early_gain_survival,
        "fixed_point_rank": int(np.sum(eligible)),
        "initial_rate_rank": int(np.sum(initial_rate > 0.0)),
        "early_gain_rank": int(np.sum(early_gain_survival)),
        "predictor_decay_rate": predictor_decay_rate,
    }


def snapshot_reduced(
    weights: np.ndarray,
    predictors: np.ndarray,
    target_weights: np.ndarray,
    context_variance: np.ndarray,
    target_variance: np.ndarray,
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    representation_eigenvalues = weights**2 * context_variance
    predictor_eigenvalues = predictors**2
    target_eigenvalues = target_weights**2 * target_variance
    return representation_eigenvalues, predictor_eigenvalues, target_eigenvalues


def snapshot_full(
    encoder: np.ndarray,
    predictor: np.ndarray,
    target_encoder: np.ndarray,
    context_variance: np.ndarray,
    target_variance: np.ndarray,
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    context_covariance = np.diag(context_variance)
    target_covariance = np.diag(target_variance)
    representation_covariance = encoder @ context_covariance @ encoder.T
    predictor_covariance = predictor @ predictor.T
    target_representation_covariance = target_encoder @ target_covariance @ target_encoder.T
    return (
        np.linalg.eigvalsh(representation_covariance)[::-1],
        np.linalg.eigvalsh(predictor_covariance)[::-1],
        np.linalg.eigvalsh(target_representation_covariance)[::-1],
    )


