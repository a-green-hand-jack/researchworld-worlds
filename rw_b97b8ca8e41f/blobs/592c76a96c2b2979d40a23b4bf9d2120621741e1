#!/usr/bin/env python3
"""Merge per-configuration/per-seed ViT jobs into stable evidence files."""
from __future__ import annotations

import csv
import gzip
import json
import platform
import sys
from collections import defaultdict
from pathlib import Path
from typing import Any

import numpy as np
import torch

import run_vit_experiments as runner

ROOT = Path("results")
RUN_ROOT = ROOT / "raw" / "vit_runs"


def read_csv(path: Path) -> list[dict[str, str]]:
    with path.open(newline="", encoding="utf-8") as handle:
        return list(csv.DictReader(handle))


def write_csv(path: Path, rows: list[dict[str, Any]], fields: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    opener = gzip.open if path.suffix == ".gz" else open
    with opener(path, "wt", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)


def summary_metric(rows: list[dict[str, str]], key: str) -> tuple[float, float, float, float, float]:
    values = np.asarray([float(row[key]) for row in rows if row[key] not in {"nan", "NaN", ""}], dtype=float)
    if len(values) == 0:
        return float("nan"), float("nan"), float("nan"), float("nan"), 0.0
    mean = float(values.mean())
    standard_deviation = float(values.std(ddof=1)) if len(values) > 1 else 0.0
    standard_error = standard_deviation / np.sqrt(len(values))
    return mean, standard_deviation, mean - 1.96 * standard_error, mean + 1.96 * standard_error, float(len(values))


def main() -> None:
    summary_rows: list[dict[str, str]] = []
    trajectory_rows: list[dict[str, str]] = []
    provenance: dict[str, Any] = {
        "jobs": [],
        "mask_sampler": runner.MASK_SAMPLER,
        "mask_geometry": runner.MASK_GEOMETRY,
        "mask_fraction_semantics": runner.MASK_FRACTION_SEMANTICS,
        "training_mask_policy": runner.TRAINING_MASK_POLICY,
        "rank_evaluation_mask_policy": runner.RANK_EVALUATION_MASK_POLICY,
        "rank_evaluation_mask_sampler": runner.MASK_SAMPLER,
        "initial_probe_source": "results/derived/vit_init_probe.csv generated by code/add_init_probe.py",
        "torch": torch.__version__,
        "numpy": np.__version__,
        "python": sys.version,
        "platform": platform.platform(),
        "status": "final",
    }
    for summary_path in sorted(RUN_ROOT.glob("*/summary_seed*.csv")):
        summary_rows.extend(read_csv(summary_path))
        provenance["jobs"].append(str(summary_path.relative_to(ROOT)))
    for trajectory_path in sorted(RUN_ROOT.glob("*/trajectory_seed*.csv")):
        trajectory_rows.extend(read_csv(trajectory_path))
    if not summary_rows:
        raise RuntimeError("no final ViT summary files found")
    run_ids = [row["run_id"] for row in summary_rows]
    if len(run_ids) != len(set(run_ids)):
        raise RuntimeError("duplicate ViT run_id in summary files")
    required_summary = {
        "tier", "config_id", "seed", "late_effective_rank", "late_numerical_rank", "probe_accuracy", "probe_accuracy_init",
        "early_baseline_rank", "early_rank_at_end", "rank_measure", "eigenvector_alignment",
        "mask_sampler", "mask_geometry", "mask_fraction_semantics", "training_mask_policy",
        "rank_evaluation_mask_policy", "rank_evaluation_mask_sampler",
    }
    required_trajectory = {
        "config_id", "seed", "step", "direction_index", "representation_eigenvalue",
        "target_representation_eigenvalue", "theory_growth_rate", "measured_growth_rate",
        "eigenvector_alignment_overlap", "target_eigenvector_alignment_overlap", "rank_measure",
    }
    if not required_summary.issubset(summary_rows[0]):
        raise RuntimeError(f"summary schema missing {sorted(required_summary - set(summary_rows[0]))}")
    protocol_fields = {
        "mask_sampler": runner.MASK_SAMPLER,
        "mask_geometry": runner.MASK_GEOMETRY,
        "mask_fraction_semantics": runner.MASK_FRACTION_SEMANTICS,
        "training_mask_policy": runner.TRAINING_MASK_POLICY,
        "rank_evaluation_mask_policy": runner.RANK_EVALUATION_MASK_POLICY,
        "rank_evaluation_mask_sampler": runner.MASK_SAMPLER,
    }
    for row in summary_rows:
        for field, expected in protocol_fields.items():
            if row.get(field) != expected:
                raise RuntimeError(f"nonlinear protocol mismatch in {field}: {row.get(field)!r}")
    if not trajectory_rows or not required_trajectory.issubset(trajectory_rows[0]):
        raise RuntimeError(f"trajectory schema missing {sorted(required_trajectory - set(trajectory_rows[0]) if trajectory_rows else required_trajectory)}")
    late_steps: dict[tuple[str, int], int] = {}
    for row in trajectory_rows:
        key = (row["config_id"], int(row["seed"]))
        late_steps[key] = max(late_steps.get(key, -1), int(row["step"]))
    for row in summary_rows:
        key = (row["config_id"], int(row["seed"]))
        measured_last_step = late_steps.get(key, -1)
        if row.get("late_checkpoint_step", str(measured_last_step)) != str(measured_last_step):
            raise RuntimeError(f"late checkpoint mismatch for {key}")
        if measured_last_step != int(row["steps"]):
            raise RuntimeError(f"late spectrum does not reach the final step for {key}")
        row["late_checkpoint_step"] = str(measured_last_step)
    summary_fields = list(summary_rows[0].keys())
    trajectory_fields = list(trajectory_rows[0].keys())
    write_csv(ROOT / "raw" / "vit_nonlinear_summary.csv", summary_rows, summary_fields)
    write_csv(ROOT / "raw" / "vit_nonlinear_trajectories.csv.gz", trajectory_rows, trajectory_fields)

    metric_rows: list[dict[str, Any]] = []
    groups: dict[tuple[str, str], list[dict[str, str]]] = defaultdict(list)
    for row in summary_rows:
        groups[(row["tier"], row["config_id"])].append(row)
    for (tier, config_id), rows in sorted(groups.items()):
        for metric, key in (
            ("late_effective_rank", "late_effective_rank"),
            ("late_numerical_rank", "late_numerical_rank"),
            ("late_target_effective_rank", "late_target_effective_rank"),
            ("late_target_numerical_rank", "late_target_numerical_rank"),
            ("early_predicted_rank", "early_predicted_rank"),
            ("early_baseline_rank", "early_baseline_rank"),
            ("early_rank_at_end", "early_rank_at_end"),
            ("rank_error", "rank_error"),
            ("probe_accuracy", "probe_accuracy"),
            ("probe_accuracy_init", "probe_accuracy_init"),
        ):
            mean, standard_deviation, ci_low, ci_high, count = summary_metric(rows, key)
            metric_rows.append(
                {
                    "tier": tier,
                    "config_id": config_id,
                    "metric": metric,
                    "n_seeds": int(count),
                    "mean": mean,
                    "std": standard_deviation,
                    "ci95_low": ci_low,
                    "ci95_high": ci_high,
                    "status": "final",
                }
            )
    write_csv(
        ROOT / "derived" / "vit_claim_metrics.csv",
        metric_rows,
        ["tier", "config_id", "metric", "n_seeds", "mean", "std", "ci95_low", "ci95_high", "status"],
    )
    with (ROOT / "derived" / "vit_provenance.json").open("w", encoding="utf-8") as handle:
        json.dump(provenance, handle, indent=2, sort_keys=True)
    with (ROOT / "configs" / "vit_grid.json").open("w", encoding="utf-8") as handle:
        json.dump(
            {
                "tier_b": [runner.asdict(config) for config in runner.configs()],
                "tier_c": [runner.asdict(runner.config_by_id(config_id)) for config_id in (
                    "c_reference", "c_scale_low", "c_scale_high", "c_mask_low", "c_mask_high", "c_ema_slow"
                )],
                "seeds": list(runner.SEEDS),
                "extra_seed_configs": sorted(runner.EXTRA_SEED_CONFIGS),
                "extra_seeds": {key: list(value) for key, value in sorted(runner.EXTRA_SEEDS.items())},
                "mask_sampler": runner.MASK_SAMPLER,
                "mask_geometry": runner.MASK_GEOMETRY,
                "mask_fraction_semantics": runner.MASK_FRACTION_SEMANTICS,
                "training_mask_policy": runner.TRAINING_MASK_POLICY,
                "rank_evaluation_mask_policy": runner.RANK_EVALUATION_MASK_POLICY,
                "rank_evaluation_mask_sampler": runner.MASK_SAMPLER,
                "status": "final",
            },
            handle,
            indent=2,
            sort_keys=True,
        )
    print(json.dumps({"summary_rows": len(summary_rows), "trajectory_rows": len(trajectory_rows), "metric_rows": len(metric_rows), "status": "PASS"}, indent=2))


if __name__ == "__main__":
    main()
