% Minimal local stand-in for icml2025.sty (official file not supplied): two-column, 10pt Times, ICML geometry.
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{icml2025}
\RequirePackage{times}\RequirePackage[sort&compress,round]{natbib}
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in]{geometry}
\RequirePackage{fancyhdr}\RequirePackage{xcolor}
\DeclareOption{accepted}{}\ProcessOptions\relax
\renewcommand\normalsize{\@setfontsize\normalsize{10}{11}}\normalsize
\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}
\def\icmltitlerunning#1{\gdef\@icmlrun{#1}}
\def\icmltitle#1{\begin{center}{\Large\bf #1}\end{center}}

\def\icmlauthor#1#2{\begin{center}\bf #1\end{center}}
\newenvironment{icmlauthorlist}{}{}
\def\icmlaffiliation#1#2{}\def\icmlcorrespondingauthor#1#2{}\def\icmlkeywords#1{}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\@icmlrun}\fancyfoot[C]{\thepage}
\renewcommand\section{\@startsection{section}{1}{\z@}{-8pt plus -2pt}{4pt}{\large\bf}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-6pt plus -2pt}{3pt}{\normalsize\bf}}
\renewenvironment{abstract}{\begin{center}{\bf Abstract}\end{center}\begin{quote}\small}{\end{quote}}
