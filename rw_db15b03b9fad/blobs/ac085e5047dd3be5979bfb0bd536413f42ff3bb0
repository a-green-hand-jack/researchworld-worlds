import random, time, json, csv, math, platform, sys
import numpy as np

def insertion_sort(a):
    for i in range(1, len(a)):
        k = a[i]; j = i - 1
        while j >= 0 and a[j] > k:
            a[j+1] = a[j]; j -= 1
        a[j+1] = k
    return a

def merge_sort(a):
    if len(a) <= 1: return a
    m = len(a)//2
    l, r = merge_sort(a[:m]), merge_sort(a[m:])
    out = []; i = j = 0
    while i < len(l) and j < len(r):
        if l[i] <= r[j]: out.append(l[i]); i += 1
        else: out.append(r[j]); j += 1
    out.extend(l[i:]); out.extend(r[j:])
    return out

NS = [1000, 2000, 4000, 8000, 16000]; REP = 5
rows = []
for n in NS:
    for rep in range(REP):
        rng = random.Random(1000*n + rep)
        data = [rng.randint(0, 10**9) for _ in range(n)]
        for name, f in (("insertion", insertion_sort), ("merge", merge_sort)):
            x = list(data); t = time.perf_counter(); y = f(x); dt = time.perf_counter() - t
            assert y == sorted(data)
            rows.append((name, n, rep, dt))
    print(n, flush=True)
with open("results/timings.csv", "w") as fh:
    w = csv.writer(fh); w.writerow(["algorithm", "n", "repeat", "seconds"]); w.writerows(rows)

fits = {"env": {"python": sys.version.split()[0], "numpy": np.__version__, "platform": platform.platform()}}
for name in ("insertion", "merge"):
    ns = np.array(NS, float)
    means = np.array([np.mean([r[3] for r in rows if r[0]==name and r[1]==n]) for n in NS])
    sds = np.array([np.std([r[3] for r in rows if r[0]==name and r[1]==n], ddof=1) for n in NS])
    X = np.log(ns); Y = np.log(means)
    A = np.vstack([X, np.ones_like(X)]).T
    coef, res, *_ = np.linalg.lstsq(A, Y, rcond=None)
    s2 = res[0]/(len(X)-2); cov = s2*np.linalg.inv(A.T@A)
    se = math.sqrt(cov[0,0])
    # t crit df=3 two-sided 95%
    ci = 3.182*se
    # all-points fit and doubling ratios
    ratios = (means[1:]/means[:-1]).tolist()
    # model fit: t = c*n^2 vs c*n log n relative residuals (log-space RMS)
    def rms(shape):
        c = np.exp(np.mean(Y - np.log(shape)))
        return float(np.sqrt(np.mean((Y - np.log(c*shape))**2)))
    fits[name] = {"mean": means.tolist(), "sd": sds.tolist(), "slope": float(coef[0]), "slope_se": se,
                  "slope_ci95": [float(coef[0]-ci), float(coef[0]+ci)], "doubling_ratios": ratios,
                  "logrms_n2": rms(ns**2), "logrms_nlogn": rms(ns*np.log(ns))}
json.dump(fits, open("results/fits.json", "w"), indent=1)
print(json.dumps(fits, indent=1))
