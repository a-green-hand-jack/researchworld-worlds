"""Copied from the internal review's checks/e4_a1h2_check.py (internal review point 2) and run on this repository to put its post hoc comparison beside the H2 score; code unchanged.
Independent check of the A1_v4 held-out result on grid 2 (commit 1d4c27e results/e4/a1h2/a1h2_score.json,
a1h2_runs.jsonl.gz; registration results/e4/prediction.json A1_v4 at 003a8e2; frozen model 4327b3d, md5 72f6b42...).

1. Rescore A1b/A1c/A1d and the four A1d baselines from the delivered per-run records with my own code
   (same scorer as checks/e4_a1_heldout_rescore.py).
2. Re-run the frozen v4 (code/e4_theory.py at 4327b3d, md5 checked) on every run's delivered state at K and compare
   its alive states, alive_from and burst steps with the delivered pred_* fields.
3. Re-simulate the 80-bit ground truth for a stratified sample with my own longdouble scalar AdamW map and compare
   burst / alive_from / checkpoint states with the delivered records.
4. Does grid 2 test what v4 changed? Score the frozen v3 (phase_model_hybrid at ebc17db, md5 2f89494...) on grid 2,
   and v3 + the A-iv' settled law (after v3's first crossing, alive iff c/s > thr: dev3's ablation), with the same
   A1d metrics. Compare the grid's hardness with held-out grid 1: second-collapse share, share of directions with
   c/s <= thr, baselines.
5. Where v4's remaining wrong pairs are: on directions with c/s <= thr, second collapses, hover.

Usage: python3 checks/e4_a1h2_check.py /path/to/this/repository [NPROC] > checks/e4_a1h2_check.json
"""
import sys, os, json, gzip, time, hashlib, subprocess, importlib.util
os.environ.setdefault("OMP_NUM_THREADS", "1")
import numpy as np
from multiprocessing import Pool

ROOT = sys.argv[1]
sys.path.insert(0, os.path.join(ROOT, "code"))
import e4_a1h2 as H  # noqa: E402  (configs; sets e4_a1.STATS to h2a/h2b)
import e4_a1 as A  # noqa: E402  (stats, init_a, CHECKS only)

K, T, THR, BURST = 300, 60000, 0.05, 1e-3
CK = [int(x) for x in np.unique(np.round(np.geomspace(K + 50, T, 30)))]
assert CK == A.CHECKS


def load_at(commit, name, md5):
    src = subprocess.run(["git", "-C", ROOT, "show", f"{commit}:code/e4_theory.py"], capture_output=True, check=True).stdout
    assert hashlib.md5(src).hexdigest() == md5, (commit, hashlib.md5(src).hexdigest())
    path = f"/tmp/{name}.py"
    open(path, "wb").write(src)
    spec = importlib.util.spec_from_file_location(name, path); m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
    return m


V4 = load_at("4327b3d35b86935d161b5c968c0d794c5a78e064", "theory_v4_frozen", "72f6b4245a46a2a34c773052e5a5e160")
V3 = load_at("ebc17db61082664b4c8f64e9012815d5b6774517", "theory_v3_frozen", "2f894944f71ad618955363ea8e8fe8dd")


def sim(cfg, dtype, rel=0.0):
    c, s = A.stats(cfg["stats"]); D = dtype
    c = c.astype(D); s = s.astype(D); one = D(1)
    b1, b2, eta, lam = (D(cfg[k]) for k in ("b1", "b2", "eta", "lam")); eps = D(1e-8)
    a = A.init_a(cfg).astype(D) * (one + D(rel)); p = np.full(c.shape, D(cfg["p0"]))
    ma = np.zeros_like(c); va = np.zeros_like(c); mp = np.zeros_like(c); vp = np.zeros_like(c)
    burst = np.zeros(c.size, int); alive = np.zeros(c.size, int); at = []; cks = set(CK)
    for t in range(1, T + 1):
        r = c - p * s
        ga = -a * p * r; gp = -a * a * r
        ma = b1 * ma + (one - b1) * ga; va = b2 * va + (one - b2) * ga * ga
        mp = b1 * mp + (one - b1) * gp; vp = b2 * vp + (one - b2) * gp * gp
        bc1 = one - b1 ** t; bc2 = one - b2 ** t
        a = a * (one - eta * lam) - eta * (ma / bc1) / (np.sqrt(va / bc2) + eps)
        p = p * (one - eta * lam) - eta * (mp / bc1) / (np.sqrt(vp / bc2) + eps)
        if t > K:
            Aa = np.abs(a)
            burst[(burst == 0) & (Aa > BURST)] = t; alive[(alive == 0) & (Aa > THR)] = t
            if t in cks:
                at.append(Aa > THR)
    return dict(burst=burst, alive_from=alive, alive=np.array(at, bool))


def resim(args):
    cfg, rec = args
    L = sim(cfg, np.longdouble)
    nz = lambda x: np.array([0 if v is None else v for v in x])
    Aa = np.array(rec["alive"], bool)
    return dict(id=cfg["id"], burst_equal=int((L["burst"] == nz(rec["burst"])).sum()),
                alive_from_equal=int((L["alive_from"] == nz(rec["alive_from"])).sum()),
                states_equal=int((L["alive"] == Aa).sum()), n=32, pairs=int(Aa.size))


def models(r):
    c, s = A.stats(r["stats"]); st = {k: np.array(v) for k, v in r["state_K"].items()}
    kw = dict(b1=r["b1"], b2=r["b2"], checks=CK)
    o4 = V4.phase_model_v4(c, s, st, K, r["lam"], r["eta"], T, **kw)
    o3 = V3.phase_model_hybrid(c, s, st, K, r["lam"], r["eta"], T, **kw)
    fl = lambda x: [None if not np.isfinite(v) else float(v) for v in x]
    p4 = np.array([o4["alive"][t] for t in CK], bool)
    p3 = np.array([o3["alive"][t] for t in CK], bool)
    return dict(id=r["id"], v4_alive_equal=bool((p4 == np.array(r["pred_alive"], bool)).all()),
                v4_alive_from_equal=fl(o4["alive_from"]) == r["pred_alive_from"], v4_burst_equal=fl(o4["burst"]) == r["pred_burst"],
                v3=p3.tolist())


def waits(pred, meas, mask):
    e, miss, n = [], 0, 0
    for k in np.where(mask)[0]:
        tp, tm = pred[k], meas[k]
        if tp is None and tm is None:
            continue
        n += 1
        if tp is None or tm is None:
            miss += 1
        else:
            e.append(abs(np.log(max(tp - K, 1.0) / (tm - K))))
    return e, miss, n


def summ(e, miss, n):
    e = np.array(e)
    return dict(scored=n, median=float(np.median(e)) if e.size else None,
                p90=float(np.quantile(e, 0.9)) if e.size else None, misses=miss, miss_share=miss / max(n, 1))


def a1d(preds_truth):
    err = 1 - float(np.mean(np.concatenate([(P == Tr).ravel() for P, Tr in preds_truth])))
    rk = 1 - float(np.mean(np.concatenate([np.abs(P.sum(1) - Tr.sum(1)) <= 1 for P, Tr in preds_truth])))
    return dict(error_rate=err, rank_within_1_failure=rk, rank_within_1=1 - rk)


def main():
    nproc = int(sys.argv[2]) if len(sys.argv) > 2 else 8
    t0 = time.time()
    runs = [json.loads(l) for l in gzip.open(os.path.join(ROOT, "results/e4/a1h2/a1h2_runs.jsonl.gz"), "rt")]
    cfgs = {c["id"]: c for c in H.configs()}
    out = dict(source="commit 1d4c27e results/e4/a1h2/a1h2_runs.jsonl.gz", runs=len(runs))
    with Pool(nproc) as pool:
        mo = {m["id"]: m for m in pool.map(models, runs)}
    out["v4_rerun"] = dict(runs=len(mo), alive_equal=sum(m["v4_alive_equal"] for m in mo.values()),
                           alive_from_equal=sum(m["v4_alive_from_equal"] for m in mo.values()),
                           burst_equal=sum(m["v4_burst_equal"] for m in mo.values()))
    acc = {k: [[], 0, 0] for k in ("A1b", "A1c")}
    names = ("model", "all_alive", "persistence_K", "static_bound", "majority_oracle", "v3_frozen", "v3_plus_settled_law")
    pt = {k: [] for k in names}; pt_split = {}
    hard = dict(directions=0, cs_le_thr=0, second_collapse_dirs=0, pairs=0, dead_pairs=0, alive_pairs_cs_le_thr=0)
    wr = dict(pairs=0, on_cs_le_thr=0, on_second=0, rank_bad=0, rank_bad_all_wrong_on_cs_le_thr=0)
    floor = dict(runs=0, pairs_differ=0, pairs=0, rank_bad=0, cks=0)
    for r in runs:
        cfg = cfgs[r["id"]]
        for k in ("stats", "p0", "lam", "a0", "eta", "b1", "b2", "seed"):
            assert cfg[k] == r[k]
        c, s = A.stats(r["stats"]); pc = c / s
        st = {k: np.array(v) for k, v in r["state_K"].items()}
        aK = np.abs(st["a"]); hK = st["p"] * (c - st["p"] * s)
        setb = (hK < 0) & (aK <= BURST); setc = aK <= THR
        for key, pred, meas, m in (("A1b", r["pred_burst"], r["burst"], setb), ("A1c", r["pred_alive_from"], r["alive_from"], setc)):
            e, mi, nn = waits(pred, meas, m); acc[key][0] += e; acc[key][1] += mi; acc[key][2] += nn
        Tr = np.array(r["alive"], bool); P4 = np.array(r["pred_alive"], bool); P3 = np.array(mo[r["id"]]["v3"], bool)
        first = np.maximum.accumulate(P3, axis=0)
        P3s = first & np.broadcast_to(pc > THR, Tr.shape)
        preds = dict(model=P4, all_alive=np.ones_like(Tr), persistence_K=np.broadcast_to(aK > THR, Tr.shape),
                     static_bound=np.broadcast_to(c ** 2 >= 4 * r["lam"] * s, Tr.shape),
                     majority_oracle=np.broadcast_to(Tr.mean(0) >= 0.5, Tr.shape), v3_frozen=P3, v3_plus_settled_law=P3s)
        for k, P in preds.items():
            pt[k].append((P, Tr))
            pt_split.setdefault((r["stats"], k), []).append((P, Tr))
        sec = np.maximum.accumulate(Tr, axis=0) & ~Tr
        low = pc <= THR
        hard["directions"] += Tr.shape[1]; hard["cs_le_thr"] += int(low.sum()); hard["second_collapse_dirs"] += int(sec.any(0).sum())
        hard["pairs"] += Tr.size; hard["dead_pairs"] += int((~Tr).sum()); hard["alive_pairs_cs_le_thr"] += int((Tr & low).sum())
        W = P4 != Tr; wr["pairs"] += int(W.sum()); wr["on_cs_le_thr"] += int((W & low).sum()); wr["on_second"] += int((W & sec).sum())
        bad = np.abs(P4.sum(1) - Tr.sum(1)) > 1
        wr["rank_bad"] += int(bad.sum())
        wr["rank_bad_all_wrong_on_cs_le_thr"] += int(sum(bool(W[i].any() and (W[i] <= low).all()) for i in np.where(bad)[0]))
        if "floor_alive" in r:
            F = np.array(r["floor_alive"], bool)
            floor["runs"] += 1; floor["pairs_differ"] += int((F != Tr).sum()); floor["pairs"] += Tr.size
            floor["rank_bad"] += int((np.abs(F.sum(1) - Tr.sum(1)) > 1).sum()); floor["cks"] += Tr.shape[0]
    out["A1b"] = summ(*acc["A1b"]); out["A1c"] = summ(*acc["A1c"])
    out["A1d"] = {k: a1d(v) for k, v in pt.items()}
    out["A1d_by_stats"] = {f"{st}:{k}": a1d(v) for (st, k), v in pt_split.items() if k in ("model", "v3_frozen", "v3_plus_settled_law", "majority_oracle")}
    out["hardness"] = dict(hard, cs_le_thr_share=hard["cs_le_thr"] / hard["directions"],
                           second_collapse_share=hard["second_collapse_dirs"] / hard["directions"],
                           dead_pair_share=hard["dead_pairs"] / hard["pairs"])
    out["v4_wrong_pairs"] = wr
    out["truth_floor"] = dict(floor, state_error=floor["pairs_differ"] / max(floor["pairs"], 1),
                              rank_within_1_failure=floor["rank_bad"] / max(floor["cks"], 1))
    # 3: stratified resimulation, one run per stats x b1 x b2 x lam cell (p0 1.25, a0 5e-3, eta 0.04)
    rec = {r["id"]: r for r in runs}
    samp = [c for c in H.configs() if c["p0"] == 1.25 and c["a0"] == 5e-3 and c["eta"] == 0.04]
    with Pool(nproc) as pool:
        rs = pool.map(resim, [(c, rec[c["id"]]) for c in samp])
    tot = lambda k: int(sum(x[k] for x in rs))
    out["resim"] = dict(runs=len(rs), directions=tot("n"), burst_equal=tot("burst_equal"), alive_from_equal=tot("alive_from_equal"),
                        pairs=tot("pairs"), states_equal=tot("states_equal"), ids=[x["id"] for x in rs])
    out["seconds"] = round(time.time() - t0, 1); out["numpy"] = np.__version__
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()
