        return "{:.2f} [{:.2f}, {:.2f}]".format(c["rho"], *c["ci"]).replace("-", "$-$")
    return get


def e3probe(name):
    return lambda d: pct(sum(next(r for r in d["rows"] if r["name"] == name)["probe"]) / 3)


def e3sci(x):
    m, e = f"{x:.1e}".split("e")
    return m + r"\times10^{" + str(int(e)) + "}"


