def traj_rank(p0, field):
    """rank of the single-seed E1 trajectory run at lam=0.01 and initial gain p0."""
    return lambda d: next(c[field] for c in d["configs"] if c["p0"] == p0 and c["lam"] == 0.01)


def traj_score(p0, k):
    """race score R_k of direction k in the E1 trajectory run at initial gain p0."""
    def get(rows):
        return float(next(r["R_k"] for r in rows if r["config"] == f"lam0.01_p0{p0:g}_w01e-4" and r["k"] == str(k)))
    return get


def grid_collapse_misses(d):
    """phase-grid cells where complete collapse (mean rank 0) is predicted but not measured, or vice versa."""
    return [(k, v) for k, v in d["cells"]["grid"].items()
            if (v["rank_meas_mean"] == 0) != (v["rank_pred_mean"] == 0)]


def trend_bound(name):
    def get(d):
        return ", ".join(f"{r['rank_bound']:g}" for r in d["trends"][name])
    return get


def unfinished(init, dim):
    """race-grid runs whose predictor had not left every window by the horizon."""
    return lambda rows: sum(r["exp"] == "race" and r["init"] == init and r["d"] == dim
                            and r["race_finished"] == "False" for r in rows)

