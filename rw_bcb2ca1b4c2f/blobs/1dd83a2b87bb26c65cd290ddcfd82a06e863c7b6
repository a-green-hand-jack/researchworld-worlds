def dvd(exp, arm, key, field="mae"):
    """a criterion's score on the delivered runs in the 2610.02344 baseline file."""
    def get(d):
        v = d["results"][exp][arm][key][field]
        return f"{v[0] if isinstance(v, list) else v:.2f}"
    return get


def dvd_exceed(exp, arm, key):
    """share of runs whose measured rank exceeds a count they state as an upper bound (field 'exceed')."""
    return lambda d: pct(d["results"][exp][arm][key]["exceed"])


