def e7vs(h, base, field="ci", f="{:.1f}"):
    """seed-cluster CI (bootstrap or t) of race MAE advantage over a baseline at horizon h."""
    return atci(h, "headroom200_vs_cluster", base, field, f=f, half_up=True)


def e7_rows(d):
    """seed-mean (race, measured) per constant-decay row and horizon."""
    out = []
    for name, rows in d["rows"].items():
        if not name.startswith("T_wd"):
            continue
        for h in ("e20", "e50"):
            race = sum(r[h]["headroom_200"] for r in rows) / len(rows)
            meas = sum(r[h]["measured"] for r in rows) / len(rows)
            out.append((name, h, race, meas))
    return out


def e7_below(d):
    cells = e7_rows(d)
    return f"{sum(race < meas for _, _, race, meas in cells)} of {len(cells)}"


def e7_mean(row, h, key):
    return lambda d: "{:.1f}".format(sum(r[h][key] for r in d["rows"][row]) / len(d["rows"][row]))


def e7_logshare(d):
    import math
    hr = d["horizon_ratio"]
    return "{:.2f}".format(math.log(hr["headroom_200"]["ratio"]) / math.log(hr["measured"]["ratio"]))


def e7_toggle_meas(t):
