def main():
    root = ROOT
    if "--results-root" in sys.argv:
        root = pathlib.Path(sys.argv[sys.argv.index("--results-root") + 1]).resolve()
    global RES_ROOT
    RES_ROOT = root
    lines = ["% Generated by paper/tools/make_numbers.py; do not edit by hand."]
    for macro, rel, get, fmt in NUMBERS:
        path = root / rel
        if rel.endswith(".csv"):
            data = list(csv.DictReader(path.open()))
        elif rel.endswith(".jsonl.gz"):
            data = [json.loads(line) for line in gzip.open(path, "rt")]
        else:
            data = json.loads(path.read_text())
        lines.append(f"\\newcommand{{\\{macro}}}{{{fmt.format(get(data))}}}  % {rel}")
    (ROOT / "paper" / "numbers.tex").write_text("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
