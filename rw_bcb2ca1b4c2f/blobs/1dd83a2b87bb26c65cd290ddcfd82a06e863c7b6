def at(*keys, f="{:.3f}", sub=None):
    """value at a key path; sub(v) transforms it first (e.g. 1 - v for a failure rate)."""
    def get(d):
        for k in keys:
            d = d[k]
        if sub is not None:
            d = sub(d)
        return f.format(d)
    return get


def hu(v):
    """nudge a tie away from 0 before formatting (Table 8's rounding)."""
    return v + (1e-9 if v >= 0 else -1e-9)


def atci(*keys, f="{:.2f}", half_up=False):
    """[lo, hi] of a CI stored as [lo, hi] or as [mean, lo, hi]; half_up rounds ties away from 0 (Table 8's rule)."""
    def get(d):
        for k in keys:
            d = d[k]
        lo, hi = d[-2:]
        if half_up:
            lo, hi = (x + (1e-9 if x >= 0 else -1e-9) for x in (lo, hi))
        return "[{}, {}]".format(f.format(lo), f.format(hi))
    return get


def atpct(*keys, sub=None):
    def get(d):
        for k in keys:
            d = d[k]
        return pct(d if sub is None else sub(d))
    return get


def lamsplit(st, field, lams, f="{:g}"):
    return lambda d: " / ".join(f.format(d["lambda_split"][f"{st} lam={l}"][field]) for l in lams)


def e8row(cell, field="f", f="{:.2f}"):
    """f(e) point estimates of an E8 cell at e = 2, 5, 10, 20."""
    return lambda d: " / ".join(f.format(d[cell]["primary"]["rows"][e][field][0]) for e in E8E)


def e8share(arm):
    return lambda d: " / ".join(f"{d['arms'][arm]['lr_share_left'][e]:.2f}" for e in E8E)


