def pct(x):
    return f"{100 * x:.1f}\\%"


def ci(key, field):
    """mean [lo, hi] of a bootstrap triple, as percentages."""
    return lambda d: "{} [{}, {}]".format(*(pct(v) for v in d[key][field]))


def trend(name):
    """measured mean rank per setting, comma-separated."""
    def get(d):
        return ", ".join(f"{r['rank_meas_mean']:g}" for r in d["trends"][name])
    return get


def trend_pred(name):
    def get(d):
        return ", ".join(f"{r['rank_pred_mean']:g}" for r in d["trends"][name])
    return get


def trend_values(name):
    def get(d):
        return ", ".join("SG" if r["value"] is None else f"{r['value']:g}" for r in d["trends"][name])
    return get


def bal(alpha, lam, method="rk4", agg=max):
    def get(d):
        return agg(c["max_rel_deviation"] for c in d["cases"]
                   if c["alpha"] == alpha and c["lam"] == lam and c["method"] == method)
    return get


def sci(x):
    m, e = f"{x:.1e}".split("e")
    return f"{m}\\times10^{{{int(e)}}}"


def triple(arm, metric, field, fmt):
    """mean [lo, hi] of a bootstrap triple of results/e1b/summary.json."""
    return lambda d: "{} [{}, {}]".format(*(fmt(v) for v in d[arm][metric][field]))


def bci(arm, field, fmt=pct):
    return lambda d: "{} [{}, {}]".format(*(fmt(v) for v in d[arm][field]))


def f2(x):
    return f"{x:.2f}"


def grid_row(p0, key):
    """E1b phase grid at fixed p0: mean measured / predicted rank over lam."""
    def get(d):
        cells = [(float(dict(t.split("=") for t in k.split("|"))["lam"]), v)
                 for k, v in d["cells"]["grid"].items()
                 if float(dict(t.split("=") for t in k.split("|"))["p0"]) == p0]
        return ", ".join(f"{v[key]:g}" for _, v in sorted(cells, key=lambda c: c[0]))
    return get


def grid_lams(d):
    lams = sorted({float(dict(t.split("=") for t in k.split("|"))["lam"]) for k in d["cells"]["grid"]})
    return ", ".join(f"{l:g}" for l in lams)


def grid_p0_zero(d):
    """smallest grid p0 whose measured mean rank is 0 at every lam."""
    by = {}
    for k, v in d["cells"]["grid"].items():
        a = dict(t.split("=") for t in k.split("|"))
        by.setdefault(float(a["p0"]), []).append(v["rank_meas_mean"])
    return min(p for p, r in by.items() if max(r) == 0)


def boundary_lam(p0):
    """pre-registered complete-collapse weight decay at the boundary p0 closest to p0."""
    def get(d):
        b = d["boundary"]
        i = min(range(len(b["p0"])), key=lambda j: abs(b["p0"][j] - p0))
        return b["lam_collapse"][i]
    return get


def boundary_p0_none(d):
    """smallest boundary p0 predicted to collapse at every lam on the boundary grid (lam_collapse None)."""
    b = d["boundary"]
    return min(p for p, l in zip(b["p0"], b["lam_collapse"]) if l is None)


def traj_r2(pred):
    def get(d):
        return min(x["r2"] for x in d if pred(x["cfg"]))
    return get


