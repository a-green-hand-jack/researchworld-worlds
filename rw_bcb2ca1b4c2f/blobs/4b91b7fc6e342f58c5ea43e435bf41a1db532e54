"""Direction A, exploratory: phase-model re-escape step per direction (code/e4_theory.py, from the exact state at
K = 300) against the exact scalar maps (first step with |a| > 0.05), four E1b AdamW settings. Written while deriving
the mechanism; not A1 data. Usage: python3 code/checks/e4_phase_first.py > results/e4/explore/phase_first.txt"""
import sys, os, numpy as np
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from e4_theory import scalar_adamw, phase_model, measured_escape
from e1b import SIG, C
thr, K, T = 0.05, 300, 20000
for p0, lam, a0 in [(2.0, 0.005, 1e-4), (0.5, 0.005, 1e-4), (2.0, 0.05, 1e-4), (1.0, 0.02, 1e-2)]:
    _, st = scalar_adamw(C, SIG, a0, p0, lam, 0.02, K, keep=[K])
    _, first = phase_model(C, SIG, st[K], K, lam, 0.02, T, thr)
    meas, _, _ = measured_escape(C, SIG, a0, p0, lam, 0.02, T, thr, K)
    print(f"p0={p0} lam={lam} a0={a0} (eta 0.02, betas 0.9/0.999)")
    print("  pred", " ".join(f"{x:.0f}" for x in first))
    print("  meas", " ".join(f"{x:.0f}" for x in meas))
