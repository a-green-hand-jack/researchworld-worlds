"""Post-hoc (not scoring): for the A1 held-out directions that are dead at a checkpoint after an earlier alive one,
the minimum |a| between the first crossing of 0.05 and T (80-bit maps, as the ground truth of code/e4_a1.py).
Separates a true second collapse (|a| falls by orders of magnitude) from a captured amplitude hovering at the
threshold. Output: results/e4/a1/recur.txt"""
import sys, os, json, gzip
import numpy as np
from multiprocessing import Pool
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
import e4_a1 as A

def one(args):
    cfg, ks = args
    c, s = A.stats(cfg["stats"]); L = np.longdouble
    c, s = c.astype(L), s.astype(L); eta, lam, b1, b2, eps = (L(cfg[x]) for x in ("eta", "lam", "b1", "b2")) , None, None, None, None
    eta, lam, b1, b2 = (L(cfg[x]) for x in ("eta", "lam", "b1", "b2")); eps = L(1e-8)
    a = A.init_a(cfg).astype(L); p = np.full(c.shape, L(cfg["p0"]))
    ma = np.zeros_like(c); va = np.zeros_like(c); mp = np.zeros_like(c); vp = np.zeros_like(c)
    seen = np.zeros(c.size, bool); mn = np.full(c.size, np.inf, L); dec = 1 - eta * lam
    for t in range(1, A.T + 1):
        r = c - p * s; ga = -a * p * r; gp = -a * a * r
        ma = b1 * ma + (1 - b1) * ga; va = b2 * va + (1 - b2) * ga * ga
        mp = b1 * mp + (1 - b1) * gp; vp = b2 * vp + (1 - b2) * gp * gp
        bc1, bc2 = 1 - b1 ** t, 1 - b2 ** t
        a = a * dec - eta * (ma / bc1) / (np.sqrt(va / bc2) + eps); p = p * dec - eta * (mp / bc1) / (np.sqrt(vp / bc2) + eps)
        if t > A.K:
            Aa = np.abs(a); seen |= Aa > A.THR; mn = np.where(seen, np.minimum(mn, Aa), mn)
    return [(cfg["id"], k, float(mn[k])) for k in ks]

if __name__ == "__main__":
    runs = [json.loads(l) for l in gzip.open("results/e4/a1/a1_runs.jsonl.gz", "rt")]
    cfgs = {c["id"]: c for c in A.configs()}; jobs = []
    for r in runs:
        Al = np.array(r["alive"], bool); rec = ((Al.cumsum(0) > 0) & ~Al).any(0)
        if rec.any():
            jobs.append((cfgs[r["id"]], [int(k) for k in np.where(rec)[0]]))
    with Pool(8) as pool:
        out = [x for part in pool.map(one, jobs) for x in part]
    mn = np.array([x[2] for x in out])
    lines = [f"directions {len(out)} in {len(jobs)} runs",
             "min |a| after first crossing of 0.05: quantiles 0/10/50/90/100% = " + " ".join(f"{q:.3g}" for q in np.quantile(mn, [0, .1, .5, .9, 1])),
             f"share with min |a| >= 0.025 (hover at the threshold): {(mn >= 0.025).mean():.3f}",
             f"share with min |a| < 1e-3 (second collapse): {(mn < 1e-3).mean():.3f}"]
    open("results/e4/a1/recur.txt", "w").write("\n".join(lines) + "\n"); print("\n".join(lines))
