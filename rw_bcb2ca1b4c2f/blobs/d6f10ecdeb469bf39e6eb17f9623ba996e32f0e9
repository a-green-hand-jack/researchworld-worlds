import json, gzip, math
W = "/hutian/work/b1p"
def walk(a, b, p, diffs):
    if isinstance(a, dict) and isinstance(b, dict):
        for k in set(a) | set(b):
            if k not in a or k not in b:
                diffs.append((p + "/" + str(k), "missing")); continue
            walk(a[k], b[k], p + "/" + str(k), diffs)
    elif isinstance(a, list) and isinstance(b, list):
        if len(a) != len(b): diffs.append((p, "len")); return
        for i, (x, y) in enumerate(zip(a, b)): walk(x, y, p + f"[{i}]", diffs)
    elif isinstance(a, float) and isinstance(b, float):
        if not (a == b or (math.isnan(a) and math.isnan(b))): diffs.append((p, a, b))
    elif a != b:
        diffs.append((p, a, b))
out = {}
for g in ["b1p_fresh", "b1p"]:
    d = json.load(open(f"{W}/out/{g}/delivered_score_a1.json"))
    r = json.load(open(f"{W}/out/{g}/rescore_score_a1.json"))
    diffs = []; walk(d, r, "", diffs)
    a = [json.loads(l) for l in gzip.open(f"{W}/e5__{g}__b1p_{g}_scored_runs.jsonl.gz", "rt")]
    b = [json.loads(l) for l in gzip.open(f"{W}/out/{g}/rescore_scored_runs.jsonl.gz", "rt")]
    rd = []; walk(a, b, "", rd)
    out[g] = dict(score_diffs=len(diffs), first=[str(x) for x in diffs[:10]],
                  scored_runs=[len(a), len(b)], scored_run_diffs=len(rd), first_runs=[str(x) for x in rd[:5]])
print(json.dumps(out, indent=1))
