"""Independent check of the E8-R reading (experiment-repo 10357a5 results/e8/e8r/summary.json, counts.csv, the 15 runs in
runs_P_lo_PR_c04_PR_ramp.tar.gz; registration results/e8/prediction.json addendum_E8R + amendment_E8R_1 at afccf8e).
From the raw log.jsonl of each run: recompute the online-token count (eigenvalues >= 1e-3 x the largest) at every epoch
from the logged spectrum, compare with the logged count_1e3 and counts.csv, and recompute E8's gap rule (Welch 95% CI
excludes 0 and |Delta| >= 5), the ramp differences and f_ramp with my own Welch / bootstrap at horizons 30, 40, 50.
Usage: python3 checks/e8r_reading_check.py /path/to/unpacked/tarball /path/to/counts.csv > checks/e8r_reading_check.json"""
import sys, os, json, csv, glob
import numpy as np
from scipy import stats

root, csvp = sys.argv[1], sys.argv[2]


def welch(x, y, level=0.95):
    x, y = np.asarray(x, float), np.asarray(y, float)
    r = stats.ttest_ind(x, y, equal_var=False)
    ci = r.confidence_interval(level)
    return [float(x.mean() - y.mean()), float(ci.low), float(ci.high)]


rows = {}
mism = 0; nonfinite = 0; maxcount = 0
for d in sorted(glob.glob(os.path.join(root, "*", "s*"))):
    if not os.path.isdir(d):
        continue
    L = [json.loads(l) for l in open(os.path.join(d, "log.jsonl"))]
    full = {int(round(r["epoch"])): r for r in L if r.get("full")}
    cnt = {}
    for e, r in full.items():
        ev = np.asarray(r["online_tok"]["eig"], float)
        nonfinite += int(not np.all(np.isfinite(ev)))
        c = int((ev >= 1e-3 * ev.max()).sum()); cnt[e] = c; maxcount = max(maxcount, len(ev))
        mism += int(c != r["online_tok"]["count_1e3"])
    rows.setdefault(os.path.basename(os.path.dirname(d)), {})[os.path.basename(d)] = cnt
csvrows = list(csv.DictReader(open(csvp)))
csv_mism = 0
for r in csvrows:
    arm = r["row"] if r["row"] in rows else {"P_lo": "P_lo"}.get(r["row"], r["row"])
    for e in range(51):
        csv_mism += int(int(r[f"ep{e}"]) != rows[arm][r["seed"]][e])
out = dict(runs={k: len(v) for k, v in rows.items()}, spectrum_size=maxcount, recount_vs_logged_mismatches=mism,
           csv_vs_recount_mismatches=csv_mism, nonfinite_spectra=nonfinite, horizons={})
g = np.random.default_rng(1)
for ep in (30, 40, 50):
    N = [rows["P_lo"][s][ep] for s in sorted(rows["P_lo"])]
    Hh = [rows["PR_c04"][s][ep] for s in sorted(rows["PR_c04"])]
    R = [rows["PR_ramp"][s][ep] for s in sorted(rows["PR_ramp"])]
    gap = welch(Hh, N)
    inf = (gap[1] > 0 or gap[2] < 0) and abs(gap[0]) >= 5
    h = dict(mean=dict(c004=float(np.mean(N)), c04=float(np.mean(Hh)), ramp=float(np.mean(R))), gap=gap, informative=bool(inf),
             ramp_minus_c004=welch(R, N), ramp_minus_c04=welch(R, Hh))
    if inf:
        f = lambda a, b, c: (np.mean(a) - np.mean(b)) / (np.mean(c) - np.mean(b))
        bs = [f(g.choice(R, 5), g.choice(N, 5), g.choice(Hh, 5)) for _ in range(20000)]
        h["f_ramp"] = [float(f(R, N, Hh)), float(np.nanquantile(bs, 0.025)), float(np.nanquantile(bs, 0.975))]
    out["horizons"][str(ep)] = h
# horizon-matched references: the recipe's wd and lr schedules as vit_jepa.py (warm-up 40/300, cosine lr to 0 over 9750
# steps; wd = 0.4 + (0.04 - 0.4) (1 + cos(pi step / 9750)) / 2): lr-weighted dose above 0.04 up to epoch H as a fraction
# of constant 0.4's up to H, and the current-level fraction (wd(H) - 0.04) / 0.36
import math
tot, lr0 = 9750, 3e-4; warm = int(40 / 300 * tot)
lr = lambda s: lr0 * s / max(warm, 1) if s < warm else lr0 * 0.5 * (1 + math.cos(math.pi * (s - warm) / max(tot - warm, 1)))
wd = lambda s: 0.4 + (0.04 - 0.4) * 0.5 * (1 + math.cos(math.pi * min(s / tot, 1.0)))
out["horizon_matched_references"] = {
    str(H): dict(dose_fraction=sum(lr(s) * (wd(s) - 0.04) for s in range(H * 195)) / sum(lr(s) * 0.36 for s in range(H * 195)),
                 wd_at_H=wd(H * 195), current_level_fraction=(wd(H * 195) - 0.04) / 0.36) for H in (30, 40, 50)}
out["curves_mean"] = {k: [float(np.mean([v[s][e] for s in v])) for e in range(51)] for k, v in rows.items()}
print(json.dumps(out, indent=1))
