% Stand-in for the official icml2025.sty (not supplied / not installed). Approximates ICML two-column geometry.
\NeedsTeXFormat{LaTeX2e}\ProvidesPackage{icml2025}
\DeclareOption{accepted}{}\DeclareOption{preprint}{}\ProcessOptions\relax
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in]{geometry}
\RequirePackage{times}\RequirePackage[numbers,sort&compress]{natbib}\RequirePackage{xcolor}
\RequirePackage{fancyhdr}\RequirePackage{titlesec}
\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}
\renewcommand{\rmdefault}{ptm}
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{8pt}{3pt}\titlespacing*{\subsection}{0pt}{6pt}{2pt}
\newcommand{\icmltitlerunning}[1]{\fancyhf{}\fancyhead[C]{\small #1}\pagestyle{fancy}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
\newcommand{\icmltitle}[1]{\begin{center}{\LARGE\bfseries #1}\end{center}}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\newcommand{\icmlauthor}[2]{#1}
\renewenvironment{abstract}{\begin{center}{\large\bfseries Abstract}\end{center}\begin{quote}\small}{\end{quote}}
\setlength{\parindent}{10pt}
