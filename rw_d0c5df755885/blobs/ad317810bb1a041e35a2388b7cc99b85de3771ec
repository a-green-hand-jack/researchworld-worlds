from pathlib import Path
import re

root = Path('data/many')
root.mkdir(parents=True, exist_ok=True)
for number in range(1, 1501):
    (root / f'f{number:04d}.txt').write_text(f'{number}\n')
expected = {f'f{n:04d}.txt' for n in range(1, 1501)}
assert {p.name for p in root.iterdir()} == expected
for number in range(1, 1501):
    assert (root / f'f{number:04d}.txt').read_bytes() == f'{number}\n'.encode()
lines = Path('checks/status-loop.txt').read_text().splitlines()
assert sum(bool(re.fullmatch(r'\d{2}:\d{2}:\d{2}', x)) for x in lines) == 24
assert lines.count('ok') + lines.count('failed') == 24
errors = [Path(f'checks/status-err-{n}.txt') for n in range(1, 25)]
assert all(p.is_file() for p in errors)
print('Verified 1500 filenames, f0001.txt through f1500.txt, each containing its integer and a newline.')
print(f"Verified 24 loop timestamps and outcomes: {lines.count('ok')} ok, {lines.count('failed')} failed.")
print('Verified all 24 per-iteration stderr files exist.')
for p in errors:
    if p.stat().st_size:
        print(f'Nonempty stderr: {p}')
