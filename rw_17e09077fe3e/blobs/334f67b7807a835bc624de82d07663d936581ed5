"""Reproduce the fixed-size study; run from the repository root."""
import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import math
from pathlib import Path
import platform
import time

import numpy as np
import scipy
from scipy.stats import t

N = 1_000_000
K = 20
ROOT_SEED = 20261019


def sample(seed):
    start = time.perf_counter()
    rng = np.random.Generator(np.random.PCG64(seed))
    points = rng.random((N, 2), dtype=np.float64)
    inside = int(np.count_nonzero(points[:, 0] ** 2 + points[:, 1] ** 2 <= 1.0))
    return {"spawn_key": list(seed.spawn_key), "points": N, "inside": inside,
            "estimate": 4 * inside / N, "elapsed_seconds": time.perf_counter() - start}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", default="results/pi_mc.json")
    args = parser.parse_args()
    start = time.perf_counter()
    seeds = np.random.SeedSequence(ROOT_SEED).spawn(K)
    # First full stream is a timed pilot and remains part of the prespecified study.
    rows = [sample(seeds[0])]
    print(f"Pilot: {N} points in {rows[0]['elapsed_seconds']:.3f} s; 19 streams remain", flush=True)
    with ThreadPoolExecutor(max_workers=2) as pool:
        for row in pool.map(sample, seeds[1:]):
            rows.append(row)
            print(f"Stream {row['spawn_key']}: inside={row['inside']}, estimate={row['estimate']:.8f}", flush=True)
    values = np.array([row["estimate"] for row in rows])
    mean = float(values.mean())
    sd = float(values.std(ddof=1))
    se = sd / math.sqrt(K)
    critical = float(t.ppf(0.975, K - 1))
    total_inside = sum(row["inside"] for row in rows)
    pooled = 4 * total_inside / (N * K)
    assert len(rows) == K and len({tuple(row['spawn_key']) for row in rows}) == K
    assert all(0 <= row['inside'] <= N for row in rows)
    assert math.isclose(mean, pooled, rel_tol=0, abs_tol=1e-14)
    theory_sd = math.sqrt(math.pi * (4 - math.pi) / N)
    result = {
        "source": "Synthetic draws generated by analysis/monte_carlo.py; no input data files",
        "rng": "numpy.random.Generator(PCG64(SeedSequence))",
        "seed_scheme": "SeedSequence(root_seed).spawn(20); child spawn keys recorded below",
        "root_seed": ROOT_SEED, "seed_sequence_pool_size": 4,
        "versions": {"python": platform.python_version(), "numpy": np.__version__, "scipy": scipy.__version__},
        "sampling": "1,000,000 independent uniform [0,1)^2 pairs per stream; inside iff x*x+y*y <= 1",
        "runs": rows, "mean_estimate": mean, "sample_sd": sd, "standard_error": se,
        "ci_method": "Two-sided Student t interval across 20 seed estimates; sample SD uses ddof=1",
        "confidence_level": 0.95, "degrees_of_freedom": K - 1, "t_critical": critical,
        "ci_95": [mean - critical * se, mean + critical * se],
        "math_pi": math.pi, "signed_error": mean - math.pi, "absolute_error": abs(mean - math.pi),
        "total_points": N * K, "total_inside": total_inside,
        "checks": {"pooled_estimate": pooled, "theoretical_per_seed_sd": theory_sd,
                   "observed_to_theoretical_sd_ratio": sd / theory_sd,
                   "math_pi_in_interval": bool(abs(mean - math.pi) <= critical * se)},
        "elapsed_seconds": time.perf_counter() - start,
    }
    path = Path(args.output)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({key: result[key] for key in ["mean_estimate", "ci_95", "signed_error", "total_points", "elapsed_seconds"]}), flush=True)


if __name__ == "__main__":
    main()
