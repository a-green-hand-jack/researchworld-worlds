"""Pilot running estimate of pi vs samples. Reads experiment-repo results/trace.csv and estimate.json.
usage: python3 make_figure.py TRACE_CSV ESTIMATE_JSON OUT_PNG"""
import csv, json, math, sys
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

trace, est, out = sys.argv[1:4]
rows = list(csv.DictReader(open(trace)))
n = [float(r["samples"]) for r in rows]
e = [float(r["estimate"]) for r in rows]
lo = [float(r["ci95_low"]) for r in rows]
hi = [float(r["ci95_high"]) for r in rows]
E = json.load(open(est))
fe = E.get("estimate"); ci = E.get("ci95")

fig, (a, b) = plt.subplots(1, 2, figsize=(11, 4.4), gridspec_kw={"width_ratios": [1, 1]})
for ax, zoom in ((a, False), (b, True)):
    ax.fill_between(n, lo, hi, color="#9ecae1", alpha=0.6, label="pointwise 95% CI (Wald)")
    ax.plot(n, e, "o-", color="#08519c", ms=3, lw=1.2, label="running estimate")
    ax.axhline(math.pi, color="#d62728", lw=1.3, ls="--", label=r"true $\pi$ = 3.14159265")
    ax.set_xscale("log")
    ax.set_xlabel("number of samples (log scale)")
    ax.set_ylabel(r"estimate of $\pi$")
    if zoom:
        k = max(1, len(n) // 4)
        ax.set_xlim(n[k], n[-1] * 1.05)
        sub = [(l, h) for x, l, h in zip(n, lo, hi) if x >= n[k]]
        ax.set_ylim(min(l for l, _ in sub) - 1e-4, max(h for _, h in sub) + 1e-4)
        ax.set_title("zoom: later part of the run")
    else:
        ax.set_ylim(math.pi - 0.015, math.pi + 0.015)
        ax.set_title("full run")
    ax.grid(alpha=0.3)
a.legend(loc="upper right", fontsize=8)
if ci:
    fig.suptitle(f"Pilot: final estimate {fe:.6f}, 95% CI [{ci[0]:.6f}, {ci[1]:.6f}], n = {E.get('samples', int(n[-1])):,}", fontsize=10)
fig.tight_layout()
fig.savefig(out, dpi=150)
