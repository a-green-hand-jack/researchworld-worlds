            if cc:
                ce = [c for c in cc if c["crossing_eligible"]]
                crit[f"C4 arm {arm} {src}"] = dict(n=len(cc), direction_held=sum(c["direction_holds"] for c in cc),
                                                   crossing_eligible=len(ce), crossing_held=sum(bool(c["crossing_holds"]) for c in ce))
    R = {r["name"]: r for r in rows}
    if "F_T_wd0.03" in R and "F_T_wd0.01" in R:
