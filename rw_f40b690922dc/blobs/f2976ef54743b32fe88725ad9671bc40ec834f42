            r = horizon_rule(cfg, fo, T, wd_scale=f["wd_scale"]) if cfg["wd"][0] > 0 else horizon_rule(cfg, fo, T)
            per.append(dict(seed=cfg["seed"], **r, online_count_1e3=m0["online_tok"]["count_1e3"]))
