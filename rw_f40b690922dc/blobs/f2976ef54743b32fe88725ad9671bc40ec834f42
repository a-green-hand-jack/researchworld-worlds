"""E3 frozen grid, forward predictions from initialisation, SLURM job scripts and scoring.

Grid (frozen after the E3 pilot; results/e3_pilot/): one factor at a time around two baselines, 3 seeds each.
- Arm P ("practice"): our 32x32 scaling of the I-JEPA recipe (code/e3_ijepa.py defaults: AdamW, target LayerNorm,
  lr warmup+cosine, wd cosine 0.04->0.4, EMA 0.996->1), schedules defined over FULL_EPOCHS, each sweep run is
  its first RUN_EPOCHS epochs.
- Arm T ("theory-aligned"): SGD momentum 0.9, constant lr 0.05, copy target (stop-grad, tau=0), no target LayerNorm,
  no LayerNorm inside the predictor, weight decay on every parameter (norm gains included), constant wd.
  Baseline wd 1e-2 (the predictor and target factors need lam > 0: the theory's alpha effect vanishes at lam = 0).
Usage:
  python3 code/e3_grid.py list                         # the grid
  python3 code/e3_grid.py sbatch-init  DIR             # SLURM script: step-0 force decomposition of every run
  python3 code/e3_grid.py predict INITDIR results/e3   # prediction.json from the step-0 logs only
  python3 code/e3_grid.py sbatch-runs  DIR results/e3/prediction.json [names...]  # SLURM array scripts (one per arm), 1 config x 3 seeds per GPU task
  python3 code/e3_grid.py analyze RUNDIR results/e3    # scoring -> results/e3/summary.json, runs.csv
  python3 code/e3_grid.py predict-followup INITDIR results/e3  # C4 interventions + full-length runs -> prediction_followup.json
  python3 code/e3_grid.py sbatch-followup DIR          # their SLURM array (needs DIR/e3_armT.sbatch as template)
  python3 code/e3_grid.py analyze-followup RUNDIR results/e3   # -> results/e3/summary_followup.json
  python3 code/e3_grid.py compute RUNDIR results/e3            # -> results/e3/compute.json (GPU and wall time per run)
"""
import sys, os, json, math, itertools, re
import numpy as np

FULL_EPOCHS = 50
RUN_EPOCHS = 20
SEEDS = [0, 1, 2]
STEPS_PER_EPOCH = 195
FORCE_STEPS = [0, 5, 10, 20, 50, 100, 200, 400, 800, 1600, 2400, 3200, 3800]
COMMON = ["--epochs", str(RUN_EPOCHS), "--full-epochs", str(FULL_EPOCHS), "--threads", "2", "--probe-every", "0"]
ARM_T = dict(opt="sgd", lr=0.05, sched="const", target="copy", target_ln=0, pred_norm=0, decay_norm=1, wd=[1e-2, 1e-2])


def grid():
    G = {}
    P = dict()
    G["P_base"] = ("P", "base", None, P)
    for v in [1, 6]:
        G[f"P_pdepth{v}"] = ("P", "pred_depth", v, dict(pred_depth=v))
    G["P_pwidth128"] = ("P", "pred_width", 128, dict(pred_width=128))
    for v in [0.1, 10]:
        G[f"P_plr{v:g}"] = ("P", "pred_lr_mult", v, dict(pred_lr_mult=v))
    for v in [0.1, 3]:
        G[f"P_pinit{v:g}"] = ("P", "pred_init_scale", v, dict(pred_init_scale=v))
    G["P_targets1"] = ("P", "mask", "targets1", dict(n_targets=1))
    G["P_ctx0.4"] = ("P", "mask", "ctx0.4", dict(context_scale=[0.4, 0.5]))
    G["P_tscale_hi"] = ("P", "mask", "tscale_hi", dict(target_scale=[0.3, 0.4]))
    G["P_tscale_lo"] = ("P", "mask", "tscale_lo", dict(target_scale=[0.05, 0.1]))
    G["P_nosg"] = ("P", "target", "nosg", dict(target="nosg"))
    G["P_copy"] = ("P", "target", "copy", dict(target="copy"))
    for v in [0.9, 0.99, 0.999]:
        G[f"P_ema{v:g}"] = ("P", "target", f"ema{v:g}", dict(ema=[v, v]))
    G["P_frozen"] = ("P", "target", "frozen", dict(target="frozen"))
    G["P_wd0"] = ("P", "wd", 0.0, dict(wd=[0.0, 0.0]))
    G["P_wd0.04"] = ("P", "wd", 0.04, dict(wd=[0.04, 0.04]))
    G["P_wdlarge"] = ("P", "wd", "large", dict(wd=[None, None]))     # value set by the prediction (2x critical)
    for v in [0.0, 1e-3, 3e-3, 1e-2, 3e-2, 1e-1]:
        G[f"T_wd{v:g}"] = ("T", "wd", v, dict(ARM_T, wd=[v, v]))
    for v in [0.1, 10]:
        G[f"T_plr{v:g}"] = ("T", "pred_lr_mult", v, dict(ARM_T, pred_lr_mult=v))
    for v in [0.3, 3]:
        G[f"T_pinit{v:g}"] = ("T", "pred_init_scale", v, dict(ARM_T, pred_init_scale=v))
    G["T_nosg"] = ("T", "target", "nosg", dict(ARM_T, target="nosg"))
    G["T_frozen"] = ("T", "target", "frozen", dict(ARM_T, target="frozen"))
    G["T_ema0.99"] = ("T", "target", "ema0.99", dict(ARM_T, target="ema", ema=[0.99, 0.99]))
    return G


def cli_args(over):
    out = []
    for k, v in over.items():
        flag = "--" + k.replace("_", "-")
        out += [flag] + ([str(x) for x in v] if isinstance(v, list) else [str(v)])
    return out


def sbatch(name, lines, hours="01:00:00"):
    tag = os.environ.get("HT_RESOURCE_TAG", "rw")
    return "\n".join(["#!/bin/bash", f"#SBATCH --job-name={tag}-{name}", "#SBATCH --gres=gpu:1",
                      "#SBATCH --cpus-per-task=6", "#SBATCH --mem=40G", f"#SBATCH --time={hours}",
                      f"#SBATCH --output=%x_%j.out", "cd \"$SLURM_SUBMIT_DIR\"", "nvidia-smi --query-gpu=name --format=csv"]
                     + lines + ["wait", f"echo HUTIAN_WAKE: {name} done"]) + "\n"


def cmd_sbatch_init(d, wd_large=None):
    """Every run of the grid (3 seeds), stopped after its first step: config.json and the step-0 force decomposition."""
    G = grid(); lines = []
    for i, (name, (_, _, _, over)) in enumerate(G.items()):
        over = dict(over)
        if over.get("wd") == [None, None]:
            over["wd"] = [1.0, 1.0]           # unit decay: the decay force is linear in wd, rescaled in predict
        for s in SEEDS:
            out = f"init/{name}/s{s}"
            lines.append(f"mkdir -p {out}; venv/bin/python -u e3_ijepa.py --out {out} --data data --seed {s} "
                         + " ".join(COMMON + cli_args(over)) + f" --max-steps 1 --force-steps 0 > {out}.log 2>&1 &")
        lines.append("wait")
    open(os.path.join(d, "e3init.sbatch"), "w").write(sbatch("e3init", lines, "02:00:00"))
    print(os.path.join(d, "e3init.sbatch"), len(G) * len(SEEDS), "runs")


# ----------------------------------------------------------------------------- forward prediction

def schedules(cfg, T):
    tf = cfg["total_full"]; warm = int(cfg["warmup_frac"] * tf); lr0 = cfg["lr"]
    s = np.arange(T); f = s / tf
    if cfg["sched"] == "const":
        lr = np.full(T, lr0)
    else:
        lr = np.where(s < warm, lr0 * s / max(warm, 1), 0.5 * lr0 * (1 + np.cos(np.pi * np.clip((s - warm) / max(tf - warm, 1), 0, 1))))
    w0, w1 = cfg["wd"]
    wd = w1 + (w0 - w1) * 0.5 * (1 + np.cos(np.pi * np.minimum(f, 1)))
    return lr, wd


def horizon_rule(cfg, f, T, wd_scale=1.0):
    """Linearised race over the run's horizon T from the step-0 forces only.
    Per eigendirection k of the online token covariance at init (eigenvalue e_k): the gradient part (drive D_k +
    self-prediction S_k, x 1/(1-momentum) for SGD with momentum, whose steady-state step is that much larger) scales
    with lr(t); the decoupled decay part L_k with lr(t) wd(t). log e_k(T) = log e_k + sum_t rate_k(t), and growth
    saturates at the initial top eigenvalue. Predicted count = #{e_k(T) >= 1e-3 max_j e_j(T)} (the measured count's
    rule); predicted total-variance ratio = sum e(T) / sum e(0)."""
    D = np.array(f["d_eig_drive"]); S = np.array(f["d_eig_selfpred"]); L = np.array(f["d_eig_wd"]); ev = np.array(f["eig"])
    lr, wd = schedules(cfg, T); lr_ref = cfg["lr"]; wd_ref = cfg["wd"][0]
    M = 1.0 / (1.0 - cfg["momentum"]) if cfg["opt"] == "sgd" else 1.0
    Gk = M * (D + S) * lr.sum() / lr_ref
    Lk = L * wd_scale * (lr * wd).sum() / (lr_ref * wd_ref) if wd_ref > 0 else 0.0 * L
    top = ev.max(); ok = ev > 1e-12 * top
    R = np.where(ok, (Gk + Lk) / np.maximum(ev, 1e-300), -np.inf)
    logT = np.minimum(np.log(np.maximum(ev, 1e-300)) + R, np.log(top))
    eT = np.exp(logT)
    return dict(count=int((eT >= 1e-3 * eT.max()).sum()), tv_ratio=float(eT.sum() / ev.sum()),
                window=int(((M * (D + S) + L * wd_scale) > 0).sum()), count0=int((ev >= 1e-3 * top).sum()))


def load_init(initdir, name):
    out = []
    for s in SEEDS:
        d = os.path.join(initdir, name, f"s{s}")
        cfg = json.load(open(os.path.join(d, "config.json")))
        L = [json.loads(l) for l in open(os.path.join(d, "log.jsonl"))]
        f = [r for r in L if r.get("force") and r["step"] == 0][0]
        m0 = [r for r in L if r.get("full") and r["step"] == 0][0]
        out.append((cfg, f, m0))
    return out


def critical_wd(runs, T, grid_w, frac=0.5):
    """Smallest wd on a fine log grid at which the predicted count falls below frac x count at init, in >= 2 of 3
    seeds; the forces were computed at the run's own wd and are rescaled linearly."""
    for w in grid_w:
        k = 0
        for cfg, f, _ in runs:
            r = horizon_rule(cfg, f, T, wd_scale=w / cfg["wd"][0])
            k += r["count"] < frac * r["count0"]
        if k >= 2:
            return float(w)
    return None


CRITERIA = {
    "C-rank (forward, primary)": "Spearman rho between the predicted count (horizon rule, mean over seeds) and the measured "
                                 "online-token count at the end of the run (mean over seeds), within each arm (nosg "
                                 "configs excluded, see the predictor note), >= 0.5 and "
                                 "its bootstrap 95% CI (over configs) excludes 0",
    "C-dir (forward)": "for each factor, each adjacent pair of grid values (each mask setting against the base) whose "
                       "predicted mean counts differ by more than the tolerance max(2, sd_a + sd_b) (sd = sample standard "
                       "deviation of the predicted count over the 3 seeds) has a predicted sign; the measured centred "
                       "RankMe change has that sign in >= 2 of 3 seeds (plan default). Every other pair is registered "
                       "as an explicit null ('no predicted difference'), which holds if the measured mean counts differ "
                       "by at most max(2, sd_a + sd_b) of the measured counts. Scored as the fractions of signed pairs "
                       "and of nulls that hold, and listed",
    "C-loc wd (forward)": "location of the dimensional-collapse transition in weight decay (Arm T wd sweep): the observed "
                          "transition (geometric midpoint of the last healthy and first collapsed grid value; collapsed = "
                          "online count < 0.5 x its value at init in >= 2 of 3 seeds) lies within a factor of 2 of the "
                          "predicted critical wd (plan default for log-scaled knobs)",
    "C-theory signs (forward)": "signs from theory/derivations.md Sec. 4 independent of the init forces: rank falls with "
                                "weight decay (both arms), with the predictor lr multiplier (both arms, lam > 0) and with "
                                "predictor depth (Arm P); nosg ends in complete collapse (total online variance < 1e-6 x "
                                "init, or centred RankMe < 1.5; Prop. 5); frozen target at standard init does not collapse "
                                "(online count >= 0.5 x init; Sec. 4 frozen row with c|w0| > lam); EMA rate changes the "
                                "count by less than the seed spread at matched schedule (EMA changes time scales, not the "
                                "threshold) - each scored per seed majority",
    "C-diag (diagnostic, not forward)": "the count of directions with measured drive+decay > 0 at step 800 and 3200 "
                                        "(force decomposition during the run) vs the final count: Spearman within arm",
}


def cmd_predict(initdir, outdir):
    G = grid(); T = RUN_EPOCHS * STEPS_PER_EPOCH
    runs = {}; preds = {}
    for name in G:
        runs[name] = load_init(initdir, name)
    # wd location predictions from the baselines' own forces
    fine = list(np.geomspace(1e-4, 1e2, 121))
    wdc_T = critical_wd(runs["T_wd0.01"], T, fine)
    wdc_P = critical_wd(runs["P_wd0.04"], T, fine)
    wdc_P_ext = critical_wd(runs["P_wd0.04"], T, list(np.geomspace(1e2, 1e5, 61)))
    lr_P, _ = schedules(runs["P_wd0.04"][0][0], T)
    if wdc_P is not None:
        wd_large = float(f"{2 * wdc_P:.2g}"); wd_large_rule = "2 x the predicted Arm P critical wd (frozen grid)"
    else:   # no predicted transition on the grid: fall back to the scale where decoupled decay alone is strong
        wd_large = float(f"{5 / lr_P.sum():.2g}")
        wd_large_rule = ("fallback: the horizon rule predicts no Arm P transition for wd <= 1e2, so 2 x critical is "
                         "undefined; wd_large = 5 / sum_t lr(t) over the horizon, where decoupled decay alone would "
                         "shrink every weight by e^-5 (constant wd)")
    for name, (arm, factor, value, over) in G.items():
        per = []
        for cfg, f, m0 in runs[name]:
            if name == "P_wdlarge":       # init run made at unit constant wd
                r = horizon_rule(cfg, f, T, wd_scale=wd_large)
            else:
                r = horizon_rule(cfg, f, T)
            gains = dict(online_count_1e3=m0["online_tok"]["count_1e3"], online_rankme_c=m0["online_tok"]["rankme_c"],
                         online_total_var=m0["online_tok"]["total_var"])
            per.append(dict(seed=cfg["seed"], **r, **gains))
        preds[name] = dict(arm=arm, factor=factor, value=value, over=over,
                           count_pred=float(np.mean([p["count"] for p in per])),
                           tv_ratio_pred=float(np.mean([p["tv_ratio"] for p in per])),
                           window=float(np.mean([p["window"] for p in per])), per_seed=per)
    if wd_large is not None:
        preds["P_wdlarge"]["value"] = wd_large; preds["P_wdlarge"]["over"] = dict(wd=[wd_large, wd_large])
    # directional predictions: adjacent grid values of each factor (with the baseline in its place)
    order = {"pred_depth": [("P_pdepth1", 1), ("P_base", 3), ("P_pdepth6", 6)],
             "pred_width": [("P_base", 64), ("P_pwidth128", 128)],
             "pred_lr_mult P": [("P_plr0.1", 0.1), ("P_base", 1), ("P_plr10", 10)],
             "pred_init_scale P": [("P_pinit0.1", 0.1), ("P_base", 1), ("P_pinit3", 3)],
             "wd P": [("P_wd0", 0), ("P_wd0.04", 0.04), ("P_wdlarge", wd_large)],
             "ema P": [("P_copy", 0), ("P_ema0.9", 0.9), ("P_ema0.99", 0.99), ("P_ema0.999", 0.999)],
             "wd T": [(f"T_wd{v:g}", v) for v in [0.0, 1e-3, 3e-3, 1e-2, 3e-2, 1e-1]],
             "pred_lr_mult T": [("T_plr0.1", 0.1), ("T_wd0.01", 1), ("T_plr10", 10)],
             "pred_init_scale T": [("T_pinit0.3", 0.3), ("T_wd0.01", 1), ("T_pinit3", 3)],
             "ema T": [("T_wd0.01", 0), ("T_ema0.99", 0.99)]}
    pairs = [(fac, a, va, b, vb) for fac, seq in order.items() for (a, va), (b, vb) in zip(seq, seq[1:])]
    pairs += [("mask P", "P_base", "base", m, m[2:]) for m in ["P_targets1", "P_ctx0.4", "P_tscale_hi", "P_tscale_lo"]]
    dirs = []
    # nosg is outside the horizon rule: its step-0 split detaches the target path (code/e3_ijepa.py losses), so the
    # gradient through the target is missing; nosg is scored only by the theory sign (Prop. 5) and left out of C-rank
    for fac, a, va, b, vb in pairs:
        dc = preds[b]["count_pred"] - preds[a]["count_pred"]
        sd = lambda n: float(np.std([q["count"] for q in preds[n]["per_seed"]], ddof=1))
        tol = max(2.0, sd(a) + sd(b))
        dirs.append(dict(factor=fac, low=a, high=b, low_value=va, high_value=vb, d_count_pred=dc, tolerance=tol,
                         sign=(0 if abs(dc) <= tol else int(np.sign(dc))),
                         registered=("no predicted difference" if abs(dc) <= tol else "sign")))
    theory_signs = [
        dict(test="rank falls with weight decay", runs=[s[0] for s in order["wd T"]], sign=-1),
        dict(test="rank falls with weight decay", runs=[s[0] for s in order["wd P"]], sign=-1),
        dict(test="rank falls with the predictor lr multiplier when lam > 0 (Sec. 4, alpha row)", runs=[s[0] for s in order["pred_lr_mult P"]], sign=-1),
        dict(test="rank falls with the predictor lr multiplier when lam > 0 (Sec. 4, alpha row)", runs=[s[0] for s in order["pred_lr_mult T"]], sign=-1),
        dict(test="rank falls with predictor depth (Sec. 4, depth row; E1c)", runs=[s[0] for s in order["pred_depth"]], sign=-1),
        dict(test="nosg: complete collapse (Prop. 5)", runs=["P_nosg", "T_nosg"]),
        dict(test="frozen target at standard init: no collapse of the online encoder", runs=["P_frozen", "T_frozen"]),
        dict(test="EMA rate: no change beyond seed spread", runs=["P_copy", "P_ema0.9", "P_ema0.99", "P_ema0.999", "P_base"]),
    ]
    doc = dict(experiment="E3", status="pre-registered: computed from each run's own initialisation (step-0 force "
                                       "decomposition, metrics at step 0) and hyperparameters, before any E3 sweep run",
               note=__doc__.split("Usage")[0].strip(),
               definitions=dict(
                   space="online encoder token embeddings (the space the loss acts on and the force decomposition is "
                         "computed in); target-encoder and mean-pooled ranks are reported alongside",
                   rank_count="eigenvalues of the centred token covariance >= 1e-3 x the largest, on the first 10000 "
                              "CIFAR-10 test images, at the end of the run (epoch RUN_EPOCHS)",
                   rankme_c="exp-entropy of the normalised singular values of the centred embeddings; raw RankMe alongside",
                   complete_collapse="total centred variance < 1e-6 x its value at init, or centred RankMe < 1.5",
                   dimensional_collapse="count < 0.5 x the count at init (at init the count is ~27 of 128)",
                   horizon=f"{RUN_EPOCHS} epochs = {T} steps of a {FULL_EPOCHS}-epoch schedule",
                   seeds=SEEDS),
               predictor=horizon_rule.__doc__.strip(),
               development="the horizon rule was written after the 13 GPU pilot runs (results/e3_pilot/), and checked on "
                           "them (development only); none of the sweep runs below had been run when this file was written",
               critical_wd=dict(arm_T=wdc_T, arm_P_constant=wdc_P, arm_P_large_chosen=wd_large, arm_P_large_rule=wd_large_rule,
                                arm_P_beyond_grid=wdc_P_ext,
                                arm_P_beyond_grid_note="diagnostic only: there lr x wd > 1 for part of the horizon (lr0 = "
                                                       f"{runs['P_wd0.04'][0][0]['lr']:g}), so decoupled decay is no longer a "
                                                       "contraction and the linearised rule is outside its range",
                                rule="smallest wd (log grid 1e-4..1e2) with predicted count < 0.5 x count at init in >= 2 of 3 seeds"),
               adamw_note="under AdamW the step-0 update is lr sign(g) per parameter (Adam's first step), so the "
                          "horizon rule is insensitive to gradient scale and the predictor lr multiplier never enters "
                          "the encoder's step-0 force: in Arm P it predicts nearly equal counts for the predictor "
                          "factors; their directions are registered from the theory signs instead",
               masking_from_M2=json.load(open(os.path.join(outdir, "mask_stats.json")))["order_vs_base"]
               if os.path.exists(os.path.join(outdir, "mask_stats.json")) else None,
               masking_note="the linear M2 proxy (results/e3/mask_stats.json) leaves the order of the mask settings "
                            "undetermined (it changes with lam, p0), so no masking direction is registered from it; the "
                            "masking predictions are the horizon rule's",
               success_criteria=CRITERIA, configs=preds, directions=dirs, theory_signs=theory_signs,
               command=" ".join(sys.argv))
    json.dump(doc, open(os.path.join(outdir, "prediction.json"), "w"), indent=1)
    print("critical wd T", wdc_T, "P", wdc_P, "large", wd_large)
    for n, p in preds.items():
        print(f"{n:14s} count_pred {p['count_pred']:6.1f} tv {p['tv_ratio_pred']:.3g} window {p['window']:.0f}")
    print(sum(d["sign"] != 0 for d in dirs), "directional pairs with a predicted sign of", len(dirs))
    for d in dirs:
        print(f"  {d['factor']:18s} {d['low']:12s} -> {d['high']:12s} d_count {d['d_count_pred']:+7.1f} tol {d['tolerance']:5.1f} {d['registered']} {d['sign']:+d}")


def cmd_sbatch_runs(d, names, pred_file):
    """One Slurm array per arm (Arm P first), one array task per config with its 3 seeds packed on one GPU, time
    limit <= 2 h (story-repo#6 conditions). A task skips seeds whose final.json exists, so a failed or pre-empted
    config is resumed by resubmitting its index. Each run directory gets provenance.json (code commit, md5 of
    e3_ijepa.py, pip freeze, node, GPU)."""
    P = json.load(open(pred_file))
    G = grid(); names = names or list(G)
    commit = os.environ.get("CODE_COMMIT", "unknown")
    for arm in ["P", "T"]:
        sel = [n for n in names if G[n][0] == arm]
        if not sel:
            continue
        cases = []
        for i, name in enumerate(sel):
            over = dict(G[name][3])
            if name == "P_wdlarge":
                over["wd"] = P["configs"]["P_wdlarge"]["over"]["wd"]
            body = []
            for s_ in SEEDS:
                out = f"runs/{name}/s{s_}"
                body.append(f"  if [ ! -f {out}/final.json ]; then mkdir -p {out}; prov {out}; venv/bin/python -u e3_ijepa.py "
                            f"--out {out} --data data --seed {s_} " + " ".join(COMMON + cli_args(over))
                            + " --force-steps " + " ".join(map(str, FORCE_STEPS)) + f" > {out}.log 2>&1 & fi")
            cases.append(f"{i}) # {name}\n" + "\n".join(body) + "\n  ;;")
        tag = os.environ.get("HT_RESOURCE_TAG", "rw")
        txt = "\n".join([
            "#!/bin/bash", f"#SBATCH --job-name={tag}-e3arm{arm}", f"#SBATCH --array=0-{len(sel) - 1}",
            "#SBATCH --gres=gpu:1", "#SBATCH --cpus-per-task=6", "#SBATCH --mem=40G", "#SBATCH --time=01:45:00",
            "#SBATCH --output=logs/%x_%A_%a.out", "cd \"$SLURM_SUBMIT_DIR\"",
            "GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1); echo \"$GPU\"",
            "prov() { venv/bin/python - \"$1\" <<'PY'",
            "import json, sys, subprocess, hashlib, os, socket",
            f"json.dump(dict(code_commit='{commit}', e3_ijepa_md5=hashlib.md5(open('e3_ijepa.py','rb').read()).hexdigest(),",
            "               pip_freeze=subprocess.run([sys.executable, '-m', 'pip', 'freeze'], capture_output=True, text=True).stdout.split(),",
            "               node=socket.gethostname(), gpu=os.environ.get('GPU'), slurm_job=os.environ.get('SLURM_JOB_ID'),",
