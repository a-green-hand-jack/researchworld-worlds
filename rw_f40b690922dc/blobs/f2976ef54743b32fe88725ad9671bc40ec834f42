def spearman(x, y):
    from scipy.stats import spearmanr
    x, y = np.asarray(x, float), np.asarray(y, float)
    if len(x) < 3 or np.ptp(x) == 0 or np.ptp(y) == 0:
        return dict(rho=None, ci=None, n=len(x))
    rho = float(spearmanr(x, y)[0]); rng = np.random.default_rng(0); bs = []
    for _ in range(2000):
        i = rng.integers(0, len(x), len(x))
        if np.ptp(x[i]) > 0 and np.ptp(y[i]) > 0:
            bs.append(spearmanr(x[i], y[i])[0])
    return dict(rho=rho, ci=[float(np.nanpercentile(bs, 2.5)), float(np.nanpercentile(bs, 97.5))], n=len(x))


def measured(rundir, name):
    out = []
    for s in SEEDS:
        d = os.path.join(rundir, name, f"s{s}")
        if not os.path.exists(os.path.join(d, "final.json")):     # unfinished or failed run: not scored
            continue
        try:
            L = [json.loads(l) for l in open(os.path.join(d, "log.jsonl"))]
        except FileNotFoundError:
            continue
        full = [r for r in L if r.get("full")]; F = {r["step"]: r for r in L if r.get("force")}
        nonfinite = any(r.get("nonfinite") for r in L)
        m0, m1 = full[0], full[-1]
        rec = dict(seed=s, steps=m1["step"], nonfinite=nonfinite)
        for sp in ["online_tok", "target_tok", "online_pool", "target_pool"]:
            if sp in m1:
                rec[sp] = {k: m1[sp][k] for k in ["count_1e3", "rankme_c", "rankme_raw", "total_var"] if k in m1[sp]}
                rec[sp + "_0"] = {k: m0[sp][k] for k in ["count_1e3", "rankme_c", "total_var"] if k in m0[sp]}
        o, o0 = rec["online_tok"], rec["online_tok_0"]
        rec["complete_collapse"] = bool(nonfinite or o["total_var"] < 1e-6 * o0["total_var"] or o["rankme_c"] < 1.5)
        rec["dim_collapse"] = bool(rec["complete_collapse"] or o["count_1e3"] < 0.5 * o0["count_1e3"])
        for st in (800, 3200):
            if st in F:
                f = F[st]; D, S_, W = (np.array(f[k]) for k in ("d_eig_drive", "d_eig_selfpred", "d_eig_wd"))
                rec[f"n_net_growth_{st}"] = int((D + S_ + W > 0).sum())
        rec["probe"] = m1.get("online_probe") or m1.get("target_probe")
        # linear probe (ridge on pooled features, ridge picked on a validation split, CIFAR-10 test accuracy)
        pa = lambda r, k: (r.get(k) or {}).get("probe_acc", np.nan)
        rec["probe_online"], rec["probe_target"], rec["probe_init"] = pa(m1, "online_probe"), pa(m1, "target_probe"), pa(m0, "online_probe")
        out.append(rec)
    return out



def export_trajectories(rundir, meta, outpath, forcepath):
    """Per-run files for the figures: trajectories (every logged step) and spectra, one JSON line per (config, seed).
    meta: name -> dict of fields copied into each line (arm, factor, value, count_pred, collapse_pred, ...)."""
    nt = nf = 0
    with open(outpath, "w") as ft, open(forcepath, "w") as ff:
        for name, mt in meta.items():
            for s in SEEDS:
                d = os.path.join(rundir, name, f"s{s}")
                if not os.path.exists(os.path.join(d, "final.json")):
                    continue
                L = [json.loads(l) for l in open(os.path.join(d, "log.jsonl"))]
                M = [r for r in L if not r.get("force")]; full = [r for r in M if r.get("full")]
                g = lambda sp, k: [r[sp][k] if sp in r else None for r in M]
                rec = dict(name=name, seed=s, **mt, step=[r["step"] for r in M], epoch=[r.get("epoch") for r in M],
                           full=[bool(r.get("full")) for r in M], loss=[r.get("loss") for r in M], lr=[r.get("lr") for r in M],
                           wd=[r.get("wd") for r in M], ema=[r.get("ema") for r in M])
                for sp in ("online_tok", "target_tok", "online_pool", "target_pool"):
                    for k in ("count_1e3", "rankme_c", "rankme_raw", "total_var", "std"):
                        rec[f"{sp}_{k}"] = g(sp, k)
                # spectra (eigenvalues of the centred token covariance, 10000 test images): init, epoch 1, epoch 5, final
                rec["spectra"] = {f"{r['step']}": dict(online=[float(f"{x:.5g}") for x in r["online_tok"]["eig"]],
                                                        target=[float(f"{x:.5g}") for x in r["target_tok"]["eig"]])
                                  for r in full if r["step"] in (0, STEPS_PER_EPOCH, 5 * STEPS_PER_EPOCH) or r is full[-1]}
                rec["probe"] = [dict(step=r["step"], epoch=r.get("epoch"), online=r["online_probe"]["probe_acc"],
                                     target=r["target_probe"]["probe_acc"] if r.get("target_probe") else None)
                                for r in full if r.get("online_probe")]
                ft.write(json.dumps(rec) + "\n"); nt += 1
                for r in L:
                    if r.get("force"):
                        D, S_, W = (np.array(r[k]) for k in ("d_eig_drive", "d_eig_selfpred", "d_eig_wd"))
                        rd = lambda v: [float(f"{x:.5g}") for x in v]     # 5 significant digits
                        ff.write(json.dumps(dict(name=name, seed=s, arm=mt.get("arm"), step=r["step"], eig=rd(r["eig"]),
                                                 d_eig_drive=rd(r["d_eig_drive"]), d_eig_selfpred=rd(r["d_eig_selfpred"]), d_eig_wd=rd(r["d_eig_wd"]),
                                                 n_net_growth=int((D + S_ + W > 0).sum()))) + "\n"); nf += 1
    return nt, nf


def cmd_analyze(rundir, outdir):
    P = json.load(open(os.path.join(outdir, "prediction.json")))
    C = P["configs"]; M = {n: measured(rundir, n) for n in C}
    rows = []
    for n, c in C.items():
        m = M[n]
        if not m:
            continue
        mean = lambda f: float(np.mean([f(r) for r in m]))
        rows.append(dict(name=n, arm=c["arm"], factor=c["factor"], value=c["value"], seeds=len(m),
                         count_pred=c["count_pred"], tv_ratio_pred=c["tv_ratio_pred"],
                         count=mean(lambda r: r["online_tok"]["count_1e3"]), rankme_c=mean(lambda r: r["online_tok"]["rankme_c"]),
                         tv_ratio=float(np.exp(np.mean([np.log(max(r["online_tok"]["total_var"], 1e-300) / r["online_tok_0"]["total_var"]) for r in m]))),
                         target_count=mean(lambda r: r["target_tok"]["count_1e3"]), target_rankme_c=mean(lambda r: r["target_tok"]["rankme_c"]),
                         complete_collapse=sum(r["complete_collapse"] for r in m), dim_collapse=sum(r["dim_collapse"] for r in m),
                         nonfinite=sum(r["nonfinite"] for r in m),
                         n_net_growth_800=mean(lambda r: r.get("n_net_growth_800", np.nan)),
                         n_net_growth_3200=mean(lambda r: r.get("n_net_growth_3200", np.nan)),
                         count_sd=float(np.std([r["online_tok"]["count_1e3"] for r in m], ddof=1)) if len(m) > 1 else float("nan"),
                         count_seeds=" ".join(str(r["online_tok"]["count_1e3"]) for r in m),
                         count_init=mean(lambda r: r["online_tok_0"]["count_1e3"]),
                         rankme_c_seeds=" ".join(f'{r["online_tok"]["rankme_c"]:.2f}' for r in m),
                         probe_online=mean(lambda r: r["probe_online"]), probe_target=mean(lambda r: r["probe_target"]),
                         probe_init=mean(lambda r: r["probe_init"])))
    R = {r["name"]: r for r in rows}
    crit = {}
    for arm in ["P", "T"]:
        rr = [r for r in rows if r["arm"] == arm and r["value"] != "nosg"]   # nosg is outside the horizon rule (cmd_predict)
        sp = spearman([r["count_pred"] for r in rr], [r["count"] for r in rr])
        crit[f"C-rank arm {arm}"] = dict(sp, passed=None if sp["rho"] is None else bool(sp["rho"] >= 0.5 and sp["ci"][0] > 0))
        dg = {st: spearman([r[f"n_net_growth_{st}"] for r in rr], [r["count"] for r in rr]) for st in (800, 3200)}
        crit[f"C-diag arm {arm}"] = dg
    # directions
    dres = []; nres = []
    for d in P["directions"]:
        if not M.get(d["low"]) or not M.get(d["high"]):
            continue
        if d["sign"] != 0:
            lo = {r["seed"]: r["online_tok"]["rankme_c"] for r in M[d["low"]]}; hi = {r["seed"]: r["online_tok"]["rankme_c"] for r in M[d["high"]]}
            k = sum(np.sign(hi[s] - lo[s]) == d["sign"] for s in SEEDS if s in lo and s in hi)
            dres.append(dict(d, seeds_agree=int(k), holds=bool(k >= 2)))
        else:
            ca = [r["online_tok"]["count_1e3"] for r in M[d["low"]]]; cb = [r["online_tok"]["count_1e3"] for r in M[d["high"]]]
            tol = max(2.0, float(np.std(ca, ddof=1) + np.std(cb, ddof=1))) if min(len(ca), len(cb)) > 1 else 2.0
            dm = float(np.mean(cb) - np.mean(ca))
            nres.append(dict(d, d_count_meas=dm, tolerance_meas=tol, holds=bool(abs(dm) <= tol)))
    frac = lambda x: (sum(d["holds"] for d in x) / len(x)) if x else None
    crit["C-dir"] = dict(signed_pairs=len(dres), signed_held=sum(d["holds"] for d in dres), signed_fraction=frac(dres),
                         nulls=len(nres), nulls_held=sum(d["holds"] for d in nres), nulls_fraction=frac(nres),
                         signed=dres, null_list=nres)
    # wd location, Arm T
    seq = [n for n in C if n.startswith("T_wd")]
    seq.sort(key=lambda n: C[n]["value"])
    healthy = [n for n in seq if n in R and R[n]["dim_collapse"] < 2]; coll = [n for n in seq if n in R and R[n]["dim_collapse"] >= 2]
    obs = None
    if coll:
        first = coll[0]; prev = [n for n in seq if C[n]["value"] < C[first]["value"] and n in healthy]
        if prev and C[prev[-1]]["value"] > 0:
            obs = float(math.sqrt(C[prev[-1]]["value"] * C[first]["value"]))
        elif prev:
            obs = float(C[first]["value"]) / 2 ** 0.5
    pc = P["critical_wd"]["arm_T"]
    crit["C-loc wd arm T"] = dict(observed=obs, predicted=pc, ratio=(obs / pc) if (obs and pc) else None,
                                  passed=(None if not (obs and pc) else bool(0.5 <= obs / pc <= 2.0)))
    # theory signs
    ts = []
    for t in P["theory_signs"]:
        runs = [n for n in t["runs"] if n in R]
        if "sign" in t:
            pairs = list(zip(runs, runs[1:])); hold = []
            for a, b in pairs:
                lo = {r["seed"]: r["online_tok"]["rankme_c"] for r in M[a]}; hi = {r["seed"]: r["online_tok"]["rankme_c"] for r in M[b]}
                k = sum(np.sign(hi[s] - lo[s]) == t["sign"] for s in SEEDS if s in lo and s in hi)
                hold.append(dict(low=a, high=b, seeds_agree=int(k), holds=bool(k >= 2)))
            ts.append(dict(t, pairs=hold, passed=bool(hold) and all(h["holds"] for h in hold)))
        elif t["test"].startswith("nosg"):
            ts.append(dict(t, result={n: R[n]["complete_collapse"] for n in runs}, passed=bool(runs) and all(R[n]["complete_collapse"] >= 2 for n in runs)))
        elif t["test"].startswith("frozen"):
            ts.append(dict(t, result={n: R[n]["dim_collapse"] for n in runs}, passed=bool(runs) and all(R[n]["dim_collapse"] <= 1 for n in runs)))
        else:   # EMA: no change beyond the seed spread
            vals = {n: [r["online_tok"]["count_1e3"] for r in M[n]] for n in runs}
            spread = max(np.std(v) for v in vals.values()) if vals else None
            means = [np.mean(v) for v in vals.values()]
            ts.append(dict(t, means={n: float(np.mean(v)) for n, v in vals.items()}, max_seed_std=float(spread) if spread is not None else None,
                           range=float(np.ptp(means)) if means else None,
                           passed=None if not means else bool(np.ptp(means) <= 2 * spread + 1e-9)))
    crit["C-theory signs"] = ts
    meta = {n: dict(arm=c["arm"], factor=c["factor"], value=c["value"], count_pred=c["count_pred"],
                    collapse_pred=bool(sum(q["count"] < 0.5 * q["online_count_1e3"] for q in c["per_seed"]) >= 2))
            for n, c in C.items()}
    nt, nf = export_trajectories(rundir, meta, os.path.join(outdir, "trajectories.jsonl"), os.path.join(outdir, "forces.jsonl"))
    # post hoc (not registered): what Arm T's C-rank rests on, wd sweep vs the other factors
    rT = [r for r in rows if r["arm"] == "T" and r["value"] != "nosg"]
    split = {k: dict(spearman([r["count_pred"] for r in g], [r["count"] for r in g]), configs=[r["name"] for r in g],
                     count_pred=[r["count_pred"] for r in g], count=[r["count"] for r in g])
             for k, g in (("wd sweep", [r for r in rT if r["factor"] == "wd"]), ("other factors", [r for r in rT if r["factor"] != "wd"]))}
    at_base = {r["name"]: r["count"] for r in rows if r["arm"] == "T" and (r["factor"] != "wd" or r["value"] == 0.01)}
    post_hoc = {"C-rank arm T split": dict(split, note="post hoc diagnostic, not a registered criterion"),
                "Arm T variants at wd 0.01 (count)": dict(at_base, T_wd0=R["T_wd0"]["count"] if "T_wd0" in R else None,
                                                          note="every non-wd Arm T config runs at the baseline wd 0.01")}
    S = dict(prediction_commit_note="scored against results/e3/prediction.json", rows=rows, criteria=crit, post_hoc=post_hoc,
             files=dict(trajectories=nt, forces=nf), command=" ".join(sys.argv))
    json.dump(S, open(os.path.join(outdir, "summary.json"), "w"), indent=1)
    import csv
    with open(os.path.join(outdir, "runs.csv"), "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(rows[0].keys())); w.writeheader(); w.writerows(rows)
    for k, v in crit.items():
        print(k, json.dumps(v)[:400])


def cmd_compute(rundir, outdir):
    """Per-run compute record from each run's provenance.json and final.json -> results/e3/compute.json."""
    runs = []
    for name in sorted(os.listdir(rundir)):
        for s in SEEDS:
            d = os.path.join(rundir, name, f"s{s}")
            if not os.path.exists(os.path.join(d, "final.json")):
                continue
            pv, fn = json.load(open(os.path.join(d, "provenance.json"))), json.load(open(os.path.join(d, "final.json")))
            runs.append(dict(name=name, seed=s, gpu=pv.get("gpu"), code_commit=pv.get("code_commit"),
                             e3_ijepa_md5=pv.get("e3_ijepa_md5"), steps=fn["steps"], seconds=round(fn["seconds"], 1)))
    by = {}
    for r in runs:
        b = by.setdefault(r["gpu"], dict(runs=0, run_hours=0.0, configs=set()))
        b["runs"] += 1; b["run_hours"] += r["seconds"] / 3600; b["configs"].add(r["name"])
    by = {g: dict(runs=b["runs"], run_hours=round(b["run_hours"], 2), configs=sorted(b["configs"])) for g, b in by.items()}
    S = dict(note="wall time of each training run (final.json seconds, evaluation included) on one GPU of a SLURM cluster; "
                  "3 runs (the seeds of one config) shared one GPU at a time, so GPU-hours are lower than run-hours",
             runs_total=len(runs), run_hours_total=round(sum(r["seconds"] for r in runs) / 3600, 2), by_gpu=by, runs=runs,
             command=" ".join(sys.argv))
    json.dump(S, open(os.path.join(outdir, "compute.json"), "w"), indent=1)
    print(json.dumps({g: {k: v for k, v in b.items() if k != "configs"} for g, b in by.items()}), S["run_hours_total"])


