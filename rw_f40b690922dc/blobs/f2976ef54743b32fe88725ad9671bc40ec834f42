# ----------------------------------------------------------------------------- follow-up: C4 interventions, full-length runs

FULL_PROBE_EVERY = 5


def followup():
    """C4 interventions and the full-length runs (story-repo plan v1.2 Sec. 3 E3). Chosen after the sweep runs had
    started, from their partial logs (epoch ~6-16 of 20): in Arm T, wd 0.03 and 0.1 fall below 0.5 x the init count
    (collapsing), wd 0 and 1e-3 rise above it (healthy); in Arm P, the copy target falls to ~21 of 116 (P_base).
    Each intervention changes one knob of a sweep config (its parent, same seeds and initialisation), in the
    direction prescribed by theory/derivations.md Sec. 4 (source "theory") or by the horizon rule (source "rule").
    Its step-0 forces are those of an existing init run (`init`), rescaled to its wd (`wd_scale`): the predictor lr
    and the target update do not enter the encoder's step-0 force, and the decay force is linear in wd."""
    T = lambda wd, **k: dict(ARM_T, wd=[wd, wd], **k)
    F = {}
    for wd in (0.1, 0.03):
        F[f"I_T_wd{wd:g}_plr0.1"] = dict(arm="T", kind="rescue", parent=f"T_wd{wd:g}", over=T(wd, pred_lr_mult=0.1),
                                       init="T_wd0.01", wd_scale=wd / 1e-2, sign=+1, source="theory",
                                       why="Sec. 4 alpha row: with lam > 0 a slower predictor (smaller alpha) lengthens the race clock 1/(alpha lam), so more directions escape")
        F[f"I_T_wd{wd:g}_pinit3"] = dict(arm="T", kind="rescue", parent=f"T_wd{wd:g}", over=T(wd, pred_init_scale=3),
                                       init="T_pinit3", wd_scale=wd / 1e-2, sign=+1, source="rule",
                                       why="the horizon rule's step-0 drive grows with the predictor init scale (T_pinit3 predicted 115 vs 18 at wd 1e-2); Sec. 4's p0 row is non-monotone, so the sign is the rule's")
    F["I_T_wd0.001_plr10"] = dict(arm="T", kind="break", parent="T_wd0.001", over=T(1e-3, pred_lr_mult=10), init="T_wd0.01",
                                  wd_scale=0.1, sign=-1, source="theory",
                                  why="Sec. 4 alpha row: a faster predictor shortens the race clock, so fewer directions escape")
    F["I_T_wd0.001_pinit0.3"] = dict(arm="T", kind="break", parent="T_wd0.001", over=T(1e-3, pred_init_scale=0.3),
                                     init="T_pinit0.3", wd_scale=0.1, sign=-1, source="rule",
                                     why="the horizon rule predicts 30.3 against the parent's 35.7 at wd 1e-3 (a fall of 5.4, above its tolerance); at wd 1e-2 the same init gave 20.0 against 18.0, so this sign holds only at small wd")
    F["I_P_copy_wd0"] = dict(arm="P", kind="rescue", parent="P_copy", over=dict(target="copy", wd=[0.0, 0.0]), init="P_copy",
                             wd_scale=0.0, sign=+1, source="theory",
                             why="Sec. 3-4: without decay there is no race (the predictor does not drift and no direction is lost to decay)")
    F["I_P_copy_plr0.1"] = dict(arm="P", kind="rescue", parent="P_copy", over=dict(target="copy", pred_lr_mult=0.1), init="P_copy",
                                wd_scale=1.0, sign=+1, source="theory",
                                why="Sec. 4 alpha row, as for Arm T; registered although the running sweep's P_plr0.1 (epoch 20) was below P_base, i.e. against this sign in Arm P")
    # full-length runs with the linear probe every FULL_PROBE_EVERY epochs: the two baselines and one collapsing config
    F["F_P_base"] = dict(arm="P", kind="full", parent="P_base", over=dict(), init="P_base", wd_scale=1.0)
    F["F_T_wd0.01"] = dict(arm="T", kind="full", parent="T_wd0.01", over=T(1e-2), init="T_wd0.01", wd_scale=1.0)
    F["F_T_wd0.03"] = dict(arm="T", kind="full", parent="T_wd0.03", over=T(0.03), init="T_wd0.01", wd_scale=3.0)
    return F


def followup_args(f):
    a = list(COMMON)
    if f["kind"] == "full":
        a[a.index("--epochs") + 1] = str(FULL_EPOCHS); a[a.index("--probe-every") + 1] = str(FULL_PROBE_EVERY)
    return a + cli_args(f["over"])


