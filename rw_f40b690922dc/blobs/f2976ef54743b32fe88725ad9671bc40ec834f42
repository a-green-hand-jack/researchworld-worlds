            if f["kind"] == "rescue":
                elig = coll(f["parent"]) >= 2; cross = coll(n) <= 1
            else:
                elig = coll(f["parent"]) <= 1; cross = coll(n) >= 2
            c4.append(dict(name=n, arm=f["arm"], source=f["source"], kind=f["kind"], sign=f["sign"], seeds_agree=int(k),
                           direction_holds=bool(k >= 2), crossing_eligible=bool(elig), crossing_holds=bool(cross) if elig else None))
        if f["kind"] == "full":
