def e2c(name, key, fmt=None):
    return lambda d: (fmt or (lambda x: x))(d["criteria"][name][key])


def e2a(arm, key, fmt=f2, field="mae"):
    return lambda d: fmt(d["arms"][arm][key][field][0])


def e2_profile_end(prof, which):
    def get(d):
        row = d["profiles"][prof][-1]
        return "{:.0f}".format(sum(row["meas"]) / len(row["meas"]) if which == "meas" else row["pred"])
    return get


def e2_peak_edge(d):
    """Profiles whose predicted maximisers include the largest r of the run grid (bern, block 0.9; multiblock 4*14/64)."""
    edge = {"bern": 0.9, "block": 0.9, "multiblock": 4 * 14 / 64}
    return sum(any(abs(r - edge[p["profile"].split("/")[1]]) < 1e-9 for r in p["pred_peak_r"]) for p in d["peaks"])


def e2_miss_flow(d):
    """Rank of the exact reduced flow at T_long for the failed peak profile (bern, r=0.9, lam=3e-3, p0=0.25); one value over seeds."""
    v = {x["rank_long"] for x in d["per_run"] if x["fam"] == "bern" and x["r"] == 0.9 and x["lam"] == 0.003 and x["p0"] == 0.25}
    assert len(v) == 1
    return v.pop()


def e2_crit_pass(d):
    return sum(c["passed"] for c in d["criteria"].values())

def e3row(name, key="count", fmt="{:.0f}", rows="rows"):
    """one field of a named E3 row (summary.json or summary_followup.json)."""
    def get(d):
        r = next(r for r in d[rows] if r["name"] == name)
        return fmt.format(r[key])
    return get


def e3rows(names, key="count", fmt="{:.0f}"):
    def get(d):
        by = {r["name"]: r for r in d["rows"]}
        return ", ".join(fmt.format(by[n][key]) for n in names)
    return get


def e3range(names, key="count"):
    def get(d):
        by = {r["name"]: r[key] for r in d["rows"]}
        v = [by[n] for n in names]
        return f"{min(v):.1f}--{max(v):.0f}"
    return get


def e3rho(arm):
