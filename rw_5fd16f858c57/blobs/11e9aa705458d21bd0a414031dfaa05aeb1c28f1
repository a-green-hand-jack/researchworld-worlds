import csv, numpy as np, mpmath as mp
from scipy.integrate import romb
mp.mp.dps = 40
F = {"exp(-x^2)": (lambda x: np.exp(-x*x), lambda x: mp.exp(-x*x)),
     "x^(1/3)": (lambda x: np.cbrt(x), lambda x: mp.cbrt(x))}
ref = {k: mp.quad(v[1], [0, 1]) for k, v in F.items()}
gx, gw = np.polynomial.legendre.leggauss(4)
def trap(f, n):
    x = np.linspace(0, 1, n+1); y = f(x); return (y.sum()-0.5*(y[0]+y[-1]))/n
def simp(f, n):
    x = np.linspace(0, 1, 2*n+1); y = f(x); return (y[0]+y[-1]+4*y[1:-1:2].sum()+2*y[2:-1:2].sum())/(6*n)
def gl(f, n):
    a = np.arange(n)/n; h = 1/n
    xs = a[:, None]+h*(gx[None, :]+1)/2
    return (f(xs)*gw[None, :]).sum()*h/2
def rom(f, n):
    x = np.linspace(0, 1, n+1); return romb(f(x), dx=1/n)
rules = {"trapezoid": trap, "simpson": simp, "gauss4": gl, "romberg": rom}
rows = []
for fn, (f, _) in F.items():
    for rn, r in rules.items():
        for k in range(1, 11):
            n = 2**k; v = r(f, n)
            err = abs(mp.mpf(float(v)) - ref[fn])
            rows.append([fn, rn, k, n, repr(float(v)), "%.6e" % float(err)])
with open("results/errors.csv", "w", newline="") as fh:
    w = csv.writer(fh); w.writerow(["function", "rule", "k", "n", "value", "abs_error"]); w.writerows(rows)
with open("results/reference.csv", "w") as fh:
    fh.write("function,reference_40dps,mpmath_version\n")
    for k in ref: fh.write("%s,%s,%s\n" % (k, mp.nstr(ref[k], 40), mp.__version__))
fits = []
for fn in F:
    for rn in rules:
        p = [(r[3], float(r[5])) for r in rows if r[0] == fn and r[1] == rn and float(r[5]) > 1e-14]
        if len(p) >= 2:
            lx = np.log([a for a, _ in p]); ly = np.log([b for _, b in p])
            s_, c_ = np.polyfit(lx, ly, 1)
            r2 = 1 - ((ly-(s_*lx+c_))**2).sum()/((ly-ly.mean())**2).sum() if len(p) > 2 else float('nan')
            fits.append([fn, rn, len(p), " ".join(str(a) for a, _ in p), "%.4f" % -s_, "%.6f" % r2])
        else:
            fits.append([fn, rn, len(p), " ".join(str(a) for a, _ in p), "nan", "nan"])
with open("results/fits.csv", "w", newline="") as fh:
    w = csv.writer(fh); w.writerow(["function", "rule", "n_points_above_1e-14", "n_values_used", "order", "r_squared"]); w.writerows(fits)
print("HUTIAN_WAKE: sweep done", flush=True)
