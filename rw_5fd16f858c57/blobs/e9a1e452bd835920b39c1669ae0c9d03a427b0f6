import csv, io, subprocess, math, json
from decimal import Decimal, localcontext
repo='/hutian/experiment-repo'
rev='108a49046f192f4a2af69a0932fd18e7e5e3fff8'
def read(p,r=rev):
 return subprocess.check_output(['git','-C',repo,'show',r+':'+p],text=True)
def rows(p): return list(csv.DictReader(io.StringIO(read(p))))
e=rows('results/errors.csv'); fits=rows('results/fits.csv'); refs={r['function']:Decimal(r['reference_40dps']) for r in rows('results/reference.csv')}
old=list(csv.DictReader(io.StringIO(read('results/errors.csv','a56ccf8919b86dee2bf361d25cef6215d7033384'))))
assert [r for r in e if r['rule']!='romberg']==old
assert len(e)==80 and len({(r['function'],r['rule'],r['n']) for r in e})==80
assert read('results/reference.csv')==read('results/reference.csv','a56ccf8919b86dee2bf361d25cef6215d7033384')
max_abs_value_delta=0; max_error_rounding=0
for r in e:
 with localcontext() as ctx:
  ctx.prec=50
  err=abs(Decimal.from_float(float(r['value']))-refs[r['function']])
  max_error_rounding=max(max_error_rounding,float(abs(err-Decimal(r['abs_error']))/err))
 if r['rule']!='romberg': continue
 k=int(r['k']); n=int(r['n']); assert n==2**k and 1<=k<=10
 f=(lambda x:math.exp(-x*x)) if r['function']=='exp(-x^2)' else (lambda x:x**(1/3))
 # Independent dyadic trapezoid hierarchy with Richardson tableau.
 previous=[(f(0)+f(1))/2]
 for level in range(1,k+1):
  intervals=2**level
  current=[previous[0]/2+math.fsum(f(j/intervals) for j in range(1,intervals,2))/intervals]
  for col in range(1,level+1):
   current.append(current[-1]+(current[-1]-previous[col-1])/(4**col-1))
  previous=current
 delta=abs(previous[-1]-float(r['value'])); max_abs_value_delta=max(delta,max_abs_value_delta)
 assert delta<1e-15,(r,delta)
checks=[]
for f in fits:
 p=[r for r in e if r['function']==f['function'] and r['rule']==f['rule'] and float(r['abs_error'])>1e-14]
 assert len(p)==int(f['n_points_above_1e-14'])
 assert ' '.join(r['n'] for r in p)==f['n_values_used']
 x=[math.log(int(r['n'])) for r in p]; y=[math.log(float(r['abs_error'])) for r in p]
 xm=sum(x)/len(x); ym=sum(y)/len(y)
 slope=sum((a-xm)*(b-ym) for a,b in zip(x,y))/sum((a-xm)**2 for a in x)
 assert abs(-slope-float(f['order']))<0.00005
 r2=1-sum((b-ym-slope*(a-xm))**2 for a,b in zip(x,y))/sum((b-ym)**2 for b in y)
 if len(p)>2: assert abs(r2-float(f['r_squared']))<0.0000005
 checks.append({'function':f['function'],'rule':f['rule'],'points':len(p),'order':-slope,'r2':r2 if len(p)>2 else None})
print(json.dumps({'revision':rev,'rows':len(e),'unchanged_original_rows':len(old),'max_independent_romberg_value_delta':max_abs_value_delta,'max_error_relative_rounding':max_error_rounding,'fits':checks},indent=2))
