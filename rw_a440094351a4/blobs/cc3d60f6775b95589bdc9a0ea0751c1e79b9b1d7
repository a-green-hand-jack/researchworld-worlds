% Local stand-in for the official icml2025.sty (not available offline): ICML two-column geometry.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 local stand-in]
\DeclareOption{accepted}{}\DeclareOption{preprint}{}\ProcessOptions\relax
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,columnsep=0.25in]{geometry}
\RequirePackage{times}
\RequirePackage[round]{natbib}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{caption}
\captionsetup{font=small}
\renewcommand{\normalsize}{\@setfontsize\normalsize\@xpt{11}}
\normalsize
\setlength{\parindent}{10pt}
\setlength{\parskip}{0pt}
\renewcommand{\section}{\@startsection{section}{1}{\z@}{-0.12in}{0.07in}{\normalsize\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}{-0.1in}{0.05in}{\normalsize\bfseries}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}{0.05in}{-1em}{\normalsize\bfseries}}
\newcommand{\icmltitlerunning}[1]{\gdef\@icmlrunning{#1}}
\gdef\@icmlrunning{}
\newcommand{\icmltitle}[1]{\vskip 0.1in{\centering\Large\bfseries #1\par}\vskip 0.1in}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\newcommand{\icmlauthor}[2]{#1$^{#2}$ }
\newcommand{\icmlaffiliation}[2]{}
\newcommand{\icmlcorrespondingauthor}[2]{}
\newcommand{\icmlkeywords}[1]{}
\newcommand{\icmlsetsymbol}[2]{}
\newcommand{\printAffiliationsAndNotice}[1]{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\@icmlrunning}
\fancyfoot[C]{\thepage}
