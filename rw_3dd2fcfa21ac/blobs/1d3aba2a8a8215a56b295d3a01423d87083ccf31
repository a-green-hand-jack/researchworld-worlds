% Minimal stand-in for the ICML 2025 style (official file not available offline):
% two-column, 10pt Times, 6.75in x 9in text block, as in the ICML layout.
\ProvidesPackage{icml2025}
\makeatletter
\DeclareOption{accepted}{}\DeclareOption{nohyperref}{}\ProcessOptions\relax
\RequirePackage{times}\RequirePackage{fancyhdr}\RequirePackage[round]{natbib}
\RequirePackage{xcolor}
\setlength{\paperwidth}{8.5in}\setlength{\paperheight}{11in}
\setlength{\textwidth}{6.75in}\setlength{\textheight}{9.0in}
\setlength{\oddsidemargin}{-0.125in}\setlength{\evensidemargin}{-0.125in}
\setlength{\topmargin}{-0.5in}\setlength{\headheight}{12pt}\setlength{\headsep}{10pt}
\setlength{\columnsep}{0.25in}\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\newcommand{\icmltitlerunning}[1]{\fancyhead[C]{\small\textit{#1}}}
\newcommand{\icmltitle}[1]{\begin{center}{\LARGE\bfseries #1}\end{center}}
\newenvironment{icmlauthorlist}{\begin{center}}{\end{center}}
\newcommand{\icmlauthor}[2]{#1}
\newcommand{\icmlaffiliation}[2]{}\newcommand{\icmlcorrespondingauthor}[2]{}\newcommand{\icmlkeywords}[1]{}
\renewenvironment{abstract}{\begin{center}{\bfseries Abstract}\end{center}\begin{quote}\small}{\end{quote}}
\renewcommand\section{\@startsection{section}{1}{\z@}{-8pt plus -2pt}{4pt}{\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-6pt plus -2pt}{3pt}{\normalsize\bfseries}}

\makeatother
