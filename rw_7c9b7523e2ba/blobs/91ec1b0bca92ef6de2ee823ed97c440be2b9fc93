#!/usr/bin/env python3
"""Render the report's error-scaling figure and table material.

Reads the machine-readable results summary committed by experiment-repo
(``input_summary.json`` here is a verbatim copy of ``results/summary.json``
at experiment-repo commit 7d7d6432f3aa; see PROVENANCE.md) and writes
``error_scaling.svg``, ``error_scaling.png`` and ``error_table.md`` next to
itself (default output directory: the script's own directory).

Every plotted and tabulated number is copied from the input file. Nothing is
recomputed here: the fitted line is rendered by evaluating the committed OLS
intercept and slope at the committed sample sizes (a power law is exactly
straight on log-log axes, so this is a faithful rendering of the committed
fit, not a new estimate), and the benchmark curve uses the committed
analytic benchmark values. The shaded band is the committed 2.5/97.5
percentile range of the 200 run errors: a run-to-run dispersion summary, not
a confidence interval for the mean (per-N standard errors of the mean are
tabulated separately).

Usage (from the repository root):
    python3 report/figures/make_figure.py report/figures/input_summary.json
"""

import argparse
import json
import math
import pathlib
import sys

import matplotlib
matplotlib.use("Agg")
matplotlib.rcParams["svg.fonttype"] = "none"  # keep text as text: checkable in the SVG
matplotlib.rcParams["svg.hashsalt"] = "figtab-error-scaling"  # deterministic element ids
import matplotlib.pyplot as plt
from matplotlib.ticker import LogFormatterMathtext, LogLocator

NS_EXPECTED = [10**k for k in range(3, 8)]
EXP_REPO_COMMIT = "7d7d6432f3aa8b561323880db811d3910c1b78d1"


def fail(msg):
    print(f"make_figure: {msg}", file=sys.stderr)
    sys.exit(1)


def load_results(path):
    with open(path, encoding="utf-8") as f:
        r = json.load(f)
    for key in ("N", "mae", "mae_se", "run_error_p025", "run_error_p975",
                "benchmark_mae", "ols", "bootstrap", "provenance"):
        if key not in r:
            fail(f"input file {path} is missing required key '{key}'")
    if sorted(r["N"]) != NS_EXPECTED:
        fail(f"input N {r['N']} is not the five required sample sizes 10^3..10^7")
    for key in ("mae", "mae_se", "run_error_p025", "run_error_p975", "benchmark_mae"):
        if len(r[key]) != 5:
            fail(f"key '{key}' must have one value per N (5 values)")
    ols = r["ols"]
    for key in ("intercept", "slope", "t_interval_95"):
        if key not in ols:
            fail(f"input 'ols' is missing '{key}'")
    boot = r["bootstrap"]
    for key in ("interval_95", "replicates", "seed"):
        if key not in boot:
            fail(f"input 'bootstrap' is missing '{key}'")
    return r


def fmt(x, sig=4):
    """Format a committed number with `sig` significant digits (display only)."""
    if x == 0:
        return "0"
    exp10 = math.floor(math.log10(abs(x)))
    dec = max(0, sig - 1 - exp10)
    return f"{x:.{dec}f}" if dec > 0 else f"{x:.0f}"


def fmt_exp(x, sig=3):
    if x == 0:
        return "0"
    exp10 = math.floor(math.log10(abs(x)))
    dec = max(0, sig - 1 - exp10)
    return f"{x:.{dec}f}" if dec > 0 else f"{x:.0f}"


def contains_minus_half(r):
    in_boot = bool(r["bootstrap"].get("contains_minus_half"))
    in_t = bool(r["ols"].get("contains_minus_half"))
    if in_boot and in_t:
        return "both intervals contain the benchmark $-1/2$"
    if in_boot or in_t:
        return "only one interval contains the benchmark $-1/2$"
    return "neither interval contains the benchmark $-1/2$"


def render_figure(r, outdir):
    N = r["N"]
    mae = r["mae"]
    p025, p975 = r["run_error_p025"], r["run_error_p975"]
    bench = r["benchmark_mae"]
    slope = r["ols"]["slope"]
    intercept = r["ols"]["intercept"]
    boot_lo, boot_hi = r["bootstrap"]["interval_95"]
    t_lo, t_hi = r["ols"]["t_interval_95"]

    # Fitted line: committed intercept/slope evaluated at the committed N only.
    fit_y = [math.exp(intercept) * n**slope for n in N]

    fig, ax = plt.subplots(figsize=(6.4, 4.6))
    ax.fill_between(N, p025, p975, color="0.55", alpha=0.22, linewidth=0,
                    label="Run-to-run dispersion (2.5–97.5% of 200 run errors)")
    ax.plot(N, mae, "o", color="#1a55a5", markersize=5.5, label="Mean absolute error (200 runs)")
    ax.plot(N, fit_y, "-", color="#d97706", linewidth=1.6,
            label=f"OLS fit: slope {fmt_exp(slope, 3)}")
    ax.plot(N, bench, "--", color="#444444", linewidth=1.3,
            label="Asymptotic Monte Carlo benchmark (−1/2)")

    ax.set_xscale("log")
    ax.set_yscale("log")
    ax.set_xlabel("Number of samples $N$")
    ax.set_ylabel(r"Mean absolute error $|\hat{\pi}-\pi|$")
    ax.set_title("Monte Carlo estimate of $\\pi$: error scaling with sample size")
    ax.xaxis.set_major_locator(LogLocator(base=10))
    ax.xaxis.set_major_formatter(LogFormatterMathtext())
    ax.yaxis.set_major_locator(LogLocator(base=10))
    ax.yaxis.set_major_formatter(LogFormatterMathtext())
    ax.grid(True, which="major", linestyle=":", linewidth=0.5, alpha=0.5)
    ax.set_xlim(0.75e3, 1.4e7)

    note = (f"OLS exponent = {fmt_exp(slope, 4)}\n"
            f"95% bootstrap CI [{fmt_exp(boot_lo, 3)}, {fmt_exp(boot_hi, 3)}]\n"
            f"95% OLS-$t$ CI [{fmt_exp(t_lo, 3)}, {fmt_exp(t_hi, 3)}]\n"
            f"Benchmark $-1/2$: "
            + ("within both intervals" if r["bootstrap"].get("contains_minus_half")
               and r["ols"].get("contains_minus_half") else "not within both intervals"))
    ax.annotate(note, xy=(0.035, 0.035), xycoords="axes fraction",
                fontsize=8.5, family="monospace", va="bottom", ha="left",
                bbox=dict(boxstyle="round,pad=0.35", facecolor="white",
                          edgecolor="0.6", alpha=0.9))
    ax.legend(loc="upper right", fontsize=8.5, framealpha=0.9)
    fig.tight_layout()
    svg = outdir / "error_scaling.svg"
    png = outdir / "error_scaling.png"
    fig.savefig(svg, metadata={"Date": None})  # omit timestamp: byte-reproducible output
    fig.savefig(png, dpi=200)
    plt.close(fig)
    return svg, png


def render_table(r, outdir, svg_name):
    N, mae, se = r["N"], r["mae"], r["mae_se"]
    bench = r["benchmark_mae"]
    slope = r["ols"]["slope"]
    residual_df = r["ols"].get("residual_df", 3)
    boot = r["bootstrap"]
    boot_lo, boot_hi = boot["interval_95"]
    t_lo, t_hi = r["ols"]["t_interval_95"]

    rows = "\n".join(
        f"| $10^{{{int(round(math.log10(n)))}}}$ | {fmt(m)} | {fmt(s, 3)} | "
        f"{fmt_exp(m / b, 3)} |"
        for n, m, s, b in zip(N, mae, se, bench)
    )
    caption = (
        "**Figure 1.** Monte Carlo estimate of $\\pi$: mean absolute error "
        "$|\\hat{\\pi}-\\pi|$ against sample size $N$ on log-log axes. Points: "
        "mean absolute error over 200 independent estimates at each "
        "$N \\in \\{10^3,\\dots,10^7\\}$, each run using "
        "`numpy.random.default_rng` seeded with 2026 + zero-based run index "
        "(seeds 2026–2225) over a contiguous nested point stream, so each $N$ "
        "reuses the run's stream from the start. Shaded band: run-to-run "
        "dispersion — the 2.5–97.5 percentile range of the 200 individual "
        "run errors at each $N$; it is not a confidence interval for the mean "
        "(per-$N$ standard errors of the mean are given in the table). Solid "
        "line: OLS fit of $\\ln \\mathrm{MAE}$ on $\\ln N$, exponent "
        f"{fmt_exp(slope, 3)}; 95% paired-run percentile bootstrap interval "
        f"[{fmt_exp(boot_lo, 3)}, {fmt_exp(boot_hi, 3)}] "
        f"({boot['replicates']:,} replicates, seed {boot['seed']}); "
        f"conventional OLS-$t$ interval with {residual_df} residual degrees of "
        f"freedom [{fmt_exp(t_lo, 3)}, {fmt_exp(t_hi, 3)}]. Dashed line: "
        "asymptotic Monte Carlo benchmark with exponent $-1/2$, "
        "$\\sqrt{2/\\pi}\\,\\sqrt{4\\pi-\\pi^2}\\,N^{-1/2}$; "
        + contains_minus_half(r)
        + "."
    )
    text = f"""### Table 1: Mean absolute error of the Monte Carlo π estimate

| $N$ | Mean absolute error | SE of mean | MAE / benchmark |
|---:|---:|---:|---:|
{rows}

Fitted scaling (OLS of $\\ln \\mathrm{{MAE}}$ on $\\ln N$ across the five
sample sizes): exponent $\\hat\\beta = {fmt_exp(slope, 4)}$. 95% interval
[{fmt_exp(boot_lo, 3)}, {fmt_exp(boot_hi, 3)}] (percentile paired-run
bootstrap, {boot['replicates']:,} replicates, seed {boot['seed']}; primary
interval, preserving the five within-run errors together). Conventional
OLS-$t$ interval with {residual_df} residual degrees of freedom
[{fmt_exp(t_lo, 3)}, {fmt_exp(t_hi, 3)}] (diagnostic; assumes independent
log-scale errors). Monte Carlo benchmark: $-1/2$; {contains_minus_half(r)}.

{caption}

![Figure 1: error scaling]({svg_name})
"""
    out = outdir / "error_table.md"
    out.write_text(text, encoding="utf-8")
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("results_json",
                    help="experiment-repo results summary (JSON); "
                         f"verbatim copy of experiment-repo {EXP_REPO_COMMIT}:results/summary.json")
    ap.add_argument("-o", "--outdir", default=None,
                    help="output directory (default: the script's own directory)")
    args = ap.parse_args()

    r = load_results(args.results_json)
    outdir = pathlib.Path(args.outdir) if args.outdir else pathlib.Path(__file__).resolve().parent
    outdir.mkdir(parents=True, exist_ok=True)
    svg, png = render_figure(r, outdir)
    table = render_table(r, outdir, svg.name)
    print(f"wrote {svg}, {png}, {table}")


if __name__ == "__main__":
    main()
